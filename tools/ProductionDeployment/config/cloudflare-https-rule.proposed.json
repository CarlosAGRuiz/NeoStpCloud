{
  "description": "NeoSTP app y API: HTTP a HTTPS",
  "expression": "(http.host in {\"app.neostp.com\" \"api.neostp.com\"} and not ssl)",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 308,
      "target_url": {
        "expression": "concat(\"https://\", http.host, http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
