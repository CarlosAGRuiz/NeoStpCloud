{
  "Cache": {
    "Provider": "Memory",
    "Redis": {
      "ConnectionString": "",
      "InstanceName": "neostp:"
    }
  },
  "Observability": {
    "Otlp": {
      "Endpoint": ""
    }
  },
  "ConnectionStrings": {
    "NeoStpDb": "Server=.;Database=NeoSTP_Cloud;Integrated Security=False;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Worker": {
    "RetransmisionContingencia": {
      "IntervaloMinutos": 5,
      "CooldownMinutos": 30,
      "MaxIntentos": 5,
      "LoteMaximo": 50
    },
    "ContingenciaLote": {
      "IntervaloMinutos": 10
    },
    "LimpiezaTokens": {
      "IntervaloHoras": 24,
      "RetentionDias": 30
    },
    "LimpiezaAuditoria": { "Enabled": false, "RetencionDias": 365, "IntervaloHoras": 24, "BatchSize": 5000 },
    "RecordatoriosCobro": {
      "Enabled": false,
      "IntervaloHoras": 24,
      "DiasVencidoMinimo": 1,
      "MaximoPorEmpresa": 50,
      "EnviarEmail": true,
      "EnviarWhatsApp": false
    }
  },
  "WhatsApp": {
    "Provider": "Mock",
    "Meta": {
      "Token": "",
      "PhoneNumberId": "",
      "BaseUrl": "https://graph.facebook.com",
      "ApiVersion": "v20.0",
      "CodigoPaisDefecto": "503"
    }
  },
  "Push": {
    "Provider": "Mock",
    "Fcm": {
      "ProjectId": "",
      "ClientEmail": "",
      "PrivateKey": "",
      "TokenUri": "https://oauth2.googleapis.com/token",
      "BaseUrl": "https://fcm.googleapis.com"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/neostp-worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  }
}
