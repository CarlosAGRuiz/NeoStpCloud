{
  "Deployment": {
    "EnvironmentId": "PRODUCTION",
    "DataRoot": "C:/ProgramData/NeoSTP/Production",
    "ExternalConfigFile": "C:/ProgramData/NeoSTP/Production/config/runtime.json"
  },
  "ConnectionStrings": {
    "NeoStpDb": "Server=NEOSTP_PRODUCTION_SQL;Database=NeoSTP_Production;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True"
  },
  "DataProtection": {
    "KeyRingPath": "C:/ProgramData/NeoSTP/Production/DataProtection",
    "CertificateThumbprint": "",
    "StoreName": "My",
    "StoreLocation": "LocalMachine"
  },
  "Ops": {
    "PermitirMocksEnProduccion": false,
    "Database": {
      "ApplyMigrationsOnStartup": false,
      "SeedOnStartup": false
    }
  },
  "SuperAdmin": { "BootstrapEnabled": false },
  "EmpresaPrueba": { "Enabled": false },
  "DemoComercial": { "Enabled": false },
  "Worker": {
    "Enabled": false,
    "RetransmisionContingencia": { "Enabled": false },
    "LimpiezaTokens": { "Enabled": false },
    "ContingenciaLote": { "Enabled": false },
    "WebhookDelivery": { "Enabled": false },
    "BillingProviderOperations": { "Enabled": false },
    "NotificationOutbox": { "Enabled": false },
    "GeneracionAlertas": { "Enabled": false },
    "RecordatoriosCobro": { "Enabled": false },
    "LimpiezaAuditoria": { "Enabled": false },
    "Backup": { "Enabled": false },
    "BackgroundTasks": { "Enabled": false }
  },
  "Email": { "Provider": "Disabled" },
  "Billing": { "Provider": "Disabled" },
  "Scan": {
    "Provider": "Disabled",
    "Storage": { "Provider": "Database" }
  },
  "WhatsApp": { "Provider": "Disabled" },
  "Push": { "Provider": "Disabled" },
  "Hacienda": {
    "Client": "Http",
    "PruebasBaseUrl": "https://apitest.dtes.mh.gob.sv",
    "ProduccionBaseUrl": "https://api.dtes.mh.gob.sv",
    "TimeoutSeconds": 30
  },
  "Dte": {
    "Signer": "HaciendaCert",
    "CertificateProtection": {
      "AllowLegacyPlaintext": false
    }
  },
  "Hardening": {
    "Backup": {
      "StorageProvider": "LOCAL",
      "LocalPath": "C:/ProgramData/NeoSTP/Production/backups",
      "WorkerEnabled": false
    }
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:/ProgramData/NeoSTP/Production/logs/neostp-worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
