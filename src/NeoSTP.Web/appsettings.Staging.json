{
  "Deployment": {
    "EnvironmentId": "STAGING",
    "DataRoot": "C:/ProgramData/NeoSTP/Staging"
  },
  "ConnectionStrings": {
    "NeoStpDb": "Server=NEOSTP_STAGING_SQL;Database=NeoSTP_Staging;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True"
  },
  "AllowedHosts": "staging.neostp.com",
  "ApiBaseUrl": "https://staging-api.neostp.com",
  "DataProtection": {
    "KeyRingPath": "C:/ProgramData/NeoSTP/Staging/DataProtection",
    "CertificateThumbprint": "",
    "StoreName": "My",
    "StoreLocation": "LocalMachine"
  },
  "Ops": {
    "PermitirMocksEnProduccion": false,
    "Database": {
      "ApplyMigrationsOnStartup": false,
      "SeedOnStartup": false
    }
  },
  "SuperAdmin": { "BootstrapEnabled": false },
  "EmpresaPrueba": { "Enabled": false },
  "DemoComercial": { "Enabled": false },
  "Email": { "Provider": "Disabled" },
  "Billing": { "Provider": "Disabled" },
  "Scan": {
    "Provider": "Disabled",
    "Storage": { "Provider": "Database" }
  },
  "WhatsApp": { "Provider": "Disabled" },
  "Push": { "Provider": "Disabled" },
  "Hacienda": {
    "Client": "Http",
    "PruebasBaseUrl": "https://apitest.dtes.mh.gob.sv",
    "ProduccionBaseUrl": "https://api.dtes.mh.gob.sv",
    "TimeoutSeconds": 30
  },
  "Dte": { "Signer": "HaciendaCert" },
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:/ProgramData/NeoSTP/Staging/logs/neostp-web-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
