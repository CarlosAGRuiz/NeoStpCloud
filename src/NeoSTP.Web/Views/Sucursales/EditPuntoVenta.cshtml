@model NeoSTP.Application.Empresas.Dtos.UpdatePuntoVentaRequest
@{
    ViewData["Title"] = "Editar Punto de Venta";
}

<form asp-action="EditPuntoVenta" method="post" style="max-width: 640px;">
    @Html.AntiForgeryToken()
    <div class="ns-page-head">
        <div>
            <nav class="ns-breadcrumb"><a asp-action="PuntosVenta">Puntos de venta</a><span class="material-symbols-outlined">chevron_right</span><span>Editar</span></nav>
            <h1 class="ns-page-title">Editar punto de venta</h1>
            <p class="text-muted small m-0">@ViewBag.SucursalNombre</p>
        </div>
        <div class="ns-page-actions">
            <a asp-action="PuntosVenta" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
    </div>

    <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">point_of_sale</span><h2>Datos del punto de venta</h2></div>
        <div class="ns-formsection-body row g-3">
            <div class="col-12">
                <label asp-for="Nombre" class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="CodigoPuntoVentaMh" class="form-label">Cód. Punto de Venta MH</label>
                <input asp-for="CodigoPuntoVentaMh" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="EstadoCodigo" class="form-label">Estado</label>
                <select asp-for="EstadoCodigo" class="form-select">
                    <option value="ACTIVO">Activo</option>
                    <option value="INACTIVO">Inactivo</option>
                </select>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
