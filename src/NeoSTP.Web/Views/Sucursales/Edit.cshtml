@model NeoSTP.Application.Empresas.Dtos.UpdateSucursalRequest
@{
    ViewData["Title"] = "Editar Sucursal";
}

<form asp-action="Edit" method="post" style="max-width: 860px;">
    @Html.AntiForgeryToken()
    <div class="ns-page-head">
        <div>
            <nav class="ns-breadcrumb"><a asp-action="Index">Sucursales</a><span class="material-symbols-outlined">chevron_right</span><span>Editar</span></nav>
            <h1 class="ns-page-title">Editar sucursal</h1>
        </div>
        <div class="ns-page-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
    </div>

    <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">store</span><h2>Datos de la sucursal</h2></div>
        <div class="ns-formsection-body row g-3">
            <div class="col-12">
                <label asp-for="Nombre" class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CodigoEstablecimientoMh" class="form-label">Cód. Establecimiento MH</label>
                <input asp-for="CodigoEstablecimientoMh" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="TipoEstablecimientoCodigo" class="form-label">Tipo Establecimiento</label>
                <select asp-for="TipoEstablecimientoCodigo" class="form-select">
                    <option value="">— Seleccionar —</option>
                    <option value="01">01 - Sucursal / Agencia</option>
                    <option value="02">02 - Casa Matriz</option>
                    <option value="07">07 - Comercio Virtual</option>
                    <option value="20">20 - Otro</option>
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Direccion" class="form-label">Dirección</label>
                <input asp-for="Direccion" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Telefono" class="form-label">Teléfono</label>
                <input asp-for="Telefono" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Departamento" class="form-label">Departamento</label>
                <input asp-for="Departamento" class="form-control" maxlength="2" />
            </div>
            <div class="col-md-3">
                <label asp-for="Municipio" class="form-label">Municipio</label>
                <input asp-for="Municipio" class="form-control" maxlength="4" />
            </div>
            <div class="col-md-4">
                <label asp-for="EstadoCodigo" class="form-label">Estado</label>
                <select asp-for="EstadoCodigo" class="form-select">
                    <option value="ACTIVO">Activo</option>
                    <option value="INACTIVO">Inactivo</option>
                </select>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
