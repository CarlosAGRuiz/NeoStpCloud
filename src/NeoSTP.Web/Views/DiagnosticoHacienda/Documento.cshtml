@using NeoSTP.Application.Dte.Diagnostico.Dtos
@model DiagnosticoDocumentoDto
@{
    ViewData["Title"] = $"Diagnóstico DTE #{Model.DteDocumentoId}";
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-action="Index">Diagnóstico</a><span class="material-symbols-outlined">chevron_right</span><span>DTE #@Model.DteDocumentoId</span></nav>
        <h1 class="ns-page-title">Diagnóstico documento DTE</h1>
    </div>
    <div class="ns-page-actions">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Volver</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header ns-card-head"><span class="material-symbols-outlined">troubleshoot</span><strong>Información del documento</strong></div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6">
                <dl class="row mb-0">
                    <dt class="col-sm-5">ID</dt>
                    <dd class="col-sm-7">#@Model.DteDocumentoId</dd>
                    <dt class="col-sm-5">Tipo DTE</dt>
                    <dd class="col-sm-7"><span class="ns-badge ns-badge--draft">@Model.TipoDteCodigo</span></dd>
                    <dt class="col-sm-5">Número control</dt>
                    <dd class="col-sm-7 ns-mono small">@Model.NumeroControl</dd>
                </dl>
            </div>
            <div class="col-sm-6">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Estado</dt>
                    <dd class="col-sm-7"><span class="ns-badge ns-badge--draft">@Model.EstadoCodigo</span></dd>
                    <dt class="col-sm-5">Código generación</dt>
                    <dd class="col-sm-7 ns-mono small">@Model.CodigoGeneracion</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@if (Model.Errores.Any())
{
    <h2 class="h6 mb-2">Errores registrados (@Model.Errores.Count)</h2>
    @foreach (var o in Model.Errores)
    {
        var alertClass = o.Severidad switch { "WARNING" => "alert-warning", "INFO" => "alert-info", _ => "alert-danger" };
        <div class="alert @alertClass @(o.Resuelta ? "opacity-50" : "")">
            <div class="d-flex justify-content-between">
                <strong>@o.CodigoError — @(o.Descripcion ?? o.Mensaje)</strong>
                <small class="text-muted">@o.OcurrioAt.ToString("dd/MM/yyyy HH:mm") · @o.Fuente</small>
            </div>
            @if (o.CausaProbable is not null)
            {
                <div class="mt-1"><strong>Causa:</strong> @o.CausaProbable</div>
            }
            @if (o.AccionSugerida is not null)
            {
                <div><strong>Acción sugerida:</strong> @o.AccionSugerida</div>
            }
            @if (!o.Resuelta)
            {
                <div class="mt-2">
                    <form asp-action="MarcarResuelta" asp-route-id="@o.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-success d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px">check</span> Marcar resuelta</button>
                    </form>
                </div>
            }
            else
            {
                <div class="mt-1"><span class="ns-badge ns-badge--processed">Resuelta</span></div>
            }
        </div>
    }
}
else
{
    <div class="card"><div class="ns-empty"><span class="material-symbols-outlined">check_circle</span><p>No hay errores registrados para este documento.</p></div></div>
}

@if (Model.JsonEnviado is not null)
{
    <details class="mt-3">
        <summary class="btn btn-sm btn-outline-secondary">JSON enviado a Hacienda</summary>
        <pre class="bg-dark text-light p-3 rounded mt-2 small ns-mono" style="max-height:400px;overflow:auto">@Model.JsonEnviado</pre>
    </details>
}

@if (Model.RespuestaMhJson is not null)
{
    <details class="mt-2">
        <summary class="btn btn-sm btn-outline-secondary">Respuesta de Hacienda</summary>
        <pre class="bg-dark text-light p-3 rounded mt-2 small ns-mono" style="max-height:400px;overflow:auto">@Model.RespuestaMhJson</pre>
    </details>
}
