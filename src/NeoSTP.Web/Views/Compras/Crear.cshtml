@using NeoSTP.Application.Compras.Dtos
@using NeoSTP.Application.Productos.Dtos
@model CrearFacturaCompraRequest
@{
    ViewData["Title"] = "Nueva factura de compra";
    var proveedores = ViewBag.Proveedores as List<ProveedorDto> ?? new List<ProveedorDto>();
    var productos = ViewBag.Productos as List<ProductoDto> ?? new List<ProductoDto>();
    var tipos = ViewBag.TiposDocumento as string[] ?? Array.Empty<string>();
    var condiciones = ViewBag.CondicionesPago as string[] ?? Array.Empty<string>();
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><a asp-action="Index">Cuentas por pagar</a><span class="material-symbols-outlined">chevron_right</span><span>Nueva</span></nav>
        <h1 class="ns-page-title">Nueva factura de compra</h1>
    </div>
</div>

<div class="card"><div class="card-body">
    @if (!proveedores.Any())
    {
        <div class="ns-empty"><span class="material-symbols-outlined">local_shipping</span><p>No hay proveedores activos. Crea uno primero.</p><a asp-controller="Proveedores" asp-action="Create" class="btn btn-primary btn-sm">Nuevo proveedor</a></div>
    }
    else
    {
        <form asp-action="Crear" method="post" class="row g-3" style="max-width:860px">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger small"></div>
            <div class="col-md-6">
                <label class="form-label">Proveedor</label>
                <select asp-for="ProveedorId" class="form-select">
                    <option value="">— Selecciona —</option>
                    @foreach (var p in proveedores) { <option value="@p.Id">@p.Codigo · @p.Nombre</option> }
                </select>
            </div>
            <div class="col-md-3"><label class="form-label">Nº documento</label><input asp-for="NumeroDocumento" class="form-control ns-mono" /></div>
            <div class="col-md-3">
                <label class="form-label">Tipo</label>
                <select asp-for="TipoDocumento" class="form-select">@foreach (var t in tipos) { <option value="@t">@t</option> }</select>
            </div>
            <div class="col-md-3"><label class="form-label">Emisión</label><input asp-for="FechaEmision" type="date" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Vencimiento</label><input asp-for="FechaVencimiento" type="date" class="form-control" /><div class="form-text">Vacío = plazo del proveedor.</div></div>
            <div class="col-md-3">
                <label class="form-label">Condición</label>
                <select asp-for="CondicionPago" class="form-select">@foreach (var c in condiciones) { <option value="@c">@c</option> }</select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="IvaDeducible" class="form-check-input" type="checkbox" id="ivaded" />
                    <label class="form-check-label small" for="ivaded">IVA deducible (CCF)</label>
                </div>
            </div>
            <div class="col-md-4"><label class="form-label">Subtotal</label><input asp-for="Subtotal" type="number" step="0.01" min="0" class="form-control ns-mono" value="0.00" /></div>
            <div class="col-md-4"><label class="form-label">IVA</label><input asp-for="Iva" type="number" step="0.01" min="0" class="form-control ns-mono" value="0.00" /></div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="RegistrarGastoProfit" class="form-check-input" type="checkbox" id="gasto" checked />
                    <label class="form-check-label small" for="gasto">Registrar gasto en NeoProfit</label>
                </div>
            </div>
            <div class="col-12"><label class="form-label">Descripción (opcional)</label><input asp-for="Descripcion" class="form-control" /></div>

            <div class="col-12">
                <details class="border rounded p-3">
                    <summary class="fw-semibold">Recepción a inventario (opcional)</summary>
                    <p class="form-text mt-2 mb-2">Si esta compra ingresa productos al inventario, agrégalos aquí. Cada línea genera una entrada con su costo (kardex + costo promedio + NeoProfit).</p>
                    @if (!productos.Any())
                    {
                        <div class="ns-empty"><span class="material-symbols-outlined">inventory_2</span><p>No hay productos (bienes) activos para recibir.</p></div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-2">
                            <thead><tr><th style="width:55%">Producto</th><th>Cantidad</th><th>Costo unit.</th><th></th></tr></thead>
                            <tbody id="invBody"></tbody>
                        </table>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="invAdd"><span class="material-symbols-outlined align-middle" style="font-size:18px">add</span> Agregar producto</button>

                        <template id="invRow">
                            <tr>
                                <td>
                                    <select class="form-select form-select-sm inv-prod">
                                        <option value="">— Selecciona —</option>
                                        @foreach (var p in productos)
                                        {
                                            <option value="@p.Id" data-costo="@((p.CostoUnitario ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))">@p.CodigoInterno · @p.Nombre</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="number" step="0.01" min="0" class="form-control form-control-sm ns-mono inv-cant" value="1" /></td>
                                <td><input type="number" step="0.0001" min="0" class="form-control form-control-sm ns-mono inv-costo" placeholder="actual" /></td>
                                <td><button type="button" class="btn btn-outline-danger btn-sm inv-del"><span class="material-symbols-outlined" style="font-size:18px">close</span></button></td>
                            </tr>
                        </template>
                    }
                </details>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined align-middle" style="font-size:18px">save</span> Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    }
</div></div>

<script>
    (function () {
        var body = document.getElementById('invBody');
        var tpl = document.getElementById('invRow');
        var add = document.getElementById('invAdd');
        if (!body || !tpl || !add) return;

        function reindex() {
            Array.prototype.forEach.call(body.querySelectorAll('tr'), function (tr, i) {
                tr.querySelector('.inv-prod').name = 'LineasInventario[' + i + '].ProductoId';
                tr.querySelector('.inv-cant').name = 'LineasInventario[' + i + '].Cantidad';
                tr.querySelector('.inv-costo').name = 'LineasInventario[' + i + '].CostoUnitario';
            });
        }
        function wire(tr) {
            tr.querySelector('.inv-del').addEventListener('click', function () { tr.remove(); reindex(); });
            var prod = tr.querySelector('.inv-prod');
            prod.addEventListener('change', function () {
                var opt = prod.options[prod.selectedIndex];
                var costo = opt ? opt.getAttribute('data-costo') : null;
                var ci = tr.querySelector('.inv-costo');
                if (costo && Number(costo) > 0 && !ci.value) ci.value = costo;
            });
        }
        add.addEventListener('click', function () {
            var tr = tpl.content.cloneNode(true).querySelector('tr');
            body.appendChild(tr);
            wire(tr);
            reindex();
        });
    })();
</script>
