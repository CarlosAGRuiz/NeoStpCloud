@using NeoSTP.Application.Compras.Dtos
@model NeoSTP.Application.Common.PagedResult<OrdenCompraDto>
@{
    ViewData["Title"] = "Ordenes de compra";
    var search = ViewBag.Search as string;
    var estado = ViewBag.Estado as string;
    var proveedorId = ViewBag.ProveedorId as int?;
    var estados = ViewBag.Estados as string[] ?? Array.Empty<string>();
    var puedeGestionar = ViewBag.PuedeGestionar is bool g && g;
    string Badge(string value) => value switch
    {
        "RECIBIDA" => "ns-badge--processed",
        "PARCIAL" => "ns-badge--contingency",
        "CANCELADA" => "ns-badge--rejected",
        "EMITIDA" => "ns-badge--draft",
        _ => "ns-badge--draft",
    };
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><span>Ordenes de compra</span></nav>
        <h1 class="ns-page-title">Ordenes de compra</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">request_quote</span> Cuentas por pagar</a>
        @if (puedeGestionar)
        {
            <a asp-action="CrearOrden" asp-route-proveedorId="@proveedorId" class="btn btn-primary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">add</span> Nueva orden</a>
        }
    </div>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

@{
    var puedeAprobar = ViewBag.PuedeAprobar is bool pab && pab;
    var umbralActual = ViewBag.UmbralAprobacion as decimal?;
}
@if (puedeAprobar)
{
    <div class="card mb-3" style="border-left:4px solid var(--ns-secondary)">
        <div class="card-body py-2">
            <form asp-action="UmbralAprobacion" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                @Html.AntiForgeryToken()
                <span class="material-symbols-outlined" style="color:var(--ns-secondary)">approval</span>
                <strong class="small">Aprobación de compras:</strong>
                <span class="small text-muted">órdenes desde</span>
                <input name="umbral" type="number" step="0.01" min="0" value="@(umbralActual?.ToString("0.##"))"
                       class="form-control form-control-sm ns-mono" style="max-width:140px" placeholder="sin umbral" />
                <span class="small text-muted">requieren aprobación (vacío o 0 = desactivado)</span>
                <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                @if (umbralActual is decimal ua)
                {
                    <span class="ns-badge ns-badge--info">Activo desde $@ua.ToString("N2")</span>
                }
            </form>
        </div>
    </div>
}

<div class="ns-toolbar">
    <form method="get" class="ns-toolbar-search flex-wrap">
        <input type="hidden" name="proveedorId" value="@proveedorId" />
        <input name="search" value="@search" class="form-control form-control-sm" style="min-width:240px" placeholder="Buscar orden o proveedor" />
        <select name="estado" class="form-select form-select-sm" style="width:170px" onchange="this.form.submit()">
            <option value="">Todos los estados</option>
            @foreach (var item in estados)
            {
                <option value="@item" selected="@(estado == item)">@item</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Buscar"><span class="material-symbols-outlined align-middle" style="font-size:18px">search</span></button>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead><tr><th>Orden</th><th>Proveedor</th><th>Fecha</th><th>Entrega esperada</th><th>Recepciones</th><th class="text-end">Total</th><th>Estado</th></tr></thead>
            <tbody>
                @if (Model is null || !Model.Items.Any())
                {
                    <tr><td colspan="7"><div class="ns-empty"><span class="material-symbols-outlined">shopping_cart_checkout</span><p>Sin ordenes de compra.</p></div></td></tr>
                }
                @foreach (var orden in Model?.Items ?? Array.Empty<OrdenCompraDto>())
                {
                    <tr>
                        <td><a asp-action="DetalleOrden" asp-route-id="@orden.Id"><strong class="ns-mono">@orden.Numero</strong></a></td>
                        <td>@orden.ProveedorNombre</td>
                        <td class="ns-mono small">@orden.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="ns-mono small">@(orden.FechaEntregaEsperada?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td><span class="ns-mono">@orden.Recepciones</span></td>
                        <td class="text-end ns-mono fw-semibold">$ @orden.Total.ToString("N2")</td>
                        <td><span class="ns-badge @Badge(orden.EstadoCodigo)">@orden.EstadoCodigo</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model is not null && Model.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm">
        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" asp-action="Ordenes" asp-route-page="@i" asp-route-search="@search" asp-route-estado="@estado" asp-route-proveedorId="@proveedorId">@i</a></li>
        }
    </ul></nav>
}
