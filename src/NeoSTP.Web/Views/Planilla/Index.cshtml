@model NeoSTP.Application.Common.PagedResult<NeoSTP.Application.Rrhh.Dtos.PlanillaPeriodoDto>
@{
    ViewData["Title"] = "Planillas";
    var puedeGestionar = ViewBag.PuedeGestionar is bool g && g;
    string Badge(string e) => e switch
    {
        "CERRADA" => "ns-badge--processed",
        "CALCULADA" => "ns-badge--contingency",
        "ANULADA" => "ns-badge--rejected",
        _ => "ns-badge--draft",
    };
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><span>Planillas</span></nav>
        <h1 class="ns-page-title">Corridas de planilla</h1>
    </div>
    @if (puedeGestionar)
    {
        <a asp-action="Crear" class="btn btn-primary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">add</span> Nueva corrida</a>
    }
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead>
                <tr>
                    <th>Período</th>
                    <th>Rango</th>
                    <th class="text-center">Empleados</th>
                    <th class="text-end">Neto</th>
                    <th class="text-end">Costo patronal</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model is null || !Model.Items.Any())
                {
                    <tr><td colspan="7"><div class="ns-empty"><span class="material-symbols-outlined">payments</span><p>Sin corridas de planilla.</p></div></td></tr>
                }
                @foreach (var p in Model?.Items ?? Array.Empty<NeoSTP.Application.Rrhh.Dtos.PlanillaPeriodoDto>())
                {
                    <tr>
                        <td><a asp-action="Detalle" asp-route-id="@p.Id"><strong>@p.Etiqueta</strong></a></td>
                        <td class="ns-mono small">@p.FechaInicio.ToString("dd/MM") – @p.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">@p.Empleados</td>
                        <td class="text-end ns-mono fw-bold">@p.TotalNeto.ToString("N2")</td>
                        <td class="text-end ns-mono">@p.TotalCostoPatronal.ToString("N2")</td>
                        <td><span class="ns-badge @Badge(p.EstadoCodigo)">@p.EstadoCodigo</span></td>
                        <td class="text-end"><a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Ver</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model is not null && Model.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@i">@i</a></li>
        }
    </ul></nav>
}
