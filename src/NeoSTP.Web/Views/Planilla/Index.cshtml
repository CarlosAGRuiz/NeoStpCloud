@model NeoSTP.Application.Common.PagedResult<NeoSTP.Application.Rrhh.Dtos.PlanillaPeriodoDto>
@{
    ViewData["Title"] = "Planillas";
    var puedeGestionar = ViewBag.PuedeGestionar is bool g && g;
    var items = Model?.Items ?? Array.Empty<NeoSTP.Application.Rrhh.Dtos.PlanillaPeriodoDto>();
    var page = Model?.Page ?? 1;
    var totalPages = Model?.TotalPages ?? 1;
    var totalNetoVisible = items.Sum(p => p.TotalNeto);
    var totalCostoVisible = items.Sum(p => p.TotalCostoPatronal);
    var cerradas = items.Count(p => p.EstadoCodigo == "CERRADA");
    string Badge(string e) => e switch
    {
        "CERRADA" => "ns-badge--processed",
        "CALCULADA" => "ns-badge--contingency",
        "ANULADA" => "ns-badge--rejected",
        _ => "ns-badge--draft",
    };
}

<div class="ns-page-head ns-page-head--hero">
    <div>
        <nav class="ns-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>NeoRRHH</span>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>Planilla</span>
        </nav>
        <h1 class="ns-page-title">Corridas de planilla</h1>
        <p class="ns-page-subtitle">Cálculo, cierre, exportación y recibos de nómina.</p>
    </div>
    @if (puedeGestionar)
    {
        <a asp-action="Crear" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <span class="material-symbols-outlined" style="font-size:20px">add</span>
            Nueva corrida
        </a>
    }
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="ns-summary-grid mb-4">
    <section class="ns-summary-card">
        <p>Corridas registradas</p>
        <strong>@(Model?.Total ?? 0).ToString("N0")</strong>
        <span><span class="material-symbols-outlined">event_available</span> Historial de nómina</span>
    </section>
    <section class="ns-summary-card">
        <p>Neto visible</p>
        <strong class="ns-mono">$ @totalNetoVisible.ToString("N2")</strong>
        <span>@items.Sum(p => p.Empleados).ToString("N0") empleados procesados</span>
    </section>
    <section class="ns-summary-card ns-summary-card--dark">
        <p>Costo patronal visible</p>
        <strong class="ns-mono">$ @totalCostoVisible.ToString("N2")</strong>
        <span>@cerradas corridas cerradas en página</span>
    </section>
</div>

<div class="card ns-data-card">
    <div class="ns-card-titlebar">
        <div>
            <h2>Historial de corridas</h2>
            <p>Estados calculada, cerrada o anulada por período.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table ns-table-modern m-0 align-middle">
            <thead>
                <tr>
                    <th>Período</th>
                    <th>Rango</th>
                    <th class="text-center">Empleados</th>
                    <th class="text-end">Neto</th>
                    <th class="text-end">Costo patronal</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!items.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="ns-empty">
                                <span class="material-symbols-outlined">payments</span>
                                <p>Sin corridas de planilla.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var p in items)
                {
                    <tr>
                        <td>
                            <a asp-action="Detalle" asp-route-id="@p.Id" class="text-decoration-none"><strong>@p.Etiqueta</strong></a>
                            <div class="text-muted small">Año @p.Anio · Mes @p.Mes.ToString("00")</div>
                        </td>
                        <td class="ns-mono small">@p.FechaInicio.ToString("dd/MM") - @p.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">@p.Empleados</td>
                        <td class="text-end ns-mono fw-bold">$ @p.TotalNeto.ToString("N2")</td>
                        <td class="text-end ns-mono">$ @p.TotalCostoPatronal.ToString("N2")</td>
                        <td><span class="ns-badge @Badge(p.EstadoCodigo)">@p.EstadoCodigo</span></td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Ver detalle">
                                <span class="material-symbols-outlined" style="font-size:18px">visibility</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="ns-table-footer">
        <span>Mostrando @items.Count de @(Model?.Total ?? 0).ToString("N0") corridas</span>
        @if (totalPages > 1)
        {
            <nav aria-label="Paginación de planillas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(page - 1)">
                            <span class="material-symbols-outlined" style="font-size:18px">chevron_left</span>
                        </a>
                    </li>
                    @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                    {
                        <li class="page-item @(i == page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@i">@i</a></li>
                    }
                    <li class="page-item @(page >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(page + 1)">
                            <span class="material-symbols-outlined" style="font-size:18px">chevron_right</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
