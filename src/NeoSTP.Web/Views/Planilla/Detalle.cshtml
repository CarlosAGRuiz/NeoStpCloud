@model NeoSTP.Application.Rrhh.Dtos.PlanillaPeriodoDetalleDto
@{
    ViewData["Title"] = $"Planilla {Model.Etiqueta}";
    var puedeGestionar = ViewBag.PuedeGestionar is bool g && g;
    var calculada = Model.EstadoCodigo == "CALCULADA";
    var cerrada = Model.EstadoCodigo == "CERRADA";
    var anulada = Model.EstadoCodigo == "ANULADA";
    string Badge(string e) => e switch { "CERRADA" => "ns-badge--processed", "CALCULADA" => "ns-badge--contingency", "ANULADA" => "ns-badge--rejected", _ => "ns-badge--draft" };
}

<div class="ns-page-head ns-page-head--hero">
    <div>
        <nav class="ns-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <a asp-action="Index">Planillas</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>@Model.Etiqueta</span>
        </nav>
        <h1 class="ns-page-title">
            Planilla @Model.Etiqueta
            <span class="ns-badge @Badge(Model.EstadoCodigo)">@Model.EstadoCodigo</span>
        </h1>
        <p class="ns-page-subtitle">@Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy") · @Model.Detalles.Count empleados</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <div class="dropdown">
            <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 dropdown-toggle" data-bs-toggle="dropdown">
                <span class="material-symbols-outlined" style="font-size:20px">download</span>
                Exportar
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-action="ExportCsv" asp-route-id="@Model.Id">Planilla CSV</a></li>
                <li><a class="dropdown-item" asp-action="ExportIsss" asp-route-id="@Model.Id">Planilla ISSS CSV</a></li>
                <li><a class="dropdown-item" asp-action="ExportAfp" asp-route-id="@Model.Id">Planilla AFP CSV</a></li>
            </ul>
        </div>
        @if (puedeGestionar && calculada)
        {
            <form asp-action="Recalcular" asp-route-id="@Model.Id" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
                    <span class="material-symbols-outlined" style="font-size:20px">refresh</span>
                    Recalcular
                </button>
            </form>
            <form asp-action="Cerrar" asp-route-id="@Model.Id" method="post" class="m-0" onsubmit="return confirm('¿Cerrar la planilla? Se registrará como gasto y no podrá recalcularse.');">
                @Html.AntiForgeryToken()
                <button class="btn btn-success d-inline-flex align-items-center gap-2">
                    <span class="material-symbols-outlined" style="font-size:20px">lock</span>
                    Cerrar
                </button>
            </form>
        }
        @if (puedeGestionar && !anulada)
        {
            <form asp-action="Anular" asp-route-id="@Model.Id" method="post" class="m-0" onsubmit="return confirm('¿Anular la planilla?');">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger d-inline-flex align-items-center gap-2">
                    <span class="material-symbols-outlined" style="font-size:20px">block</span>
                    Anular
                </button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <span class="material-symbols-outlined" style="font-size:20px">arrow_back</span>
            Volver
        </a>
    </div>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (cerrada && Model.ProfitGastoId is int gid)
{
    <div class="ns-info-banner mb-4">
        <span class="material-symbols-outlined">info</span>
        <span>Planilla cerrada y registrada como gasto NeoProfit #@gid, categoría PLANILLA.</span>
    </div>
}

<div class="ns-summary-grid mb-4">
    <section class="ns-summary-card">
        <p>Devengado</p>
        <strong class="ns-mono">$ @Model.TotalDevengado.ToString("N2")</strong>
        <span><span class="material-symbols-outlined">payments</span> Total bruto del período</span>
    </section>
    <section class="ns-summary-card">
        <p>Deducciones</p>
        <strong class="ns-mono text-danger">$ @Model.TotalDeducciones.ToString("N2")</strong>
        <span>ISSS, AFP, renta y otros descuentos</span>
    </section>
    <section class="ns-summary-card">
        <p>Neto a pagar</p>
        <strong class="ns-mono" style="color:var(--ns-processed)">$ @Model.TotalNeto.ToString("N2")</strong>
        <span>@Model.Detalles.Count recibos disponibles</span>
    </section>
    <section class="ns-summary-card ns-summary-card--dark">
        <p>Costo patronal</p>
        <strong class="ns-mono">$ @Model.TotalCostoPatronal.ToString("N2")</strong>
        <span>Aportes de la empresa</span>
    </section>
</div>

<div class="card ns-data-card">
    <div class="ns-card-titlebar">
        <div>
            <h2>Detalle por empleado</h2>
            <p>Cálculo individual de devengado, deducciones, neto y costo patronal.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table ns-table-modern m-0 align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Empleado</th>
                    <th class="text-end">Devengado</th>
                    <th class="text-end">Prestaciones</th>
                    <th class="text-end">ISSS</th>
                    <th class="text-end">AFP</th>
                    <th class="text-end">Renta</th>
                    <th class="text-end">Deducciones</th>
                    <th class="text-end">Neto</th>
                    <th class="text-end">Costo patronal</th>
                    <th class="text-end">Recibo</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Detalles.Any())
                {
                    <tr>
                        <td colspan="11">
                            <div class="ns-empty">
                                <span class="material-symbols-outlined">receipt_long</span>
                                <p>Esta corrida no tiene empleados calculados.</p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td><span class="ns-code-token">@d.EmpleadoCodigo</span></td>
                        <td><strong>@d.EmpleadoNombre</strong></td>
                        <td class="text-end ns-mono">$ @d.Devengado.ToString("N2")</td>
                        <td class="text-end ns-mono">
                            @if (d.OtrosIngresos > 0)
                            {
                                <span title="Prima: $ @d.PrimaVacacion.ToString("N2") · Aguinaldo: $ @d.Aguinaldo.ToString("N2")">$ @d.OtrosIngresos.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-end ns-mono text-danger">- @d.Isss.ToString("N2")</td>
                        <td class="text-end ns-mono text-danger">- @d.Afp.ToString("N2")</td>
                        <td class="text-end ns-mono text-danger">- @d.Renta.ToString("N2")</td>
                        <td class="text-end ns-mono">$ @d.TotalDeducciones.ToString("N2")</td>
                        <td class="text-end ns-mono fw-bold">$ @d.SalarioNeto.ToString("N2")</td>
                        <td class="text-end ns-mono">$ @d.CostoPatronal.ToString("N2")</td>
                        <td class="text-end">
                            <a asp-action="Recibo" asp-route-id="@Model.Id" asp-route-empleadoId="@d.EmpleadoId" target="_blank" class="btn btn-sm btn-outline-primary" title="Recibo PDF">
                                <span class="material-symbols-outlined" style="font-size:18px">picture_as_pdf</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2"><strong>Totales</strong></td>
                    <td class="text-end ns-mono fw-bold">$ @Model.TotalDevengado.ToString("N2")</td>
                    <td></td>
                    <td colspan="3"></td>
                    <td class="text-end ns-mono fw-bold text-danger">$ @Model.TotalDeducciones.ToString("N2")</td>
                    <td class="text-end ns-mono fw-bold">$ @Model.TotalNeto.ToString("N2")</td>
                    <td class="text-end ns-mono fw-bold">$ @Model.TotalCostoPatronal.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
