@model IReadOnlyList<NeoSTP.Application.Catalogos.Dtos.CatalogoDto>
@{
    ViewData["Title"] = "Catálogos";
    var puedeAdministrar = ViewBag.PuedeAdministrar is bool a && a;
    var empresaId = ViewBag.EmpresaId as int?;
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><span>Catálogos</span></nav>
        <h1 class="ns-page-title">Catálogos</h1>
    </div>
    @if (puedeAdministrar)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm disabled" title="Creación inline disponible vía API">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">add</span> Nuevo catálogo
        </a>
    }
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">@ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">@err <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="ns-toolbar">
    <p class="text-muted small m-0">
        @if (empresaId is null)
        {
            <span>Mostrando catálogos del <strong>sistema</strong> (sin empresa seleccionada).</span>
        }
        else
        {
            <span>Mostrando catálogos del sistema + los de la empresa <strong>#@empresaId</strong>.</span>
        }
    </p>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover m-0 align-middle">
            <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th class="text-center">Ítems</th>
                <th class="text-center">Versión</th>
                <th class="text-center">Origen</th>
                <th class="text-center">Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr class="@(!c.Activo ? "text-muted" : "")">
                    <td><code class="ns-mono">@c.Codigo</code></td>
                    <td>
                        @c.Nombre
                        @if (!string.IsNullOrEmpty(c.Descripcion))
                        {
                            <div class="text-muted small">@c.Descripcion</div>
                        }
                    </td>
                    <td class="text-center"><span class="ns-badge ns-badge--draft">@c.TotalItems</span></td>
                    <td class="text-center"><small class="ns-mono">v@(c.Version)</small></td>
                    <td class="text-center">
                        @if (c.EsSistema)
                        {
                            <span class="ns-pill ns-pill--off" title="Catálogo del sistema (lectura para empresas)">Sistema</span>
                        }
                        else
                        {
                            <span class="ns-pill ns-pill--on">Empresa</span>
                        }
                    </td>
                    <td class="text-center">
                        <span class="@(c.Activo ? "ns-badge ns-badge--processed" : "ns-badge ns-badge--draft")">@(c.Activo ? "ACTIVO" : "INACTIVO")</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-codigo="@c.Codigo" class="btn btn-outline-primary btn-sm">Ver ítems</a>
                        <a asp-action="Export" asp-route-codigo="@c.Codigo" asp-route-format="Csv" class="btn btn-outline-secondary btn-sm" title="Exportar CSV"><span class="material-symbols-outlined align-middle" style="font-size:16px">download</span> CSV</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7"><div class="ns-empty"><span class="material-symbols-outlined">menu_book</span><p>Sin catálogos disponibles.</p></div></td></tr>
            }
        </tbody>
    </table>
    </div>
</div>
