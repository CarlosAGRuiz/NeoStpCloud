@model IReadOnlyList<NeoSTP.Application.Catalogos.Dtos.CatalogoDto>
@{
    ViewData["Title"] = "Catálogos";
    var puedeAdministrar = ViewBag.PuedeAdministrar is bool a && a;
    var empresaId = ViewBag.EmpresaId as int?;
    var search = ViewBag.Search as string;
    var totalItems = Model.Sum(c => c.TotalItems);
    var totalEmpresa = Model.Count(c => !c.EsSistema);
    var totalSistema = Model.Count(c => c.EsSistema);
    var activos = Model.Count(c => c.Activo);
}

<div class="ns-page-head ns-page-head--hero">
    <div>
        <nav class="ns-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>Catálogos</span>
        </nav>
        <h1 class="ns-page-title">Catálogos</h1>
        <p class="ns-page-subtitle">Gestión centralizada de diccionarios, catálogos fiscales y maestros del sistema.</p>
    </div>
    @if (puedeAdministrar)
    {
        <a asp-action="Create" class="btn btn-primary">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">add_circle</span>
            Nuevo catálogo
        </a>
    }
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">@ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">@err <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="ns-info-banner mb-4">
    <span class="material-symbols-outlined">info</span>
    <div>
        <strong>Información de origen:</strong>
        Los catálogos marcados como <span class="ns-badge ns-badge--draft">Sistema</span> son de solo lectura operativa.
        Los marcados como <span class="ns-badge ns-badge--processed">Empresa</span> pertenecen al contexto empresarial actual.
    </div>
</div>

<form method="get" class="ns-filter-card mb-4">
    <label class="ns-search-field">
        <span class="material-symbols-outlined">search</span>
        <input name="search" value="@search" class="form-control" placeholder="Buscar catálogos por código, nombre o descripción..." />
    </label>
    <button type="submit" class="btn btn-outline-secondary">
        <span class="material-symbols-outlined align-middle" style="font-size:18px">filter_list</span>
        Filtrar
    </button>
    @if (!string.IsNullOrWhiteSpace(search))
    {
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    }
</form>

<div class="card ns-data-card mb-4">
    <div class="ns-card-titlebar">
        <div>
            <h2>Maestros del sistema</h2>
            <p>
                @if (empresaId is null)
                {
                    <span>Mostrando catálogos globales del sistema.</span>
                }
                else
                {
                    <span>Mostrando catálogos del sistema + empresa <strong>#@empresaId</strong>.</span>
                }
            </p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table ns-table-modern m-0 align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre y descripción</th>
                    <th class="text-center">Ítems</th>
                    <th class="text-center">Versión</th>
                    <th class="text-center">Origen</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="@(!c.Activo ? "text-muted" : "")">
                        <td><code class="ns-code-token">@c.Codigo</code></td>
                        <td>
                            <strong>@c.Nombre</strong>
                            @if (!string.IsNullOrEmpty(c.Descripcion))
                            {
                                <div class="text-muted">@c.Descripcion</div>
                            }
                        </td>
                        <td class="text-center"><span class="ns-mono">@c.TotalItems.ToString("N0")</span></td>
                        <td class="text-center"><span class="ns-version">v@(c.Version)</span></td>
                        <td class="text-center">
                            @if (c.EsSistema)
                            {
                                <span class="ns-badge ns-badge--draft" title="Catálogo del sistema">Sistema</span>
                            }
                            else
                            {
                                <span class="ns-badge ns-badge--processed">Empresa</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="@(c.Activo ? "ns-pill ns-pill--on" : "ns-pill ns-pill--off")">@(c.Activo ? "Activo" : "Inactivo")</span>
                        </td>
                        <td class="text-end">
                            <span class="ns-row-actions">
                                <a asp-action="Details" asp-route-codigo="@c.Codigo" class="ns-action-btn ns-action-btn--primary" title="Ver detalle del catálogo">
                                    <span class="material-symbols-outlined">visibility</span>
                                </a>
                                @if (puedeAdministrar && c.EmpresaId == empresaId)
                                {
                                    <a asp-action="Edit" asp-route-codigo="@c.Codigo" class="ns-action-btn" title="Editar catálogo">
                                        <span class="material-symbols-outlined">edit</span>
                                    </a>
                                }
                                <a asp-action="Export" asp-route-codigo="@c.Codigo" asp-route-format="Csv" class="ns-action-btn" title="Exportar CSV">
                                    <span class="material-symbols-outlined">download</span>
                                </a>
                            </span>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7">
                            <div class="ns-empty">
                                <span class="material-symbols-outlined">menu_book</span>
                                <p>Sin catálogos disponibles para los criterios indicados.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="ns-table-footer">
        <span>Mostrando <strong>@Model.Count</strong> catálogos</span>
    </div>
</div>

<div class="ns-summary-grid">
    <section class="ns-summary-card">
        <p>Total ítems</p>
        <strong>@totalItems.ToString("N0")</strong>
        <span><span class="material-symbols-outlined">database</span> En catálogos visibles</span>
    </section>
    <section class="ns-summary-card">
        <p>Catálogos empresa</p>
        <strong>@totalEmpresa.ToString("N0")</strong>
        <span>@totalSistema.ToString("N0") catálogos del sistema incluidos</span>
    </section>
    <section class="ns-summary-card">
        <p>Catálogos activos</p>
        <strong>@activos.ToString("N0")</strong>
        <span>@(Model.Count - activos) inactivos en la vista actual</span>
    </section>
</div>
