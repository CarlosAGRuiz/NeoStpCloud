@model NeoSTP.Web.Models.CreateCatalogoViewModel
@{
    ViewData["Title"] = "Nuevo catálogo";
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <a asp-action="Index">Catálogos</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>Nuevo</span>
        </nav>
        <h1 class="ns-page-title">Nuevo catálogo</h1>
        <p class="ns-page-subtitle">Catálogo propio de la empresa: listas de valores para tu operación (categorías, zonas, tipos internos, etc.).</p>
    </div>
</div>

<div class="card ns-data-card" style="max-width:720px">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Codigo" class="form-label"></label>
                    <input asp-for="Codigo" class="form-control text-uppercase" placeholder="MI_CATALOGO" />
                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Crear catálogo</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
