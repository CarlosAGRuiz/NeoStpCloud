@model NeoSTP.Web.Models.CatalogoItemFormViewModel
@{
    var catalogo = (NeoSTP.Application.Catalogos.Dtos.CatalogoDto)ViewBag.Catalogo;
    ViewData["Title"] = $"Editar ítem {Model.Codigo}";
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <a asp-action="Index">Catálogos</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <a asp-action="Details" asp-route-codigo="@catalogo.Codigo">@catalogo.Codigo</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>@Model.Codigo</span>
        </nav>
        <h1 class="ns-page-title">Editar ítem <code class="ns-code-token">@Model.Codigo</code></h1>
        <p class="ns-page-subtitle">Catálogo @catalogo.Nombre</p>
    </div>
</div>

<div class="card ns-data-card" style="max-width:720px">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <form asp-action="EditItem" asp-route-codigo="@catalogo.Codigo" asp-route-itemId="@Model.ItemId" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Codigo" class="form-label"></label>
                    <input asp-for="Codigo" class="form-control" readonly />
                    <small class="text-muted">El código no se cambia; elimina y crea uno nuevo si lo necesitas.</small>
                </div>
                <div class="col-md-8">
                    <label asp-for="Valor" class="form-label"></label>
                    <input asp-for="Valor" class="form-control" />
                    <span asp-validation-for="Valor" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <input asp-for="Descripcion" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Orden" class="form-label"></label>
                    <input asp-for="Orden" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ParentCodigo" class="form-label"></label>
                    <input asp-for="ParentCodigo" class="form-control" placeholder="(opcional, cascadas)" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Details" asp-route-codigo="@catalogo.Codigo" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
