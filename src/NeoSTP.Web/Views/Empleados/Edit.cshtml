@model NeoSTP.Application.Rrhh.Dtos.UpdateEmpleadoRequest
@{
    ViewData["Title"] = "Editar empleado";
    var id = (int)ViewBag.EmpleadoId;
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><a asp-action="Index">Empleados</a><span class="material-symbols-outlined">chevron_right</span><span>Editar</span></nav>
        <h1 class="ns-page-title">Editar empleado</h1>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@id" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Fields" model="Model" />
            <div class="text-end mt-3">
                <a asp-action="Detalle" asp-route-id="@id" class="btn btn-outline-secondary btn-sm">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">save</span> Guardar cambios</button>
            </div>
        </form>
    </div>
</div>
