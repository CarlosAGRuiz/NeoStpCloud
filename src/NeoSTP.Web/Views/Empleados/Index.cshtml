@model NeoSTP.Application.Common.PagedResult<NeoSTP.Application.Rrhh.Dtos.EmpleadoDto>
@{
    ViewData["Title"] = "Empleados";
    var search = ViewBag.Search as string;
    var puedeGestionar = ViewBag.PuedeGestionar is bool g && g;
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><span>Empleados</span></nav>
        <h1 class="ns-page-title">Empleados</h1>
    </div>
    @if (puedeGestionar)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">person_add</span> Nuevo empleado</a>
    }
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="ns-toolbar">
    <form method="get" class="ns-toolbar-search">
        <input name="search" value="@search" class="form-control form-control-sm" style="min-width:260px" placeholder="Buscar nombre, código o documento…" />
        <button type="submit" class="btn btn-outline-secondary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">search</span> Buscar</button>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Documento</th>
                    <th>Cargo</th>
                    <th class="text-end">Salario</th>
                    <th>Pago</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model is null || !Model.Items.Any())
                {
                    <tr><td colspan="8"><div class="ns-empty"><span class="material-symbols-outlined">badge</span><p>Sin empleados registrados.</p></div></td></tr>
                }
                @foreach (var e in Model?.Items ?? Array.Empty<NeoSTP.Application.Rrhh.Dtos.EmpleadoDto>())
                {
                    var badge = e.EstadoCodigo == "ACTIVO" ? "ns-pill ns-pill--on" : "ns-pill ns-pill--off";
                    <tr>
                        <td class="ns-mono"><strong>@e.Codigo</strong></td>
                        <td><a asp-action="Detalle" asp-route-id="@e.Id">@e.NombreCompleto</a></td>
                        <td class="ns-mono small">@e.NumeroDocumento</td>
                        <td>@(e.Cargo ?? "—")</td>
                        <td class="text-end ns-mono">@e.SalarioMensual.ToString("N2")</td>
                        <td><span class="ns-badge ns-badge--draft">@e.PeriodicidadPago</span></td>
                        <td><span class="@badge">@e.EstadoCodigo</span></td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                            @if (puedeGestionar)
                            {
                                <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                @if (e.EstadoCodigo == "ACTIVO")
                                {
                                    <form asp-action="Inactivar" asp-route-id="@e.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Inactivar este empleado?');">Inactivar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Restaurar" asp-route-id="@e.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-success">Restaurar</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model is not null && Model.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search">@i</a>
            </li>
        }
    </ul></nav>
}

<p class="text-muted small mt-2">Total: @(Model?.Total ?? 0) empleados.</p>
