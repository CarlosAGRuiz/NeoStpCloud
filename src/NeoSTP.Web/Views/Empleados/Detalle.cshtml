@model NeoSTP.Application.Rrhh.Dtos.EmpleadoDetalleDto
@{
    ViewData["Title"] = $"Empleado · {Model.NombreCompleto}";
    var puedeGestionar = ViewBag.PuedeGestionar is bool g && g;
    var puedeVerNomina = ViewBag.PuedeVerNomina is bool n && n;
    var p = Model.NominaPreview;
    var activo = Model.EstadoCodigo == "ACTIVO";
}

<div class="ns-page-head ns-page-head--hero">
    <div>
        <nav class="ns-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <a asp-action="Index">Empleados</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>@Model.Codigo</span>
        </nav>
        <h1 class="ns-page-title">
            @Model.NombreCompleto
            <span class="ns-pill @(activo ? "ns-pill--on" : "ns-pill--off")">@Model.EstadoCodigo</span>
        </h1>
        <p class="ns-page-subtitle">Ficha laboral, contrato vigente y vista previa de nómina.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (puedeGestionar)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <span class="material-symbols-outlined" style="font-size:20px">edit</span>
                Editar
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <span class="material-symbols-outlined" style="font-size:20px">arrow_back</span>
            Volver
        </a>
    </div>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="ns-summary-grid mb-4">
    <section class="ns-summary-card">
        <p>Código</p>
        <strong class="ns-mono">@Model.Codigo</strong>
        <span><span class="material-symbols-outlined">badge</span> Expediente laboral</span>
    </section>
    <section class="ns-summary-card">
        <p>Salario mensual</p>
        <strong class="ns-mono">$ @Model.SalarioMensual.ToString("N2")</strong>
        <span>@Model.TipoContrato · @Model.PeriodicidadPago</span>
    </section>
    <section class="ns-summary-card">
        <p>Ingreso</p>
        <strong class="ns-mono">@Model.FechaIngreso.ToString("dd/MM/yyyy")</strong>
        <span>@(Model.Cargo ?? "Sin cargo asignado")</span>
    </section>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="card ns-data-card h-100">
            <div class="ns-card-titlebar">
                <div>
                    <h2>Datos del empleado</h2>
                    <p>Identificación, contacto y seguridad social.</p>
                </div>
            </div>
            <div class="card-body">
                <dl class="row gy-3 mb-0">
                    <dt class="col-sm-4 text-muted small">Documento</dt>
                    <dd class="col-sm-8 ns-mono">@Model.TipoDocumento · @Model.NumeroDocumento</dd>

                    <dt class="col-sm-4 text-muted small">NIT</dt>
                    <dd class="col-sm-8 ns-mono">@(Model.Nit ?? "No registrado")</dd>

                    <dt class="col-sm-4 text-muted small">ISSS</dt>
                    <dd class="col-sm-8 ns-mono">@(Model.IsssNumero ?? "No registrado")</dd>

                    <dt class="col-sm-4 text-muted small">AFP</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.AfpInstitucion) ? "No registrada" : Model.AfpInstitucion)
                        @if (!string.IsNullOrWhiteSpace(Model.AfpNumero))
                        {
                            <span class="ns-mono small text-muted">@Model.AfpNumero</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small">Nacimiento</dt>
                    <dd class="col-sm-8 ns-mono">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrado")</dd>

                    <dt class="col-sm-4 text-muted small">Email</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "No registrado")</dd>

                    <dt class="col-sm-4 text-muted small">Teléfono</dt>
                    <dd class="col-sm-8 ns-mono">@(Model.Telefono ?? "No registrado")</dd>

                    @if (Model.FechaEgreso is DateOnly fe)
                    {
                        <dt class="col-sm-4 text-muted small">Egreso</dt>
                        <dd class="col-sm-8 ns-mono">@fe.ToString("dd/MM/yyyy")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        @if (puedeVerNomina && p is not null)
        {
            <div class="card ns-data-card h-100">
                <div class="ns-card-titlebar">
                    <div>
                        <h2>Vista previa de nómina</h2>
                        <p>Cálculo mensual con parámetros configurados.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Salario bruto</span>
                        <span class="ns-mono fw-semibold">$ @p.SalarioBruto.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">ISSS empleado</span>
                        <span class="ns-mono text-danger">- $ @p.IsssEmpleado.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">AFP empleado</span>
                        <span class="ns-mono text-danger">- $ @p.AfpEmpleado.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Renta</span>
                        <span class="ns-mono text-danger">- $ @p.Renta.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between py-3">
                        <span class="fw-bold">Líquido a pagar</span>
                        <span class="ns-mono fw-bold fs-4" style="color:var(--ns-processed)">$ @p.SalarioNeto.ToString("N2")</span>
                    </div>
                    <div class="ns-info-banner mt-3 mb-0">
                        <span class="material-symbols-outlined">info</span>
                        <span>Aporte patronal estimado: ISSS $ @p.IsssPatronal.ToString("N2") · AFP $ @p.AfpPatronal.ToString("N2"). Costo total $ @p.CostoPatronal.ToString("N2").</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card ns-data-card h-100">
                <div class="card-body ns-empty">
                    <span class="material-symbols-outlined">lock</span>
                    <p>Sin permiso para ver nómina.</p>
                </div>
            </div>
        }
    </div>
</div>
