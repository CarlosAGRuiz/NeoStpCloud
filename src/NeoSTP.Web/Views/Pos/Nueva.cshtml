@{
    ViewData["Title"] = "Nueva venta";
    var formasPago = ViewBag.FormasPago as string[] ?? Array.Empty<string>();
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><a asp-action="Index">Ventas POS</a><span class="material-symbols-outlined">chevron_right</span><span>Nueva</span></nav>
        <h1 class="ns-page-title">Nueva venta</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
</div>

@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><span class="material-symbols-outlined align-middle">search</span> Buscar producto</div>
            <div class="card-body">
                <div class="position-relative">
                    <input id="busqueda" class="form-control" placeholder="Escribe nombre o código… (Enter agrega el primero)" autocomplete="off" autofocus />
                    <div id="sugerencias" class="list-group position-absolute w-100 shadow" style="z-index:20; display:none; max-height:280px; overflow:auto;"></div>
                </div>
                <div class="mt-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="agregarManual()"><span class="material-symbols-outlined align-middle" style="font-size:16px">add</span> Ítem manual</button>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="table-responsive">
                <table class="table table-sm align-middle m-0">
                    <thead>
                        <tr>
                            <th>Descripción</th>
                            <th class="text-center" style="width:120px">Cant.</th>
                            <th class="text-end" style="width:120px">Precio</th>
                            <th class="text-end" style="width:120px">Total</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody id="carrito">
                        <tr id="vacio"><td colspan="5"><div class="ns-empty"><span class="material-symbols-outlined">shopping_cart</span><p>Carrito vacío.</p></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><span class="material-symbols-outlined align-middle">receipt</span> Cobro</div>
            <div class="card-body">
                <div class="d-flex justify-content-between py-1"><span class="text-muted">Subtotal</span><span class="ns-mono" id="t-subtotal">0.00</span></div>
                <div class="d-flex justify-content-between py-1"><span class="text-muted">IVA</span><span class="ns-mono" id="t-iva">0.00</span></div>
                <div class="d-flex justify-content-between py-2 border-top"><span class="fw-bold fs-5">Total</span><span class="ns-mono fw-bold fs-3" style="color:var(--ns-processed)" id="t-total">0.00</span></div>

                <form asp-action="Registrar" method="post" id="formVenta" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="lineasJson" id="lineasJson" />
                    <div class="mb-2">
                        <label class="form-label small">Cliente</label>
                        <input name="clienteNombre" class="form-control form-control-sm" placeholder="Consumidor final" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Forma de pago</label>
                        <select name="formaPago" id="formaPago" class="form-select form-select-sm">
                            @foreach (var f in formasPago) { <option value="@f">@f</option> }
                        </select>
                    </div>
                    <div class="mb-2" id="boxEfectivo">
                        <label class="form-label small">Efectivo recibido</label>
                        <input name="efectivoRecibido" id="efectivo" type="number" step="0.01" min="0" class="form-control form-control-sm ns-mono" oninput="calcCambio()" />
                        <div class="d-flex justify-content-between mt-1 small"><span class="text-muted">Cambio</span><span class="ns-mono" id="t-cambio">0.00</span></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Nota (opcional)</label>
                        <input name="nota" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" id="btnCobrar" disabled><span class="material-symbols-outlined align-middle" style="font-size:18px">payments</span> Cobrar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const IVA = 0.13;
    let cart = [];
    const buscarUrl = '@Url.Action("BuscarProductos", "Pos")';

    const fmt = n => (Math.round(n * 100) / 100).toFixed(2);

    function render() {
        const tb = document.getElementById('carrito');
        const vacio = document.getElementById('vacio');
        tb.querySelectorAll('tr[data-row]').forEach(r => r.remove());
        let subtotal = 0, iva = 0, total = 0;
        cart.forEach((l, i) => {
            const lineaTotal = Math.max(0, l.precio * l.cantidad - (l.descuento || 0));
            const lineaIva = l.aplicaIva ? lineaTotal - lineaTotal / (1 + IVA) : 0;
            subtotal += lineaTotal - lineaIva; iva += lineaIva; total += lineaTotal;
            const tr = document.createElement('tr');
            tr.setAttribute('data-row', i);
            tr.innerHTML = `
                <td>${l.descripcion}<div class="small text-muted ns-mono">${l.codigo || ''}</div></td>
                <td class="text-center"><input type="number" min="0.01" step="1" value="${l.cantidad}" class="form-control form-control-sm ns-mono text-center" onchange="setCant(${i}, this.value)"></td>
                <td class="text-end"><input type="number" min="0" step="0.01" value="${fmt(l.precio)}" class="form-control form-control-sm ns-mono text-end" onchange="setPrecio(${i}, this.value)"></td>
                <td class="text-end ns-mono">${fmt(lineaTotal)}</td>
                <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" onclick="quitar(${i})"><span class="material-symbols-outlined" style="font-size:16px">delete</span></button></td>`;
            tb.appendChild(tr);
        });
        vacio.style.display = cart.length ? 'none' : '';
        document.getElementById('t-subtotal').textContent = fmt(subtotal);
        document.getElementById('t-iva').textContent = fmt(iva);
        document.getElementById('t-total').textContent = fmt(total);
        document.getElementById('btnCobrar').disabled = cart.length === 0;
        calcCambio();
    }

    function agregar(p) {
        const ex = cart.find(x => x.productoId === p.id && p.id);
        if (ex) ex.cantidad += 1;
        else cart.push({ productoId: p.id || null, codigo: p.codigo, descripcion: p.nombre, cantidad: 1, precio: p.precio, descuento: 0, aplicaIva: p.iva });
        render();
    }
    function agregarManual() {
        const desc = prompt('Descripción del ítem:'); if (!desc) return;
        const precio = parseFloat(prompt('Precio (IVA incl.):', '0')) || 0;
        cart.push({ productoId: null, codigo: '—', descripcion: desc, cantidad: 1, precio: precio, descuento: 0, aplicaIva: true });
        render();
    }
    function setCant(i, v) { cart[i].cantidad = Math.max(0.0001, parseFloat(v) || 1); render(); }
    function setPrecio(i, v) { cart[i].precio = Math.max(0, parseFloat(v) || 0); render(); }
    function quitar(i) { cart.splice(i, 1); render(); }

    function calcCambio() {
        const total = parseFloat(document.getElementById('t-total').textContent) || 0;
        const ef = parseFloat(document.getElementById('efectivo').value) || 0;
        document.getElementById('t-cambio').textContent = fmt(Math.max(0, ef - total));
    }
    document.getElementById('formaPago').addEventListener('change', e => {
        document.getElementById('boxEfectivo').style.display = e.target.value === 'EFECTIVO' ? '' : 'none';
    });

    // Autocompletar
    const box = document.getElementById('busqueda');
    const sug = document.getElementById('sugerencias');
    let lastResults = [];
    let timer;
    box.addEventListener('input', () => {
        clearTimeout(timer);
        const term = box.value.trim();
        if (term.length < 1) { sug.style.display = 'none'; return; }
        timer = setTimeout(async () => {
            const r = await fetch(`${buscarUrl}?term=${encodeURIComponent(term)}`);
            lastResults = await r.json();
            sug.innerHTML = lastResults.map((p, idx) =>
                `<button type="button" class="list-group-item list-group-item-action d-flex justify-content-between" onclick="pick(${idx})"><span>${p.nombre} <span class="text-muted small ns-mono">${p.codigo}</span></span><span class="ns-mono">${fmt(p.precio)}</span></button>`).join('');
            sug.style.display = lastResults.length ? '' : 'none';
        }, 200);
    });
    box.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); if (lastResults.length) pick(0); }
    });
    function pick(idx) { agregar(lastResults[idx]); box.value = ''; sug.style.display = 'none'; box.focus(); lastResults = []; }
    document.addEventListener('click', e => { if (!sug.contains(e.target) && e.target !== box) sug.style.display = 'none'; });

    document.getElementById('formVenta').addEventListener('submit', e => {
        if (cart.length === 0) { e.preventDefault(); return; }
        document.getElementById('lineasJson').value = JSON.stringify(cart.map(l => ({
            productoId: l.productoId, codigo: l.codigo, descripcion: l.descripcion,
            cantidad: l.cantidad, precioUnitario: l.precio, descuento: l.descuento || 0, aplicaIva: l.aplicaIva
        })));
    });
</script>
}
