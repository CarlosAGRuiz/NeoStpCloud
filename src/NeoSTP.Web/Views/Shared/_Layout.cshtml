@using Microsoft.EntityFrameworkCore
@inject NeoSTP.Application.Empresas.IEmpresaContext EmpresaContext
@inject NeoSTP.Infrastructure.Persistence.NeoStpDbContext Db
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject Microsoft.Extensions.Localization.IStringLocalizer<NeoSTP.Web.SharedResource> L

@{
    var idiomaActual = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var username = User.Identity?.Name;
    var isAuth = User.Identity?.IsAuthenticated ?? false;
    var tipoUsuario = User.FindFirst(NeoSTP.Web.Auth.CookieCurrentUser.ClaimTipoUsuario)?.Value;
    var isSuperAdmin = tipoUsuario == "SUPERADMIN";

    var soporteEmpresaNombre = EmpresaContext.SupportEmpresaNombre;
    var enModoSoporte = EmpresaContext.IsSupportMode;
    var empresaActualId = EmpresaContext.CurrentEmpresaId;

    var modulosActivos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    if (isAuth)
    {
        if (isSuperAdmin)
        {
            modulosActivos = (await Db.Modulos
                    .AsNoTracking()
                    .Where(m => m.Activo)
                    .Select(m => m.Codigo)
                    .ToListAsync())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        else if (empresaActualId.HasValue)
        {
            modulosActivos = (await Db.EmpresaModulos
                    .AsNoTracking()
                    .Where(em => em.EmpresaId == empresaActualId.Value
                                 && em.Activo
                                 && em.FechaInactivacion == null
                                 && em.Modulo.Activo)
                    .Select(em => em.Modulo.Codigo)
                    .ToListAsync())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
    }

    bool ModuloActivo(string codigo)
        => isSuperAdmin || modulosActivos.Contains(codigo);

    bool TienePermiso(string codigo)
        => isSuperAdmin || User.HasClaim("permiso", codigo);

    var puedeVerDte = ModuloActivo("NEODTE") && (TienePermiso("DTE.Emitir") || TienePermiso("DTE.Consultar"));
    var puedeVerCobros = ModuloActivo("CORE") && TienePermiso("Cobros.Ver");
    var puedeVerEventos = ModuloActivo("EVENTOSDTE") && TienePermiso("DTE.Eventos.Ver");
    var puedeVerContingencia = ModuloActivo("CONTINGENCIA") && TienePermiso("DTE.Contingencia");
    var puedeVerDiagnostico = ModuloActivo("NEODTE") && TienePermiso("DTE.Diagnostico");
    var puedeVerCertificacion = ModuloActivo("NEODTE") && TienePermiso("Core.Certificacion.Ver");

    var puedeVerClientes = ModuloActivo("CORE") && TienePermiso("Clientes.Ver");
    var puedeVerProductos = ModuloActivo("CORE") && TienePermiso("Productos.Ver");
    var puedeVerCatalogos = ModuloActivo("CORE") && TienePermiso("Core.Catalogos.Ver");

    var puedeVerReportes = ModuloActivo("NEOBI") && TienePermiso("Reportes.Ver");
    var puedeVerProfit = ModuloActivo("NEOPROFIT") && TienePermiso("Profit.Ver");
    var puedeVerScan = ModuloActivo("NEOSCANAI") && TienePermiso("ScanAI.Ver");
    var puedeVerConta = ModuloActivo("NEOCONTA") && TienePermiso("Conta.Ver");

    var puedeVerAgenda = ModuloActivo("NEOAGENDA") && TienePermiso("Agenda.Ver");
    var puedeVerCrm = ModuloActivo("NEOCRM") && TienePermiso("Crm.Oportunidades.Ver");
    var puedeVerCrmContactos = ModuloActivo("NEOCRM") && TienePermiso("Crm.Contactos.Ver");
    var puedeVerCrmCotizaciones = ModuloActivo("NEOCRM") && TienePermiso("Crm.Cotizaciones.Ver");

    var puedeVerPortal = ModuloActivo("NEOPORTAL") && TienePermiso("Portal.Enlaces.Ver");

    var puedeVerPos = ModuloActivo("NEOPOS") && TienePermiso("Pos.Ver");
    var puedeVerInventario = ModuloActivo("INVENTARIO") && TienePermiso("Inventario.Ver");

    var puedeVerEmpleados = ModuloActivo("NEORRHH") && TienePermiso("Rrhh.Empleados.Ver");
    var puedeVerNomina = ModuloActivo("NEORRHH") && TienePermiso("Rrhh.Nomina.Ver");

    var puedeVerTesoreria = ModuloActivo("NEOTESORERIA") && TienePermiso("Tesoreria.Cuentas.Ver");

    var puedeVerProveedores = ModuloActivo("COMPRAS") && TienePermiso("Compras.Proveedores.Ver");
    var puedeVerCompras = ModuloActivo("COMPRAS") && TienePermiso("Compras.Ver");

    var puedeVerIntegraciones = ModuloActivo("NEOCONNECT") && TienePermiso("Connect.ApiKeys.Ver");

    var puedeConfigurarCorreo = ModuloActivo("CORE") && TienePermiso("Core.Correo.Configurar");
    var puedeVerAuditoria = isSuperAdmin || TienePermiso("Core.Auditoria.Ver");
    var puedeVerHardening = isSuperAdmin || TienePermiso("Ops.Hardening.Ver");

    var puedeVerAdministracion =
        isSuperAdmin
        || TienePermiso("Core.Empresa.Ver")
        || TienePermiso("Core.Sucursales.Administrar")
        || TienePermiso("Core.Usuarios.Ver")
        || TienePermiso("DTE.Configurar")
        || TienePermiso("Seguridad.Sso.Gestionar")
        || TienePermiso("Datos.Exportar")
        || puedeConfigurarCorreo;

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var actionName = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    Func<string, string> active = name =>
        string.Equals(ctrl, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    var comprasOrdenActiva = string.Equals(ctrl, "Compras", StringComparison.OrdinalIgnoreCase)
        && actionName.Contains("Orden", StringComparison.OrdinalIgnoreCase) ? "active" : "";

    var comprasCxpActiva = string.Equals(ctrl, "Compras", StringComparison.OrdinalIgnoreCase)
        && !actionName.Contains("Orden", StringComparison.OrdinalIgnoreCase) ? "active" : "";

    var haciendaHttp = string.Equals(Config["Hacienda:Client"], "Http", StringComparison.OrdinalIgnoreCase);
    var envLabel = haciendaHttp ? "PRUEBAS · HACIENDA" : "MOCK";
    var inicial = string.IsNullOrEmpty(username) ? "?" : username!.Substring(0, 1).ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="@idiomaActual">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · NeoSTP Cloud</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Hanken+Grotesk:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/neostp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NeoSTP.Web.styles.css" asp-append-version="true" />
</head>
<body class="ns-app">
<a class="ns-skip-link" href="#contenido-principal">@L["SaltarContenido"]</a>
@if (!isAuth)
{
    @RenderBody()
}
else
{
    <div class="ns-shell">
        <div class="ns-backdrop" onclick="document.body.classList.remove('ns-drawer-open')"></div>

        <!-- Sidebar -->
        <aside class="ns-sidebar" aria-label="@L["MenuPrincipal"]">
            <a class="ns-brand text-decoration-none" asp-controller="Home" asp-action="Index">
                <span class="ns-brand-logo"><span class="material-symbols-outlined fill">cloud_done</span></span>
                <span>
                    <span class="ns-brand-title d-block">NeoSTP</span>
                    <span class="ns-brand-sub d-block">Enterprise SaaS</span>
                </span>
            </a>

@*                 <div style="font-size:11px;color:#fbbf24;padding:8px 12px;border:1px solid #fbbf24;margin:8px;border-radius:8px;line-height:1.4">
                    <div><strong>DEBUG MENÚ</strong></div>
                    <div>Usuario: @username</div>
                    <div>TipoUsuario claim: @(tipoUsuario ?? "NULL")</div>
                    <div>EmpresaContext.CurrentEmpresaId: @(empresaActualId?.ToString() ?? "NULL")</div>
                    <div>IsSuperAdmin: @isSuperAdmin</div>
                    <div>Módulos activos: @string.Join(", ", modulosActivos)</div>
                    <div>CRM visible: @puedeVerCrm</div>
                    <div>RRHH visible: @puedeVerEmpleados / @puedeVerNomina</div>
                    <div>POS visible: @puedeVerPos</div>
                    <div>Inventario visible: @puedeVerInventario</div>
                    <div>Tesorería visible: @puedeVerTesoreria</div>
                    <div>Conta visible: @puedeVerConta</div>
                </div> *@

            <nav class="ns-nav">
                <div class="ns-nav-group">Operación</div>
                <a class="ns-nav-link @active("Home")" asp-controller="Home" asp-action="Index"><span class="material-symbols-outlined">dashboard</span> Dashboard</a>
                <a class="ns-nav-link @active("Onboarding")" asp-controller="Onboarding" asp-action="Index"><span class="material-symbols-outlined">rocket_launch</span> Asistente</a>
                <a class="ns-nav-link @active("Alertas")" asp-controller="Alertas" asp-action="Index"><span class="material-symbols-outlined">notifications</span> Notificaciones</a>
                    @if (puedeVerDte)
                    {
                        <a class="ns-nav-link @active("DteDocumentos")" asp-controller="DteDocumentos" asp-action="Index">
                            <span class="material-symbols-outlined">receipt_long</span> Documentos DTE
                        </a>
                    }
                @if (puedeVerCobros)
                {
                    <a class="ns-nav-link @active("Cobros")" asp-controller="Cobros" asp-action="Index"><span class="material-symbols-outlined">paid</span> Cobros</a>
                    <a class="ns-nav-link" asp-controller="Cobros" asp-action="Recordatorios"><span class="material-symbols-outlined">notifications_active</span> Recordatorios</a>
                }
                @if (puedeVerEventos)
                {
                    <a class="ns-nav-link @active("DteEventos")" asp-controller="DteEventos" asp-action="Index"><span class="material-symbols-outlined">event_note</span> Eventos</a>
                }
                @if (puedeVerContingencia)
                {
                    <a class="ns-nav-link @active("DteContingencia")" asp-controller="DteContingencia" asp-action="Index"><span class="material-symbols-outlined">bolt</span> Contingencia</a>
                }
                @if (puedeVerDiagnostico)
                {
                    <a class="ns-nav-link @active("DiagnosticoHacienda")" asp-controller="DiagnosticoHacienda" asp-action="Index"><span class="material-symbols-outlined">troubleshoot</span> Diagnóstico</a>
                }
                @if (puedeVerCertificacion)
                {
                    <a class="ns-nav-link @active("Certificacion")" asp-controller="Certificacion" asp-action="Index"><span class="material-symbols-outlined">verified</span> Certificación</a>
                }

                    @if (puedeVerClientes || puedeVerProductos || puedeVerCatalogos)
                    {
                        <div class="ns-nav-group">Datos maestros</div>

                        @if (puedeVerClientes)
                        {
                            <a class="ns-nav-link @active("Clientes")" asp-controller="Clientes" asp-action="Index">
                                <span class="material-symbols-outlined">groups</span> Clientes
                            </a>
                        }

                        @if (puedeVerProductos)
                        {
                            <a class="ns-nav-link @active("Productos")" asp-controller="Productos" asp-action="Index">
                                <span class="material-symbols-outlined">inventory_2</span> Productos
                            </a>
                        }

                        @if (puedeVerCatalogos)
                        {
                            <a class="ns-nav-link @active("Catalogos")" asp-controller="Catalogos" asp-action="Index">
                                <span class="material-symbols-outlined">menu_book</span> Catálogos
                            </a>
                        }
                    }


                @if (puedeVerProfit || puedeVerScan || puedeVerReportes || puedeVerConta)
                {
                    <div class="ns-nav-group">Inteligencia</div>
                    @if (puedeVerReportes)
                    {
                        <a class="ns-nav-link @active("NeoBi")" asp-controller="NeoBi" asp-action="Index"><span class="material-symbols-outlined">summarize</span> NeoBI fiscal</a>
                    }
                    @if (puedeVerConta)
                    {
                        <a class="ns-nav-link @active("Conta")" asp-controller="Conta" asp-action="Index"><span class="material-symbols-outlined">menu_book</span> NeoConta</a>
                    }
                    @if (puedeVerProfit)
                    {
                        <a class="ns-nav-link @active("Profit")" asp-controller="Profit" asp-action="Index"><span class="material-symbols-outlined">trending_up</span> NeoProfit</a>
                        <a class="ns-nav-link @active("ProfitGastos")" asp-controller="ProfitGastos" asp-action="Index"><span class="material-symbols-outlined">payments</span> Gastos</a>
                        <a class="ns-nav-link @active("ProfitCompras")" asp-controller="ProfitCompras" asp-action="Index"><span class="material-symbols-outlined">shopping_cart</span> Compras</a>
                    }
                    @if (puedeVerScan)
                    {
                        <a class="ns-nav-link @active("Scan")" asp-controller="Scan" asp-action="Index"><span class="material-symbols-outlined">document_scanner</span> NeoScan</a>
                        <a class="ns-nav-link @active("DteRecibidos")" asp-controller="DteRecibidos" asp-action="Index"><span class="material-symbols-outlined">inbox</span> DTE recibidos</a>
                    }
                }

                    @if (puedeVerAgenda)
                    {
                        <div class="ns-nav-group">Agenda</div>
                        <a class="ns-nav-link @active("Agenda")" asp-controller="Agenda" asp-action="Index">
                            <span class="material-symbols-outlined">calendar_month</span> Citas
                        </a>
                        <a class="ns-nav-link" asp-controller="Agenda" asp-action="Comisiones">
                            <span class="material-symbols-outlined">percent</span> Comisiones
                        </a>
                    }

                    @if (puedeVerCrm || puedeVerCrmContactos || puedeVerCrmCotizaciones)
                    {
                        <div class="ns-nav-group">CRM</div>

                        @if (puedeVerCrm)
                        {
                            <a class="ns-nav-link @active("Crm")" asp-controller="Crm" asp-action="Index">
                                <span class="material-symbols-outlined">handshake</span> Pipeline
                            </a>
                            <a class="ns-nav-link" asp-controller="Crm" asp-action="Actividades">
                                <span class="material-symbols-outlined">checklist</span> Actividades
                            </a>
                        }

                        @if (puedeVerCrmContactos)
                        {
                            <a class="ns-nav-link" asp-controller="Crm" asp-action="Contactos">
                                <span class="material-symbols-outlined">group</span> Contactos
                            </a>
                        }

                        @if (puedeVerCrmCotizaciones)
                        {
                            <a class="ns-nav-link" asp-controller="Crm" asp-action="Cotizaciones">
                                <span class="material-symbols-outlined">request_quote</span> Cotizaciones
                            </a>
                        }
                    }

                    @if (puedeVerPortal)
                    {
                        <div class="ns-nav-group">Portal</div>
                        <a class="ns-nav-link @active("PortalEnlaces")" asp-controller="PortalEnlaces" asp-action="Index">
                            <span class="material-symbols-outlined">public</span> Portal del cliente
                        </a>
                    }

                @if (puedeVerPos)
                {
                    <div class="ns-nav-group">Punto de venta</div>
                    <a class="ns-nav-link @active("Pos")" asp-controller="Pos" asp-action="Index"><span class="material-symbols-outlined">point_of_sale</span> Ventas POS</a>
                    <a class="ns-nav-link" asp-controller="Pos" asp-action="Nueva"><span class="material-symbols-outlined">add_shopping_cart</span> Nueva venta</a>
                    <a class="ns-nav-link @active("Caja")" asp-controller="Caja" asp-action="Index"><span class="material-symbols-outlined">account_balance_wallet</span> Caja / corte</a>
                    <a class="ns-nav-link @active("Impresoras")" asp-controller="Impresoras" asp-action="Index"><span class="material-symbols-outlined">print</span> Impresoras</a>
                }

                @if (puedeVerEmpleados || puedeVerNomina)
                {
                    <div class="ns-nav-group">Recursos Humanos</div>
                    @if (puedeVerEmpleados)
                    {
                        <a class="ns-nav-link @active("Empleados")" asp-controller="Empleados" asp-action="Index"><span class="material-symbols-outlined">badge</span> Empleados</a>
                    }
                    @if (puedeVerNomina)
                    {
                        <a class="ns-nav-link @active("Planilla")" asp-controller="Planilla" asp-action="Index"><span class="material-symbols-outlined">payments</span> Planilla</a>
                        <a class="ns-nav-link @active("Prestaciones")" asp-controller="Prestaciones" asp-action="Index"><span class="material-symbols-outlined">event_available</span> Prestaciones</a>
                    }
                }

                @if (puedeVerTesoreria)
                {
                    <div class="ns-nav-group">Tesorería</div>
                    <a class="ns-nav-link @active("Tesoreria")" asp-controller="Tesoreria" asp-action="Index"><span class="material-symbols-outlined">account_balance</span> Cuentas</a>
                    <a class="ns-nav-link @active("Movimientos")" asp-controller="Tesoreria" asp-action="Movimientos"><span class="material-symbols-outlined">sync_alt</span> Movimientos</a>
                    <a class="ns-nav-link @active("Conciliacion")" asp-controller="Tesoreria" asp-action="Conciliacion"><span class="material-symbols-outlined">join_inner</span> Conciliación</a>
                }

                @if (puedeVerProveedores || puedeVerCompras)
                {
                    <div class="ns-nav-group">Compras</div>
                    @if (puedeVerProveedores)
                    {
                        <a class="ns-nav-link @active("Proveedores")" asp-controller="Proveedores" asp-action="Index"><span class="material-symbols-outlined">local_shipping</span> Proveedores</a>
                    }
                    @if (puedeVerCompras)
                    {
                        <a class="ns-nav-link @comprasOrdenActiva" asp-controller="Compras" asp-action="Ordenes"><span class="material-symbols-outlined">shopping_cart_checkout</span> Ordenes de compra</a>
                        <a class="ns-nav-link @comprasCxpActiva" asp-controller="Compras" asp-action="Index"><span class="material-symbols-outlined">receipt_long</span> Cuentas por pagar</a>
                    }
                }

                @if (puedeVerInventario)
                {
                    <div class="ns-nav-group">Inventario</div>
                    <a class="ns-nav-link @active("Inventario")" asp-controller="Inventario" asp-action="Index"><span class="material-symbols-outlined">inventory_2</span> Existencias</a>
                }

                    @if (puedeVerAdministracion)
                    {
                        <div class="ns-nav-group">Administración</div>

                        @if (isSuperAdmin || TienePermiso("Core.Empresa.Ver"))
                        {
                            <a class="ns-nav-link @active("Empresas")" asp-controller="Empresas" asp-action="Index">
                                <span class="material-symbols-outlined">domain</span> Empresa
                            </a>
                        }

                        @if (isSuperAdmin || TienePermiso("Core.Sucursales.Administrar"))
                        {
                            <a class="ns-nav-link @active("Sucursales")" asp-controller="Sucursales" asp-action="Index">
                                <span class="material-symbols-outlined">store</span> Sucursales
                            </a>
                        }

                        @if (isSuperAdmin || TienePermiso("Core.Usuarios.Ver"))
                        {
                            <a class="ns-nav-link @active("Usuarios")" asp-controller="Usuarios" asp-action="Index">
                                <span class="material-symbols-outlined">group</span> Usuarios
                            </a>
                        }

                        @if (isSuperAdmin || TienePermiso("DTE.Configurar"))
                        {
                            <a class="ns-nav-link @active("DteConfiguracion")" asp-controller="DteConfiguracion" asp-action="Index">
                                <span class="material-symbols-outlined">settings</span> Config DTE
                            </a>
                        }

                        @if (isSuperAdmin || TienePermiso("Core.Empresa.Editar"))
                        {
                            <a class="ns-nav-link @active("Branding")" asp-controller="Branding" asp-action="Index">
                                <span class="material-symbols-outlined">palette</span> Logo y firma
                            </a>
                        }

                        @if (isSuperAdmin || TienePermiso("Seguridad.Sso.Gestionar"))
                        {
                            <a class="ns-nav-link @active("Sso")" asp-controller="Sso" asp-action="Index">
                                <span class="material-symbols-outlined">key</span> SSO corporativo
                            </a>
                        }

                        @if (isSuperAdmin || TienePermiso("Datos.Exportar"))
                        {
                            <a class="ns-nav-link @active("Datos")" asp-controller="Datos" asp-action="Index">
                                <span class="material-symbols-outlined">folder_zip</span> Tus datos
                            </a>
                        }

                        @if (puedeConfigurarCorreo)
                        {
                            <a class="ns-nav-link @active("Correo")" asp-controller="Correo" asp-action="Index">
                                <span class="material-symbols-outlined">mail</span> Correo
                            </a>
                        }

                        @if (isSuperAdmin)
                        {
                            <a class="ns-nav-link @active("Planes")" asp-controller="Planes" asp-action="Index">
                                <span class="material-symbols-outlined">workspace_premium</span> Planes
                            </a>

                            <a class="ns-nav-link @active("Billing")" asp-controller="Billing" asp-action="Index">
                                <span class="material-symbols-outlined">credit_card</span> Billing
                            </a>
                        }
                    }


                @if (puedeVerIntegraciones)
                {
                    <a class="ns-nav-link @active("Integraciones")" asp-controller="Integraciones" asp-action="Index"><span class="material-symbols-outlined">hub</span> Integraciones</a>
                }

                @if (puedeVerHardening || isSuperAdmin || puedeVerAuditoria)
                {
                    <div class="ns-nav-group">Sistema</div>
                    @if (isSuperAdmin)
                    {
                        <a class="ns-nav-link" asp-controller="Billing" asp-action="Transferencias"><span class="material-symbols-outlined">price_check</span> Verificar pagos</a>
                    }
                    @if (puedeVerAuditoria)
                    {
                        <a class="ns-nav-link @active("Auditoria")" asp-controller="Auditoria" asp-action="Index"><span class="material-symbols-outlined">history</span> Auditoría</a>
                    }
                    @if (puedeVerHardening)
                    {
                        <a class="ns-nav-link @active("Hardening")" asp-controller="Hardening" asp-action="Index"><span class="material-symbols-outlined">shield</span> Hardening</a>
                    }
                }
            </nav>

            <div class="ns-sidebar-foot">
                <div class="ns-user-card">
                    <span class="ns-user-avatar">@inicial</span>
                    <span class="overflow-hidden">
                        <span class="ns-user-name d-block">@username</span>
                        <span class="ns-user-role d-block">@(isSuperAdmin ? "SuperAdmin" : tipoUsuario)</span>
                    </span>
                </div>
            </div>
        </aside>

        <!-- Main -->
        <div class="ns-main">
            @if (enModoSoporte)
            {
                <div class="ns-support-banner">
                    <span><span class="material-symbols-outlined align-middle" style="font-size:18px">warning</span> <strong>Modo soporte activo</strong> · operando como: <strong>@soporteEmpresaNombre</strong></span>
                    <form asp-controller="Soporte" asp-action="Salir" method="post" class="d-inline m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-link p-0">Salir del modo soporte</button>
                    </form>
                </div>
            }

            <header class="ns-topbar">
                <div class="ns-topbar-left">
                    <button class="ns-hamburger" onclick="document.body.classList.toggle('ns-drawer-open')" aria-label="@L["AbrirMenu"]">
                        <span class="material-symbols-outlined">menu</span>
                    </button>
                    <h1 class="ns-topbar-title">@(ViewData["Title"] ?? "NeoSTP Cloud")</h1>
                    <span class="ns-env @(haciendaHttp ? "ns-env--prod" : "ns-env--test")">
                        <span class="ns-env-dot"></span>@envLabel
                    </span>
                </div>
                <div class="ns-topbar-right">
                    <button type="button" class="ns-chip" id="busquedaGlobalBtn" title="Buscar (Ctrl+K)">
                        <span class="material-symbols-outlined" style="font-size:16px" aria-hidden="true">search</span> Buscar
                        <kbd class="small text-muted ms-1" style="font-size:10px">Ctrl+K</kbd>
                    </button>
                    @if (isSuperAdmin)
                    {
                        <a class="ns-chip" asp-controller="Soporte" asp-action="Operacion" title="Operación del servicio">
                            <span class="material-symbols-outlined" style="font-size:16px">monitoring</span> Operación
                        </a>
                        <a class="ns-chip @(enModoSoporte ? "ns-chip--active" : "")" asp-controller="Soporte" asp-action="Index">
                            <span class="material-symbols-outlined" style="font-size:16px">@(enModoSoporte ? "location_on" : "build")</span>
                            @(enModoSoporte ? soporteEmpresaNombre : "Modo soporte")
                        </a>
                    }
                    @* Selector de empresa activa (membresías E1): visible solo con más de una empresa. *@
                    @if (!isSuperAdmin && User.Identity?.IsAuthenticated == true)
                    {
                        var uidClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                        if (int.TryParse(uidClaim, out var uidSel))
                        {
                            var misEmpresas = await Db.UsuarioEmpresas.AsNoTracking()
                                .Where(m => m.UsuarioId == uidSel && m.EstadoCodigo == "ACTIVO" && m.Empresa.EstadoCodigo == "ACTIVA")
                                .Select(m => new { m.EmpresaId, Nombre = m.Empresa.NombreComercial ?? m.Empresa.RazonSocial })
                                .ToListAsync();
                            var empresaActualId = EmpresaContext.CurrentEmpresaId;
                            var empresaPrincipal = await Db.Usuarios.AsNoTracking()
                                .Where(u => u.Id == uidSel && u.EmpresaId != null)
                                .Select(u => new { EmpresaId = u.EmpresaId!.Value, Nombre = u.Empresa!.NombreComercial ?? u.Empresa.RazonSocial })
                                .FirstOrDefaultAsync();
                            if (misEmpresas.Count > 0)
                            {
                                var actualNombre = empresaActualId == empresaPrincipal?.EmpresaId
                                    ? empresaPrincipal?.Nombre
                                    : misEmpresas.FirstOrDefault(e => e.EmpresaId == empresaActualId)?.Nombre;
                                @* Consolidado de grupo (E5): útil solo con más de una empresa. *@
                                var totalEmpresas = misEmpresas.Count + (empresaPrincipal is null ? 0 : 1);
                                if (totalEmpresas > 1)
                                {
                                    <a class="ns-chip @(ViewContext.RouteData.Values["controller"]?.ToString() == "Grupo" ? "ns-chip--active" : "")"
                                       asp-controller="Grupo" asp-action="Index" title="Consolidado de todas tus empresas">
                                        <span class="material-symbols-outlined" style="font-size:16px">dashboard</span> Grupo
                                    </a>
                                }
                                <div class="dropdown">
                                    <button class="ns-chip" data-bs-toggle="dropdown" aria-expanded="false" title="Cambiar de empresa">
                                        <span class="material-symbols-outlined" style="font-size:16px">domain</span>
                                        @(actualNombre ?? "Empresa")
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (empresaPrincipal is not null)
                                        {
                                            <li>
                                                <form asp-controller="Account" asp-action="CambiarEmpresa" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="empresaId" value="@empresaPrincipal.EmpresaId" />
                                                    <button type="submit" class="dropdown-item @(empresaActualId == empresaPrincipal.EmpresaId ? "active" : "")">
                                                        @empresaPrincipal.Nombre <span class="text-muted small">(principal)</span>
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                        @foreach (var e in misEmpresas)
                                        {
                                            <li>
                                                <form asp-controller="Account" asp-action="CambiarEmpresa" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="empresaId" value="@e.EmpresaId" />
                                                    <button type="submit" class="dropdown-item @(empresaActualId == e.EmpresaId ? "active" : "")">@e.Nombre</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    }
                    @await Component.InvokeAsync("AlertasBadge")
                    <div class="dropdown">
                        <button class="ns-icon-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L["MenuUsuario"]">
                            <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text small text-muted">@username</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Cambiar contraseña</a></li>
                            <li>
                                <span class="dropdown-item-text small text-muted">@L["Idioma"]</span>
                                <form asp-controller="Home" asp-action="CambiarIdioma" method="post" class="px-3 py-1 d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                    <button type="submit" name="cultura" value="es-SV" class="btn btn-sm @(idiomaActual.StartsWith("es") ? "btn-secondary" : "btn-outline-secondary")">ES</button>
                                    <button type="submit" name="cultura" value="en-US" class="btn btn-sm @(idiomaActual.StartsWith("en") ? "btn-secondary" : "btn-outline-secondary")">EN</button>
                                </form>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">@L["CerrarSesion"]</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main role="main" id="contenido-principal" tabindex="-1" class="ns-content">
                @RenderBody()
            </main>

            <footer class="ns-footer">
                <span>&copy; @DateTime.Now.Year NeoSTP — Plataforma SaaS DTE</span>
                <div class="d-flex gap-3">
                    <a href="/legal/terms">Términos</a>
                    <a href="/legal/privacy">Privacidad</a>
                    <a href="/legal/cookies">Cookies</a>
                    <a href="/legal/dpa">DPA</a>
                </div>
            </footer>
        </div>
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @if (isAuth)
    {
        <!-- Buscador global (Ctrl+K) -->
        <div class="modal fade" id="busquedaGlobalModal" tabindex="-1" aria-label="Buscador global">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body p-2">
                        <input type="search" id="busquedaGlobalInput" class="form-control form-control-lg border-0 shadow-none"
                               placeholder="Buscar clientes, productos o DTE…" autocomplete="off" />
                        <div id="busquedaGlobalResultados" class="list-group list-group-flush mt-1" style="max-height:50vh;overflow:auto"></div>
                    </div>
                </div>
            </div>
        </div>
        <script>
        // Menú lateral: conserva la posición de scroll entre navegaciones y,
        // si no hay posición guardada, lleva el módulo activo a la vista.
        (function () {
            var nav = document.querySelector('.ns-nav');
            if (!nav) return;
            var guardado = sessionStorage.getItem('ns-nav-scroll');
            if (guardado !== null) {
                nav.scrollTop = parseInt(guardado, 10) || 0;
            } else {
                var activo = nav.querySelector('.ns-nav-link.active');
                if (activo) activo.scrollIntoView({ block: 'center' });
            }
            window.addEventListener('beforeunload', function () {
                sessionStorage.setItem('ns-nav-scroll', String(nav.scrollTop));
            });
        })();
        (function () {
            var modalEl = document.getElementById('busquedaGlobalModal');
            var input = document.getElementById('busquedaGlobalInput');
            var lista = document.getElementById('busquedaGlobalResultados');
            var btn = document.getElementById('busquedaGlobalBtn');
            if (!modalEl || !input) return;
            var modal, timer;

            function abrir() {
                modal = modal || new bootstrap.Modal(modalEl);
                modal.show();
                setTimeout(function () { input.focus(); input.select(); }, 150);
            }
            if (btn) btn.addEventListener('click', abrir);
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); abrir(); }
            });

            function escapar(t) { var d = document.createElement('div'); d.textContent = t || ''; return d.innerHTML; }

            input.addEventListener('input', function () {
                clearTimeout(timer);
                var q = input.value.trim();
                if (q.length < 2) { lista.innerHTML = ''; return; }
                timer = setTimeout(function () {
                    fetch('@Url.Action("Global", "Busqueda")?q=' + encodeURIComponent(q))
                        .then(function (r) { return r.ok ? r.json() : []; })
                        .then(function (items) {
                            if (!items.length) {
                                lista.innerHTML = '<div class="list-group-item text-muted small">Sin resultados para "' + escapar(q) + '"</div>';
                                return;
                            }
                            var html = '', grupo = '';
                            items.forEach(function (i) {
                                if (i.grupo !== grupo) {
                                    grupo = i.grupo;
                                    html += '<div class="list-group-item py-1 small text-uppercase text-muted fw-semibold border-0">' + escapar(grupo) + '</div>';
                                }
                                html += '<a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="' + i.url + '">'
                                     + '<span class="material-symbols-outlined" style="font-size:18px" aria-hidden="true">' + escapar(i.icono) + '</span>'
                                     + '<span><strong>' + escapar(i.titulo) + '</strong><br/><small class="text-muted">' + escapar(i.detalle) + '</small></span></a>';
                            });
                            lista.innerHTML = html;
                        })
                        .catch(function () { lista.innerHTML = ''; });
                }, 250);
            });
        })();
        </script>
    }
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
