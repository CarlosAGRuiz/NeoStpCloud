@using NeoSTP.Application.Tesoreria.Dtos
@using NeoSTP.Web.Controllers
@model ConciliacionViewModel
@{
    ViewData["Title"] = "Conciliación bancaria";
    var cuentas = ViewBag.Cuentas as List<CuentaTesoreriaDto> ?? new List<CuentaTesoreriaDto>();
    var cuentaId = ViewBag.CuentaId as int?;
    var estado = ViewBag.Estado as string;
    var puedeGestionar = ViewBag.PuedeGestionar is bool pg && pg;
    var resumen = Model.Resumen;
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><a asp-controller="Tesoreria" asp-action="Index">Tesorería</a><span class="material-symbols-outlined">chevron_right</span><span>Conciliación</span></nav>
        <h1 class="ns-page-title">Conciliación bancaria</h1>
    </div>
    @if (puedeGestionar && cuentaId is int cidHead)
    {
        <form asp-action="ConciliarSugeridos" method="post" class="ns-toolbar">
            @Html.AntiForgeryToken()
            <input type="hidden" name="cuentaId" value="@cidHead" />
            <button type="submit" class="btn btn-outline-primary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">join_inner</span> Conciliar sugeridos</button>
        </form>
    }
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="card mb-3"><div class="card-body">
    <form asp-action="Conciliacion" method="get" class="row g-2 align-items-end" style="max-width:720px">
        <div class="col-md-5">
            <label class="form-label">Cuenta de tesorería</label>
            <select name="cuentaId" class="form-select" onchange="this.form.submit()">
                @foreach (var c in cuentas)
                {
                    <option value="@c.Id" selected="@(c.Id == cuentaId)">@c.Codigo — @c.Nombre (@c.TipoCuenta)</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(estado))">Todos</option>
                <option value="NO_CONCILIADO" selected="@(estado == "NO_CONCILIADO")">Pendientes</option>
                <option value="PARCIAL" selected="@(estado == "PARCIAL")">Parciales</option>
                <option value="CONCILIADO" selected="@(estado == "CONCILIADO")">Conciliados</option>
            </select>
        </div>
    </form>
    @if (puedeGestionar && cuentaId is int cidImp)
    {
        <hr />
        <form asp-action="ImportarEstadoCuenta" method="post" enctype="multipart/form-data" class="row g-2 align-items-end" style="max-width:720px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="cuentaId" value="@cidImp" />
            <div class="col-md-7">
                <label class="form-label">Estado de cuenta del banco (CSV o Excel)</label>
                <input type="file" name="archivo" class="form-control" accept=".csv,.xlsx" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined align-middle" style="font-size:18px">upload_file</span> Importar</button>
            </div>
            <div class="col-12 form-text">
                Columnas: <code>fecha</code> (requerida), <code>monto</code> con signo o <code>cargo</code>/<code>abono</code>, <code>descripcion</code>, <code>referencia</code>. Las filas repetidas se omiten.
            </div>
        </form>
    }
</div></div>

@if (cuentaId is null)
{
    <div class="ns-empty"><span class="material-symbols-outlined">account_balance</span><p>Crea primero una cuenta de tesorería para conciliar su estado de cuenta.</p></div>
}
else
{
    if (resumen is not null)
    {
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3"><div class="card"><div class="card-body py-2"><div class="ns-metric-label">Líneas del banco</div><div class="fs-4 ns-mono">@resumen.TotalBanco</div></div></div></div>
            <div class="col-6 col-md-3"><div class="card"><div class="card-body py-2"><div class="ns-metric-label">Conciliadas</div><div class="fs-4 ns-mono text-success">@resumen.Conciliados @(resumen.Parciales > 0 ? $"(+{resumen.Parciales} parciales)" : "")</div></div></div></div>
            <div class="col-6 col-md-3"><div class="card"><div class="card-body py-2"><div class="ns-metric-label">Pendientes</div><div class="fs-4 ns-mono @(resumen.NoConciliados > 0 ? "text-warning" : "")">@resumen.NoConciliados <small class="text-muted fs-6">($@resumen.MontoNoConciliado.ToString("N2"))</small></div></div></div></div>
            <div class="col-6 col-md-3"><div class="card"><div class="card-body py-2"><div class="ns-metric-label">Internos sin conciliar</div><div class="fs-4 ns-mono">@resumen.InternosSinConciliar</div></div></div></div>
        </div>
    }

    var items = Model.Movimientos?.Items ?? new List<MovimientoBancarioDto>();
    if (items.Count == 0)
    {
        <div class="ns-empty"><span class="material-symbols-outlined">receipt_long</span><p>No hay líneas bancarias @(estado == "CONCILIADO" ? "conciliadas" : estado == "NO_CONCILIADO" ? "pendientes" : "importadas") en esta cuenta.</p></div>
    }
    else
    {
        <div class="card"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr>
                <th>Fecha</th><th>Referencia</th><th>Descripción</th><th class="text-end">Monto</th>
                <th>Estado</th><th>Sugerencia / conciliado con</th>
                @if (puedeGestionar) { <th class="text-end">Acciones</th> }
            </tr></thead>
            <tbody>
            @foreach (var m in items)
            {
                Model.Sugerencias.TryGetValue(m.Id, out var sug);
                <tr>
                    <td class="ns-mono">@m.Fecha.ToString("dd/MM/yyyy")</td>
                    <td class="ns-mono">@(m.Referencia ?? "—")</td>
                    <td>@m.Descripcion</td>
                    <td class="text-end ns-mono @(m.Monto < 0 ? "text-danger" : "text-success")">@m.Monto.ToString("N2")</td>
                    <td>
                        @if (m.EstadoCodigo == "CONCILIADO") { <span class="ns-badge ns-badge--processed">Conciliado</span> }
                        else if (m.EstadoCodigo == "PARCIAL") { <span class="ns-badge ns-badge--draft">Parcial $@m.MontoConciliado.ToString("N2") / $@Math.Abs(m.Monto).ToString("N2")</span> }
                        else { <span class="ns-badge ns-badge--draft">Pendiente</span> }
                    </td>
                    <td>
                        @if (m.Detalles.Count > 0)
                        {
                            foreach (var d in m.Detalles)
                            {
                                <small class="d-block">#@d.MovimientoTesoreriaId @d.MovimientoTesoreriaConcepto ($@d.Monto.ToString("N2"))
                                @if (puedeGestionar)
                                {
                                    <form asp-action="QuitarDetalle" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <input type="hidden" name="movimientoTesoreriaId" value="@d.MovimientoTesoreriaId" />
                                        <input type="hidden" name="cuentaId" value="@cuentaId" />
                                        <button type="submit" class="btn btn-link btn-sm p-0 align-baseline" title="Quitar este movimiento"><span class="material-symbols-outlined" style="font-size:14px">close</span></button>
                                    </form>
                                }
                                </small>
                            }
                            if (m.EstadoCodigo == "CONCILIADO") { <small class="text-muted">por @m.ConciliadoPor</small> }
                        }
                        else if (sug is not null)
                        {
                            <small>@(sug.CombinacionIds.Count > 1 ? "Combinación: " : $"#{sug.MovimientoTesoreriaId} ")@sug.MovimientoTesoreriaConcepto (@sug.MovimientoTesoreriaFecha.ToString("dd/MM"))
                                <span class="ns-badge @(sug.Confianza == "ALTA" ? "ns-badge--processed" : "ns-badge--draft")">@sug.Confianza</span>
                            </small>
                        }
                        else { <small class="text-muted">Sin candidato (monto/fecha)</small> }
                    </td>
                    @if (puedeGestionar)
                    {
                        <td class="text-end">
                            @if (m.EstadoCodigo != "NO_CONCILIADO")
                            {
                                <form asp-action="Desconciliar" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <input type="hidden" name="cuentaId" value="@cuentaId" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Desconciliar todo"><span class="material-symbols-outlined" style="font-size:18px">link_off</span></button>
                                </form>
                            }
                            else if (sug is not null && sug.CombinacionIds.Count > 1)
                            {
                                <form asp-action="ConciliarCombinacion" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <input type="hidden" name="cuentaId" value="@cuentaId" />
                                    @foreach (var cid in sug.CombinacionIds)
                                    {
                                        <input type="hidden" name="movimientoTesoreriaIds" value="@cid" />
                                    }
                                    <button type="submit" class="btn btn-outline-primary btn-sm" title="Conciliar la combinación sugerida"><span class="material-symbols-outlined" style="font-size:18px">join_inner</span></button>
                                </form>
                            }
                            else if (sug is not null)
                            {
                                <form asp-action="Conciliar" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <input type="hidden" name="movimientoTesoreriaId" value="@sug.MovimientoTesoreriaId" />
                                    <input type="hidden" name="cuentaId" value="@cuentaId" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm" title="Conciliar con la sugerencia"><span class="material-symbols-outlined" style="font-size:18px">link</span></button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
        </div></div>

        var paged = Model.Movimientos!;
        if (paged.TotalPages > 1)
        {
            <nav class="mt-3"><ul class="pagination pagination-sm">
                @for (var p = 1; p <= paged.TotalPages; p++)
                {
                    <li class="page-item @(p == paged.Page ? "active" : "")">
                        <a class="page-link" asp-action="Conciliacion" asp-route-cuentaId="@cuentaId" asp-route-estado="@estado" asp-route-page="@p">@p</a>
                    </li>
                }
            </ul></nav>
        }
    }
}
