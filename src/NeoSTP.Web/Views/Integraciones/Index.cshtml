@model NeoSTP.Web.Controllers.IntegracionesViewModel
@{
    ViewData["Title"] = "NeoConnect — Integraciones";
    var admKeys = Model.PuedeAdministrarKeys;
    var admWh = Model.PuedeAdministrarWebhooks;
    var rawKey = TempData["RawKey"] as string;
    var rawKeyNombre = TempData["RawKeyNombre"] as string;
}

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

@if (!string.IsNullOrEmpty(rawKey))
{
    <div class="card mb-4" style="border-left:4px solid var(--ns-secondary)">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="material-symbols-outlined" style="color:var(--ns-secondary)">key</span>
                <strong>API Key «@rawKeyNombre» creada</strong>
            </div>
            <p class="text-muted small mb-2">Cópiala ahora. Por seguridad <strong>no se volverá a mostrar</strong>; solo se guarda su hash.</p>
            <div class="input-group">
                <input id="rawKeyInput" class="form-control ns-mono" value="@rawKey" readonly />
                <button class="btn btn-primary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('rawKeyInput').value); this.textContent='Copiado ✓';">Copiar</button>
            </div>
        </div>
    </div>
}

<!-- ===== Consumo por API Key ===== -->
@if (Model.Usage.Any())
{
    <div class="row g-3 mb-4">
        @foreach (var u in Model.Usage)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="material-symbols-outlined" style="font-size:18px;color:var(--ns-secondary)">key</span>
                            <strong>@u.ApiKeyNombre</strong>
                        </div>
                        <div class="d-flex justify-content-between text-center">
                            <div><div class="ns-mono fw-bold fs-5">@u.PeticionesHoy</div><div class="ns-metric-label">Hoy</div></div>
                            <div><div class="ns-mono fw-bold fs-5">@u.PeticionesUltimos7Dias</div><div class="ns-metric-label">7 días</div></div>
                            <div><div class="ns-mono fw-bold fs-5">@u.TotalPeticiones</div><div class="ns-metric-label">Total</div></div>
                        </div>
                        <div class="text-muted small mt-3">
                            Webhooks: <span class="ns-badge ns-badge--processed">@u.WebhooksEntregados ✓</span>
                            @if (u.WebhooksFallidos > 0) { <span class="ns-badge ns-badge--rejected">@u.WebhooksFallidos ✕</span> }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ===== API Keys ===== -->
<div class="card mb-4">
    <div class="card-header"><span class="material-symbols-outlined align-middle">vpn_key</span> API Keys</div>
    @if (admKeys)
    {
        <div class="card-body border-bottom">
            <form asp-action="CrearApiKey" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label small">Nombre descriptivo</label>
                    <input name="nombre" class="form-control form-control-sm" placeholder="ERP producción" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small">Scopes (permisos de la key)</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var s in Model.ScopesDisponibles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="scopes" value="@s" id="scope_@s" />
                                <label class="form-check-label ns-mono small" for="scope_@s">@s</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-2"><button class="btn btn-primary btn-sm w-100" type="submit">Generar key</button></div>
            </form>
        </div>
    }
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead><tr><th>Nombre</th><th>Prefijo</th><th>Scopes</th><th>Estado</th><th>Último uso</th><th>Creada</th>@if (admKeys){<th class="text-end">Acciones</th>}</tr></thead>
            <tbody>
                @if (!Model.ApiKeys.Any())
                {
                    <tr><td colspan="@(admKeys ? 7 : 6)"><div class="ns-empty"><span class="material-symbols-outlined">vpn_key</span><p>Sin API Keys. Crea una para conectar sistemas externos.</p></div></td></tr>
                }
                @foreach (var k in Model.ApiKeys)
                {
                    <tr>
                        <td><strong>@k.Nombre</strong></td>
                        <td><code class="ns-mono">@k.Prefix…</code></td>
                        <td>@foreach (var s in k.Scopes){<span class="badge bg-light text-dark border ns-mono me-1">@s</span>}</td>
                        <td>
                            @if (k.Activo){<span class="ns-pill ns-pill--on">Activa</span>}
                            else {<span class="ns-pill ns-pill--off">Revocada</span>}
                        </td>
                        <td><small class="text-muted ns-mono">@(k.UltimoUsoAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</small></td>
                        <td><small class="text-muted ns-mono">@k.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</small></td>
                        @if (admKeys)
                        {
                            <td class="text-end">
                                @if (k.Activo)
                                {
                                    <form asp-action="RevocarApiKey" method="post" class="d-inline" onsubmit="return confirm('¿Revocar esta API Key? Es irreversible.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@k.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Revocar</button>
                                    </form>
                                }
                                else { <span class="text-muted small">@k.RevokedAt?.ToLocalTime().ToString("yyyy-MM-dd")</span> }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===== Webhooks ===== -->
<div class="card mb-4">
    <div class="card-header"><span class="material-symbols-outlined align-middle">webhook</span> Webhooks</div>
    @if (admWh)
    {
        <div class="card-body border-bottom">
            <form asp-action="CrearWebhook" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-5">
                    <label class="form-label small">URL del endpoint</label>
                    <input name="url" type="url" class="form-control form-control-sm" placeholder="https://tu-sistema.com/webhooks/neostp" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label small">Eventos suscritos</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var e in Model.EventosDisponibles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="eventos" value="@e" id="evt_@e" />
                                <label class="form-check-label ns-mono small" for="evt_@e">@e</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-2"><button class="btn btn-primary btn-sm w-100" type="submit">Crear webhook</button></div>
            </form>
        </div>
    }
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead><tr><th>URL</th><th>Eventos</th><th>Secreto HMAC</th><th>Estado</th><th>Última entrega</th>@if (admWh){<th class="text-end">Acciones</th>}</tr></thead>
            <tbody>
                @if (!Model.Webhooks.Any())
                {
                    <tr><td colspan="@(admWh ? 6 : 5)"><div class="ns-empty"><span class="material-symbols-outlined">webhook</span><p>Sin webhooks configurados.</p></div></td></tr>
                }
                @foreach (var w in Model.Webhooks)
                {
                    <tr>
                        <td><code class="ns-mono small">@w.Url</code></td>
                        <td>@foreach (var e in w.Eventos){<span class="badge bg-light text-dark border ns-mono me-1">@e</span>}</td>
                        <td><code class="ns-mono small text-muted">@w.SecretoHmacDisplay</code></td>
                        <td>@if (w.Activo){<span class="ns-pill ns-pill--on">Activo</span>}else{<span class="ns-pill ns-pill--off">Inactivo</span>}</td>
                        <td><small class="text-muted ns-mono">@(w.UltimaEntregaAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</small></td>
                        @if (admWh)
                        {
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <form asp-action="TestWebhook" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@w.Id" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">Probar</button>
                                    </form>
                                    <form asp-action="EliminarWebhook" method="post" class="m-0" onsubmit="return confirm('¿Eliminar webhook?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@w.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===== Logs de entregas ===== -->
<div class="card mb-4">
    <div class="card-header"><span class="material-symbols-outlined align-middle">history</span> Entregas recientes</div>
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead><tr><th>#</th><th>Evento</th><th>Estado</th><th>HTTP</th><th>Intentos</th><th>Entregado</th><th>Error</th></tr></thead>
            <tbody>
                @if (!Model.Deliveries.Any())
                {
                    <tr><td colspan="7"><div class="ns-empty"><span class="material-symbols-outlined">history</span><p>Sin entregas registradas.</p></div></td></tr>
                }
                @foreach (var d in Model.Deliveries)
                {
                    var badge = d.Estado switch { "ENTREGADO" => "ns-badge--processed", "FALLIDO" => "ns-badge--rejected", _ => "ns-badge--contingency" };
                    <tr>
                        <td class="ns-mono">@d.Id</td>
                        <td><span class="ns-mono small">@d.Evento</span></td>
                        <td><span class="ns-badge @badge">@d.Estado</span></td>
                        <td class="ns-mono">@(d.HttpStatus?.ToString() ?? "—")</td>
                        <td class="ns-mono">@d.Intentos</td>
                        <td><small class="text-muted ns-mono">@(d.EntregadoAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</small></td>
                        <td><small class="text-danger">@(d.Error is { Length: > 0 } ? (d.Error.Length > 60 ? d.Error[..60] + "…" : d.Error) : "")</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
