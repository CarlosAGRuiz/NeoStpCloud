@model NeoSTP.Application.Common.PagedResult<NeoSTP.Application.Productos.Dtos.ProductoDto>
@{
    ViewData["Title"] = "Productos";
    var search = ViewBag.Search as string;
}

@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="ns-toolbar">
    <form method="get" class="ns-toolbar-search">
        <input name="search" value="@search" class="form-control form-control-sm" style="min-width:280px" placeholder="Buscar código, nombre o barra…" />
        <button type="submit" class="btn btn-outline-secondary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">search</span> Buscar
        </button>
    </form>
    <div class="d-flex gap-2">
        <a asp-action="Importar" class="btn btn-outline-secondary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">upload_file</span> Carga masiva
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">add</span> Nuevo producto
        </a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>UM</th>
                    <th class="text-end">Precio</th>
                    <th>IVA</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model is null || !Model.Items.Any())
                {
                    <tr><td colspan="8"><div class="ns-empty"><span class="material-symbols-outlined">inventory_2</span><p>Sin productos registrados.</p></div></td></tr>
                }
                @foreach (var p in Model?.Items ?? Array.Empty<NeoSTP.Application.Productos.Dtos.ProductoDto>())
                {
                    var badge = p.EstadoCodigo == "ACTIVO" ? "ns-pill ns-pill--on" : "ns-pill ns-pill--off";
                    var tipoBadge = p.EsServicio ? "bg-warning text-dark" : "bg-info";
                    <tr>
                        <td><strong>@p.CodigoInterno</strong>@(p.CodigoBarra is null ? "" : $" / {p.CodigoBarra}")</td>
                        <td>@p.Nombre<br /><small class="text-muted">@p.Descripcion</small></td>
                        <td><span class="badge @tipoBadge">@p.TipoItem</span></td>
                        <td><small>@p.UnidadMedidaCodigo</small></td>
                        <td class="text-end">@p.PrecioUnitario.ToString("N4")</td>
                        <td>@(p.AplicaIva ? "✓" : "—")</td>
                        <td><span class="@badge">@p.EstadoCodigo</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (p.EstadoCodigo == "ACTIVO")
                            {
                                <form asp-action="Inactivar" asp-route-id="@p.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Inactivar este producto?');">Inactivar</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Restaurar" asp-route-id="@p.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-success" onclick="return confirm('¿Restaurar (reactivar) este producto?');">Restaurar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model is not null && Model.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search">@i</a>
            </li>
        }
    </ul></nav>
}

<p class="text-muted small mt-2">Total: @(Model?.Total ?? 0) productos.</p>
