@model NeoSTP.Web.Models.CreateProductoViewModel
@{ ViewData["Title"] = "Nuevo producto"; }

<form asp-action="Create" method="post" style="max-width: 960px;">
    <div class="ns-page-head">
        <div>
            <nav class="ns-breadcrumb"><a asp-action="Index">Productos</a><span class="material-symbols-outlined">chevron_right</span><span>Nuevo</span></nav>
            <h1 class="ns-page-title">Nuevo producto / servicio</h1>
        </div>
        <div class="ns-page-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Crear</button>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">inventory_2</span><h2>Datos del producto</h2></div>
        <div class="ns-formsection-body">
            <partial name="_Form" model="Model" />
        </div>
    </div>
</form>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
