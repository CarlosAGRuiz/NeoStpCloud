@model NeoSTP.Application.Productos.Dtos.ProductoPreciosDto
@{
    var producto = (NeoSTP.Application.Productos.Dtos.ProductoDto)ViewBag.Producto;
    ViewData["Title"] = $"Precios de {producto.CodigoInterno}";
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-action="Index">Productos</a><span class="material-symbols-outlined">chevron_right</span><span>Precios</span></nav>
        <h1 class="ns-page-title">Precios por volumen — @producto.Nombre</h1>
        <p class="ns-page-subtitle">Precio base: <span class="ns-mono">$@Model.PrecioBase.ToString("N4")</span> por @producto.UnidadMedidaCodigo. Las escalas aplican solas en el POS al cambiar la cantidad.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Volver</a>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<form asp-action="Precios" asp-route-id="@Model.ProductoId" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card ns-data-card h-100">
                <div class="card-body">
                    <h2 class="h6">Escalas de precio por cantidad</h2>
                    <p class="text-muted small">Desde X unidades, el precio unitario baja a Y.</p>
                    <table class="table table-sm align-middle" id="escalasTable">
                        <thead><tr><th>Desde (cantidad)</th><th>Precio unitario</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Escalas.Count; i++)
                            {
                                <tr>
                                    <td><input name="Escalas[@i].CantidadMinima" type="number" step="0.01" min="0.01" value="@Model.Escalas[i].CantidadMinima.ToString("0.##")" class="form-control form-control-sm ns-mono" required /></td>
                                    <td><input name="Escalas[@i].PrecioUnitario" type="number" step="0.0001" min="0" value="@Model.Escalas[i].PrecioUnitario.ToString("0.00##")" class="form-control form-control-sm ns-mono" required /></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove(); reindex();">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow('escalasTable', ['Escalas', 'CantidadMinima', 'PrecioUnitario'])">+ Agregar escala</button>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card ns-data-card h-100">
                <div class="card-body">
                    <h2 class="h6">Unidades alternativas</h2>
                    <p class="text-muted small">Docena, caja, fardo… con factor de conversión y precio propio opcional.</p>
                    <table class="table table-sm align-middle" id="unidadesTable">
                        <thead><tr><th>Código UM</th><th>Nombre</th><th>Factor</th><th>Precio (opc.)</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Unidades.Count; i++)
                            {
                                <tr>
                                    <td><input name="Unidades[@i].UnidadMedidaCodigo" value="@Model.Unidades[i].UnidadMedidaCodigo" maxlength="20" class="form-control form-control-sm" required /></td>
                                    <td><input name="Unidades[@i].Nombre" value="@Model.Unidades[i].Nombre" maxlength="60" class="form-control form-control-sm" required /></td>
                                    <td><input name="Unidades[@i].Factor" type="number" step="0.01" min="0.01" value="@Model.Unidades[i].Factor.ToString("0.##")" class="form-control form-control-sm ns-mono" required /></td>
                                    <td><input name="Unidades[@i].PrecioUnitario" type="number" step="0.0001" min="0" value="@(Model.Unidades[i].PrecioUnitario?.ToString("0.00##"))" class="form-control form-control-sm ns-mono" /></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove(); reindex();">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow('unidadesTable', ['Unidades', 'UnidadMedidaCodigo', 'Nombre', 'Factor', 'PrecioUnitario'])">+ Agregar unidad</button>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar precios</button>
    </div>
</form>

<script>
    // Filas dinámicas: clona la estructura de columnas y reindexa los names para el model binding.
    function addRow(tableId, spec) {
        const prefijo = spec[0], campos = spec.slice(1);
        const tbody = document.querySelector('#' + tableId + ' tbody');
        const tr = document.createElement('tr');
        tr.innerHTML = campos.map(c => {
            const esNumero = c !== 'UnidadMedidaCodigo' && c !== 'Nombre';
            return `<td><input name="${prefijo}[0].${c}" ${esNumero ? 'type="number" step="0.0001" min="0"' : 'maxlength="60"'} class="form-control form-control-sm" /></td>`;
        }).join('') + '<td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest(\'tr\').remove(); reindex();">✕</button></td>';
        tbody.appendChild(tr);
        reindex();
    }
    function reindex() {
        for (const tableId of ['escalasTable', 'unidadesTable']) {
            document.querySelectorAll('#' + tableId + ' tbody tr').forEach((tr, i) => {
                tr.querySelectorAll('input[name]').forEach(inp => {
                    inp.name = inp.name.replace(/\[\d+\]/, '[' + i + ']');
                });
            });
        }
    }
</script>
