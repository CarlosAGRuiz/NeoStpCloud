@model NeoSTP.Application.Dte.Eventos.Dtos.CrearEventoOperacionesEspecialesRequest
@{
    ViewData["Title"] = "Operaciones especiales";
}

<form method="post" style="max-width: 920px;">
    @Html.AntiForgeryToken()
    <input asp-for="CertificacionEscenarioId" type="hidden" />
    <input asp-for="CertificacionTipoCodigo" type="hidden" />
    <input asp-for="CertificacionEscenarioCodigo" type="hidden" />
    <input asp-for="CertificacionEscenarioNombre" type="hidden" />

    <div class="ns-page-head">
        <div>
            <nav class="ns-breadcrumb"><a asp-action="Index">Eventos DTE</a><span class="material-symbols-outlined">chevron_right</span><span>Operaciones especiales</span></nav>
            <h1 class="ns-page-title">Operaciones especiales</h1>
        </div>
        <div class="ns-page-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-secondary">Transmitir operación especial</button>
        </div>
    </div>
    <p class="text-muted small">Reporta operaciones que no se documentaron como DTE (Factura Simplificada / Control Interno). Esquema <code>fe-eop</code>, <code>tipoEvento=17</code>, <code>tipoDocumento=97</code>. Requiere que la cuenta esté autorizada por Hacienda para emisión simplificada.</p>

    <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
    @if (Model.CertificacionEscenarioId.HasValue)
    {
        <div class="alert alert-info small">
            Prueba de certificacion <strong>@Model.CertificacionEscenarioCodigo</strong>:
            @Model.CertificacionEscenarioNombre. Al transmitir, el evento se asociara a la matriz.
        </div>
    }

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">settings</span><h2>Datos de la operación</h2></div>
        <div class="ns-formsection-body">
            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label class="form-label">Descripción de la operación</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2" required placeholder="Ej. Ventas de Control Interno período enero-febrero"></textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Monto total</label>
                    <input asp-for="Monto" type="number" step="0.01" min="0.01" class="form-control" required placeholder="0.00" />
                    <small class="text-muted">USD. El IVA 13% se calcula automático.</small>
                </div>
            </div>

            <div class="mb-1">
                <label class="form-label">Código de generación de referencia (opcional)</label>
                <input asp-for="CodigoGeneracionRef" class="form-control ns-mono" placeholder="UUID de un EOE previo si corresponde" />
            </div>
        </div>
    </div>
</form>
