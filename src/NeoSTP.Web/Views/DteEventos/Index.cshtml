@model IReadOnlyList<NeoSTP.Application.Dte.Eventos.Dtos.DteEventoListDto>
@{
    ViewData["Title"] = "Eventos DTE";
    var tipo = ViewBag.Tipo as string;
    var estado = ViewBag.Estado as string;
}

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">@ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">@err <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="ns-toolbar">
    <form method="get" class="ns-toolbar-search">
        <select name="tipo" class="form-select form-select-sm" style="width:auto">
            <option value="">Todos los tipos</option>
            <option value="INVALIDACION" selected="@(tipo == "INVALIDACION")">Invalidación</option>
            <option value="CONTINGENCIA" selected="@(tipo == "CONTINGENCIA")">Contingencia</option>
            <option value="RETORNO" selected="@(tipo == "RETORNO")">Retorno</option>
            <option value="OPERACIONES_ESPECIALES" selected="@(tipo == "OPERACIONES_ESPECIALES")">Operaciones Especiales</option>
        </select>
        <select name="estado" class="form-select form-select-sm" style="width:auto">
            <option value="">Todos los estados</option>
            <option value="PROCESADO" selected="@(estado == "PROCESADO")">Procesado</option>
            <option value="ENVIADO" selected="@(estado == "ENVIADO")">Enviado</option>
            <option value="FIRMADO" selected="@(estado == "FIRMADO")">Firmado</option>
            <option value="RECHAZADO" selected="@(estado == "RECHAZADO")">Rechazado</option>
            <option value="ERROR" selected="@(estado == "ERROR")">Error</option>
            <option value="BORRADOR" selected="@(estado == "BORRADOR")">Borrador</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">filter_list</span> Filtrar
        </button>
        @if (!string.IsNullOrEmpty(tipo) || !string.IsNullOrEmpty(estado))
        {
            <a asp-action="Index" class="btn btn-link btn-sm">Limpiar</a>
        }
    </form>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="CreateInvalidacion" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:18px">block</span> Invalidar</a>
        <a asp-action="CreateContingencia" class="btn btn-outline-warning btn-sm d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:18px">bolt</span> Contingencia</a>
        <a asp-action="CreateRetorno" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:18px">undo</span> Retorno</a>
        <a asp-action="CreateOperacionesEspeciales" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:18px">settings</span> Op. Especiales</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover m-0 align-middle">
            <thead>
            <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Código de generación</th>
                <th class="text-center">Ambiente</th>
                <th class="text-center">DTE rel.</th>
                <th class="text-center">Estado</th>
                <th>Sello</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model)
        {
            string badge = e.EstadoCodigo switch
            {
                "PROCESADO" => "ns-badge ns-badge--processed",
                "ENVIADO" or "FIRMADO" => "ns-badge ns-badge--draft",
                "RECHAZADO" or "ERROR" => "ns-badge ns-badge--rejected",
                _ => "ns-badge ns-badge--draft"
            };
            <tr>
                <td><small>@e.FechaTransmision.ToString("dd/MM/yyyy HH:mm")</small></td>
                <td><span class="ns-badge ns-badge--draft">@e.TipoEventoCodigo</span></td>
                <td><code class="small ns-mono">@e.CodigoGeneracion</code></td>
                <td class="text-center"><small>@e.AmbienteCodigo</small></td>
                <td class="text-center">@e.DocumentosRelacionados</td>
                <td class="text-center"><span class="@badge">@e.EstadoCodigo</span></td>
                <td>
                    @if (!string.IsNullOrEmpty(e.SelloRecibido))
                    {
                        <small class="ns-mono" style="color:var(--ns-processed)">@e.SelloRecibido.Substring(0, Math.Min(14, e.SelloRecibido.Length))…</small>
                    }
                    else
                    {
                        <small class="text-muted">—</small>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-outline-primary btn-sm">Ver</a>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="8"><div class="ns-empty"><span class="material-symbols-outlined">event_note</span><p>Sin eventos registrados.</p></div></td></tr>
        }
        </tbody>
    </table>
    </div>
</div>
