@model NeoSTP.Application.Dte.Eventos.Dtos.CrearEventoInvalidacionRequest
@{
    ViewData["Title"] = "Invalidar DTE";
    var dtes = (ViewBag.Dtes as IReadOnlyList<NeoSTP.Application.Dte.Dtos.DteDocumentoListItemDto>) ?? new List<NeoSTP.Application.Dte.Dtos.DteDocumentoListItemDto>();
}

<form method="post" style="max-width: 920px;">
    @Html.AntiForgeryToken()
    <input asp-for="CertificacionEscenarioId" type="hidden" />
    <input asp-for="CertificacionTipoCodigo" type="hidden" />
    <input asp-for="CertificacionEscenarioCodigo" type="hidden" />
    <input asp-for="CertificacionEscenarioNombre" type="hidden" />

    <div class="ns-page-head">
        <div>
            <nav class="ns-breadcrumb"><a asp-action="Index">Eventos DTE</a><span class="material-symbols-outlined">chevron_right</span><span>Invalidar</span></nav>
            <h1 class="ns-page-title">Invalidar DTE</h1>
        </div>
        <div class="ns-page-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-danger">Transmitir invalidación</button>
        </div>
    </div>
    <p class="text-muted small">Sólo aplica a documentos <strong>PROCESADO</strong> con sello de Hacienda. CAT-024 define los motivos oficiales.</p>

    <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
    @if (Model.CertificacionEscenarioId.HasValue)
    {
        <div class="alert alert-info small">
            Prueba de certificacion <strong>@Model.CertificacionEscenarioCodigo</strong>:
            @Model.CertificacionEscenarioNombre. Al transmitir, el evento se asociara a la matriz.
        </div>
    }

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">block</span><h2>Datos de la invalidación</h2></div>
        <div class="ns-formsection-body">
            <div class="mb-3">
                <label class="form-label">DTE a invalidar</label>
                <select asp-for="DocumentoId" class="form-select" required>
                    <option value="">— Seleccionar DTE PROCESADO —</option>
                    @foreach (var d in dtes)
                    {
                        <option value="@d.Id" selected="@(Model.DocumentoId == d.Id)">[@d.TipoDteCodigo] @d.NumeroControl · @d.FechaEmision.ToString("dd/MM/yyyy") · @d.ReceptorNombre · $@d.TotalPagar.ToString("0.00")</option>
                    }
                </select>
                @if (dtes.Count == 0)
                {
                    <small class="text-warning">No hay DTE PROCESADO disponibles para invalidar.</small>
                }
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Tipo de anulación</label>
                    <select asp-for="TipoAnulacion" class="form-select">
                        <option value="1">1 — Rescindir + reemplazo</option>
                        <option value="2" selected>2 — Rescindir de la operación</option>
                        <option value="3">3 — Error en información + reemplazo</option>
                    </select>
                    <small class="text-muted">Tipo 1 y 3 requieren código de generación del reemplazo.</small>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Código de generación del reemplazo (si tipo 1 ó 3)</label>
                    <input asp-for="CodigoGeneracionReemplazo" class="form-control ns-mono" placeholder="UUID en mayúsculas" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Motivo de anulación</label>
                <textarea asp-for="MotivoAnulacion" class="form-control" rows="2" placeholder="Detalle del motivo (CAT-024)"></textarea>
            </div>

            <h6 class="mt-2">Responsable de la anulación</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre del responsable</label>
                    <input asp-for="NombreResponsable" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tipo doc.</label>
                    <select asp-for="TipoDocResponsable" class="form-select">
                        <option value="13">13 — DUI</option>
                        <option value="36">36 — NIT</option>
                        <option value="03">03 — Pasaporte</option>
                        <option value="02">02 — Carnet de Residente</option>
                        <option value="37">37 — Otro</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Número de documento</label>
                    <input asp-for="NumDocResponsable" class="form-control" required />
                </div>
            </div>
        </div>
    </div>
</form>
