@model NeoSTP.Web.Models.CreateClienteViewModel
@{
    var tiposDoc = (ViewBag.TiposDoc as IEnumerable<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>) ?? Array.Empty<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>();
    var tiposContrib = (ViewBag.TiposContrib as IEnumerable<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>) ?? Array.Empty<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>();
    var departamentos = (ViewBag.Departamentos as IEnumerable<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>) ?? Array.Empty<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>();
    var municipios = (ViewBag.Municipios as IEnumerable<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>) ?? Array.Empty<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>();
    var distritos = (ViewBag.Distritos as IEnumerable<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>) ?? Array.Empty<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>();
    var paises = (ViewBag.Paises as IEnumerable<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>) ?? Array.Empty<NeoSTP.Application.Catalogos.Dtos.CatalogoItemDto>();
    var esExtranjero = NeoSTP.Application.Clientes.ClienteValidator.EsExtranjero(Model.PaisCodigo);
}

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="PaisCodigo" class="form-label"></label>
        <select asp-for="PaisCodigo" id="paisSelect" class="form-select">
            <option value="">El Salvador (predeterminado)</option>
            @foreach (var p in paises)
            {
                <option value="@p.Codigo" selected="@(p.Codigo == Model.PaisCodigo)">@p.Valor</option>
            }
        </select>
        <div class="form-text" id="paisHint" style="display:none">
            Cliente extranjero: el documento es opcional y podrá facturarse como exportación sin recapturar datos.
        </div>
    </div>
    <div class="col-md-4">
        <label asp-for="TipoPersona" class="form-label"></label>
        <select asp-for="TipoPersona" class="form-select">
            <option value="">—</option>
            <option value="1" selected="@(Model.TipoPersona == 1)">Persona natural</option>
            <option value="2" selected="@(Model.TipoPersona == 2)">Persona jurídica</option>
        </select>
        <div class="form-text">Usado en la factura de exportación.</div>
    </div>
    <div class="col-md-4"></div>

    <div class="col-md-4">
        <label asp-for="TipoDocumentoCodigo" class="form-label"></label>
        <select asp-for="TipoDocumentoCodigo" class="form-select">
            @foreach (var t in tiposDoc)
            {
                <option value="@t.Codigo" selected="@(t.Codigo == Model.TipoDocumentoCodigo)">@t.Valor</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="NumeroDocumento" class="form-label"></label>
        <input asp-for="NumeroDocumento" id="numeroDocumentoInput" class="form-control" placeholder="DUI: 12345678-9 / NIT: 0614-010100-101-1" />
        <span asp-validation-for="NumeroDocumento" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Nrc" class="form-label"></label>
        <input asp-for="Nrc" class="form-control" placeholder="1234567" />
    </div>

    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="NombreComercial" class="form-label"></label>
        <input asp-for="NombreComercial" class="form-control" />
    </div>

    <div class="col-md-4">
        <label asp-for="TipoContribuyenteCodigo" class="form-label"></label>
        <select asp-for="TipoContribuyenteCodigo" class="form-select">
            @foreach (var t in tiposContrib)
            {
                <option value="@t.Codigo" selected="@(t.Codigo == Model.TipoContribuyenteCodigo)">@t.Valor</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="CodigoActividad" class="form-label"></label>
        <input asp-for="CodigoActividad" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="ActividadEconomica" class="form-label"></label>
        <input asp-for="ActividadEconomica" class="form-control" />
    </div>

    <div class="col-md-4 territorio-sv @(esExtranjero ? "d-none" : null)">
        <label asp-for="DepartamentoCodigo" class="form-label"></label>
        <select asp-for="DepartamentoCodigo" id="departamentoSelect" class="form-select">
            <option value="">—</option>
            @foreach (var d in departamentos)
            {
                <option value="@d.Codigo" selected="@(d.Codigo == Model.DepartamentoCodigo)">@d.Valor</option>
            }
        </select>
    </div>
    <div class="col-md-4 territorio-sv @(esExtranjero ? "d-none" : null)">
        <label asp-for="MunicipioCodigo" class="form-label">Municipio / Zona</label>
        <select asp-for="MunicipioCodigo" id="municipioSelect" class="form-select" data-current="@Model.MunicipioCodigo">
            <option value="">— Selecciona un departamento</option>
            @foreach (var m in municipios)
            {
                <option value="@m.Codigo"
                        data-depto="@NeoSTP.Web.Models.ClienteTerritorialUi.DepartamentoDe(m)"
                        selected="@(m.Codigo == Model.MunicipioCodigo)"
                        style="display:none">@m.Valor</option>
            }
        </select>
    </div>
    <div class="col-md-4 territorio-sv @(esExtranjero ? "d-none" : null)">
        <label asp-for="DistritoCodigo" class="form-label"></label>
        <select asp-for="DistritoCodigo" id="distritoSelect" class="form-select">
            <option value="">— Selecciona un municipio</option>
            @foreach (var d in distritos)
            {
                <option value="@d.Codigo" data-municipio="@d.ParentCodigo" selected="@(d.Codigo == Model.DistritoCodigo)">@d.Valor</option>
            }
        </select>
        <div class="form-text">Selecciona el distrito; escribirlo en la dirección no sustituye este dato fiscal.</div>
        <span asp-validation-for="DistritoCodigo" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" class="form-control" />
    </div>

    <div class="col-md-12">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" type="email" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger small"></span>
    </div>
</div>

<script>
(function() {
    var pais = document.getElementById('paisSelect');
    var hint = document.getElementById('paisHint');
    var numero = document.getElementById('numeroDocumentoInput');
    var depto = document.getElementById('departamentoSelect');
    var muni  = document.getElementById('municipioSelect');
    var distrito = document.getElementById('distritoSelect');
    var camposTerritorio = document.querySelectorAll('.territorio-sv');
    if (!pais || !hint || !numero || !depto || !muni || !distrito) return;

    var EL_SALVADOR = '@NeoSTP.Application.Clientes.ClienteValidator.PaisElSalvador';

    function filterDistritos() {
        var current = distrito.value;
        var found = false;
        Array.prototype.forEach.call(distrito.options, function(opt) {
            if (!opt.value) { opt.textContent = muni.value ? '— Selecciona un distrito' : '— Selecciona un municipio'; return; }
            var matches = !!muni.value && opt.getAttribute('data-municipio') === muni.value;
            opt.hidden = !matches;
            opt.style.display = matches ? '' : 'none';
            opt.disabled = !matches;
            if (matches && opt.value === current) found = true;
        });
        if (!found) distrito.value = '';
        distrito.required = !distrito.disabled && !!muni.value;
    }

    function filterMunicipios() {
        var selected = depto.value;
        var currentMuni = muni.value;
        var foundCurrent = false;
        Array.prototype.forEach.call(muni.options, function(opt) {
            if (!opt.value) { opt.hidden = false; opt.style.display = ''; return; }
            var matches = !!selected && opt.getAttribute('data-depto') === selected;
            opt.hidden = !matches;
            opt.style.display = matches ? '' : 'none';
            opt.disabled = !matches;
            if (opt.value === currentMuni && matches) foundCurrent = true;
        });
        if (!foundCurrent) muni.value = '';
        filterDistritos();
    }

    function refreshPais() {
        var extranjero = pais.value && pais.value !== EL_SALVADOR;
        hint.style.display = extranjero ? '' : 'none';
        numero.placeholder = extranjero
            ? 'Pasaporte u otro documento (opcional)'
            : 'DUI: 12345678-9 / NIT: 0614-010100-101-1';

        Array.prototype.forEach.call(camposTerritorio, function(campo) {
            campo.classList.toggle('d-none', !!extranjero);
        });
        depto.disabled = !!extranjero;
        muni.disabled = !!extranjero;
        distrito.disabled = !!extranjero;
        distrito.required = false;

        if (extranjero) {
            depto.value = '';
            muni.value = '';
            distrito.value = '';
        } else {
            filterMunicipios();
        }
    }

    depto.addEventListener('change', filterMunicipios);
    muni.addEventListener('change', filterDistritos);
    pais.addEventListener('change', refreshPais);
    refreshPais();
})();
</script>
