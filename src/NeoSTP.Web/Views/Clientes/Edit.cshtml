@model NeoSTP.Web.Models.EditClienteViewModel
@{
    ViewData["Title"] = $"Editar {Model.Nombre}";
    var estados = new[] { "ACTIVO", "INACTIVO" };
}

<form asp-action="Edit" method="post" style="max-width: 960px;">
    <input type="hidden" asp-for="Id" />
    <div class="ns-page-head">
        <div>
            <nav class="ns-breadcrumb"><a asp-action="Index">Clientes</a><span class="material-symbols-outlined">chevron_right</span><span>Editar</span></nav>
            <h1 class="ns-page-title">Editar cliente</h1>
        </div>
        <div class="ns-page-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">badge</span><h2>Datos del cliente · <span class="text-muted">@Model.Nombre</span></h2></div>
        <div class="ns-formsection-body">
            <partial name="_Form" model="(NeoSTP.Web.Models.CreateClienteViewModel)Model" />
            <div class="row g-3 mt-1">
                <div class="col-md-3">
                    <label asp-for="EstadoCodigo" class="form-label"></label>
                    <select asp-for="EstadoCodigo" class="form-select">
                        @foreach (var e in estados) { <option value="@e" selected="@(e == Model.EstadoCodigo)">@e</option> }
                    </select>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
