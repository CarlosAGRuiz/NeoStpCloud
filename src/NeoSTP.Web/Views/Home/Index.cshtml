@model NeoSTP.Web.Models.DashboardViewModel
@using System.Text.Json
@using System.Text.Json.Serialization
@{
    ViewData["Title"] = "Dashboard";
    var dto = Model.EmpresaDashboard;
    var mesNombre = DateTime.UtcNow.ToString("MMMM yyyy");
}

@if (dto is null)
{
    <div class="alert alert-info mt-4">
        No hay empresa asociada a tu cuenta. Solicita al administrador que te asigne a una empresa.
    </div>
    return;
}

@{
    // Sparkline real a partir de la tendencia diaria (sin datos inventados).
    var sparkVals = dto.TendenciaDiaria.Select(x => (double)x.Cantidad).ToList();
    string sparkPath = "";
    if (sparkVals.Count > 1)
    {
        var max = Math.Max(sparkVals.Max(), 1);
        var n = sparkVals.Count;
        var pts = sparkVals.Select((v, i) => $"{(i * 100.0 / (n - 1)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)},{(20 - v / max * 18).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}");
        sparkPath = "M" + string.Join(" L", pts);
    }
}

@* ── Encabezado ───────────────────────────────────────────── *@
<div class="ns-page-head">
    <div>
        <p class="ns-breadcrumb mb-1">@Model.EmpresaNombre &mdash; <span class="text-uppercase" style="letter-spacing:.06em">@mesNombre</span></p>
        <h1 class="ns-page-title">Centro de Control DTE</h1>
    </div>
    <div class="ns-page-actions">
        <a asp-controller="DteDocumentos" asp-action="Create" asp-route-tipo="01" class="btn btn-primary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">add</span> Factura
        </a>
        <a asp-controller="DteDocumentos" asp-action="Create" asp-route-tipo="03" class="btn btn-outline-primary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">add</span> CCF
        </a>
    </div>
</div>

@* Mensajes de flujos que redirigen aquí (cambio de empresa, consolidado de grupo).
   Sin esto el usuario aterriza en el dashboard sin saber por qué falló la acción. *@
@if (TempData["Success"] is string okMsg)
{
    <div class="alert alert-success alert-dismissible fade show">@okMsg <button class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-warning alert-dismissible fade show">@errMsg <button class="btn-close" data-bs-dismiss="alert"></button></div>
}

@* ── Checklist de activación (onboarding) ───────────────────── *@
@if (Model.Onboarding is not null)
{
    <partial name="_OnboardingChecklist" model="Model.Onboarding" />
}

@* ── Fila 1: KPIs ───────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body ns-kpi">
            <div class="ns-kpi-top">
                <span class="ns-kpi-chip"><span class="material-symbols-outlined">receipt_long</span></span>
            </div>
            <p class="ns-kpi-label">DTE emitidos hoy</p>
            <h2 class="ns-kpi-value">@dto.DteHoy</h2>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body ns-kpi">
            <div class="ns-kpi-top">
                <span class="ns-kpi-chip ns-kpi-chip--violet"><span class="material-symbols-outlined">insights</span></span>
            </div>
            <p class="ns-kpi-label">DTE este mes</p>
            <h2 class="ns-kpi-value">@dto.DteMes</h2>
            @if (dto.LimiteDteMensual is > 0)
            {
                <div class="progress mt-2" style="height: 5px;">
                    <div class="progress-bar @(dto.PorcentajeUsoDte >= 90 ? "bg-danger" : dto.PorcentajeUsoDte >= 70 ? "bg-warning" : "bg-success")"
                         role="progressbar" style="width: @dto.PorcentajeUsoDte%"></div>
                </div>
                <small class="text-muted">@dto.DteMes / @dto.LimiteDteMensual (@dto.PorcentajeUsoDte%)</small>
            }
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body ns-kpi">
            <div class="ns-kpi-top">
                <span class="ns-kpi-chip ns-kpi-chip--processed"><span class="material-symbols-outlined">payments</span></span>
            </div>
            <p class="ns-kpi-label">Facturado mes (procesado)</p>
            <h2 class="ns-kpi-value ns-mono" style="color:var(--ns-processed)">$@dto.TotalPagarMes.ToString("N2")</h2>
            @if (!string.IsNullOrEmpty(sparkPath))
            {
                <svg class="ns-spark" viewBox="0 0 100 20" preserveAspectRatio="none"><path d="@sparkPath" style="stroke:var(--ns-processed)" /></svg>
            }
            else
            {
                <small class="text-muted">@dto.Procesados procesado@(dto.Procesados != 1 ? "s" : "")</small>
            }
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="DteDocumentos" asp-action="Index" asp-route-EstadoCodigo="RECHAZADO" class="card h-100 text-decoration-none text-reset"><div class="card-body ns-kpi">
            <div class="ns-kpi-top">
                <span class="ns-kpi-chip @(dto.Rechazados > 0 ? "ns-kpi-chip--rejected" : "")"><span class="material-symbols-outlined">warning</span></span>
            </div>
            <p class="ns-kpi-label">DTE rechazados</p>
            <h2 class="ns-kpi-value" style="color:@(dto.Rechazados > 0 ? "var(--ns-rejected)" : "var(--ns-draft)")">@dto.Rechazados</h2>
            <small class="text-muted">@dto.Rechazados rechazado@(dto.Rechazados != 1 ? "s" : "") · @dto.Pendientes pendiente@(dto.Pendientes != 1 ? "s" : "")</small>
        </div></a>
    </div>
</div>

@* ── Fila 1b: negocio (cartera, tesorería, alertas) ───────────────────────── *@
@if (Model.Cobranza is not null || Model.Tesoreria is not null || Model.AlertasActivas is not null)
{
    <div class="row g-3 mb-4">
        @if (Model.Cobranza is not null)
        {
            <div class="col-sm-6 col-lg-3">
                <a asp-controller="Cobros" asp-action="Index" asp-route-soloVencidas="true" class="card h-100 text-decoration-none text-reset"><div class="card-body ns-kpi">
                    <div class="ns-kpi-top"><span class="ns-kpi-chip @(Model.Cobranza.TotalVencido > 0 ? "ns-kpi-chip--rejected" : "ns-kpi-chip--processed")"><span class="material-symbols-outlined">request_quote</span></span></div>
                    <p class="ns-kpi-label">Cartera vencida</p>
                    <h2 class="ns-kpi-value ns-mono" style="color:@(Model.Cobranza.TotalVencido > 0 ? "var(--ns-rejected)" : "var(--ns-processed)")">$@Model.Cobranza.TotalVencido.ToString("N2")</h2>
                    <small class="text-muted">$@Model.Cobranza.TotalPendiente.ToString("N2") por cobrar en @Model.Cobranza.FacturasPendientes factura@(Model.Cobranza.FacturasPendientes != 1 ? "s" : "")</small>
                </div></a>
            </div>
        }
        @if (Model.Tesoreria is not null)
        {
            <div class="col-sm-6 col-lg-3">
                <a asp-controller="Tesoreria" asp-action="Index" class="card h-100 text-decoration-none text-reset"><div class="card-body ns-kpi">
                    <div class="ns-kpi-top"><span class="ns-kpi-chip ns-kpi-chip--violet"><span class="material-symbols-outlined">account_balance</span></span></div>
                    <p class="ns-kpi-label">Saldo en tesorería</p>
                    <h2 class="ns-kpi-value ns-mono">$@Model.Tesoreria.SaldoTotal.ToString("N2")</h2>
                    <small class="text-muted">Bancos $@Model.Tesoreria.SaldoBancos.ToString("N2") · Caja $@Model.Tesoreria.SaldoCaja.ToString("N2")</small>
                </div></a>
            </div>
        }
        @if (Model.AlertasActivas is int alertas)
        {
            <div class="col-sm-6 col-lg-3">
                <a asp-controller="Alertas" asp-action="Index" class="card h-100 text-decoration-none text-reset"><div class="card-body ns-kpi">
                    <div class="ns-kpi-top"><span class="ns-kpi-chip @(alertas > 0 ? "ns-kpi-chip--contingency" : "")"><span class="material-symbols-outlined">notifications_active</span></span></div>
                    <p class="ns-kpi-label">Alertas activas</p>
                    <h2 class="ns-kpi-value" style="color:@(alertas > 0 ? "var(--ns-contingency)" : "var(--ns-draft)")">@alertas</h2>
                    <small class="text-muted">@(alertas == 0 ? "Todo en orden" : "Revisa el centro de notificaciones")</small>
                </div></a>
            </div>
        }
    </div>
}

@* ── Fila 2: Charts ────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">
                <strong>Emisión diaria — últimos 30 días</strong>
            </div>
            <div class="card-body">
                <canvas id="chartTendencia" height="90"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <strong>Estados este mes</strong>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                @if (dto.PorEstado.Any())
                {
                    <canvas id="chartEstados" style="max-height: 200px;"></canvas>
                }
                else
                {
                    <p class="text-muted">Sin documentos este mes.</p>
                }
            </div>
        </div>
    </div>
</div>

@* ── Fila 3: Tablas ────────────────────────────────────────── *@
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <strong>Por tipo de DTE — mes actual</strong>
            </div>
            @if (dto.PorTipo.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tipo</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Total ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in dto.PorTipo)
                            {
                                <tr>
                                    <td><span class="ns-badge ns-badge--draft me-1">@t.TipoCodigo</span>@t.TipoNombre</td>
                                    <td class="text-end fw-semibold ns-mono">@t.Cantidad</td>
                                    <td class="text-end ns-mono">@t.TotalPagar.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-muted">Sin documentos emitidos este mes.</div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <strong>Plan activo</strong>
            </div>
            <div class="card-body">
                @if (dto.PlanNombre is not null)
                {
                    <div class="mb-3">
                        <span class="ns-badge" style="background:rgba(19,27,46,.08);color:var(--ns-primary);font-size:13px">@dto.PlanNombre</span>
                    </div>
                    @if (dto.LimiteDteMensual is > 0)
                    {
                        <p class="text-muted mb-1">Uso DTE mensual</p>
                        <div class="progress mb-1" style="height: 12px;">
                            <div class="progress-bar @(dto.PorcentajeUsoDte >= 90 ? "bg-danger" : dto.PorcentajeUsoDte >= 70 ? "bg-warning" : "bg-success")"
                                 role="progressbar" style="width: @dto.PorcentajeUsoDte%">
                                @dto.PorcentajeUsoDte%
                            </div>
                        </div>
                        <small class="text-muted">@dto.DteMes de @dto.LimiteDteMensual DTE usados</small>
                    }
                    else
                    {
                        <p class="text-muted mb-0"><i>Sin límite mensual de DTE.</i></p>
                    }
                }
                else
                {
                    <p class="text-warning mb-0 d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:18px">warning</span> Sin plan activo asignado.</p>
                }

                <hr />
                <div class="row g-2 text-center">
                    <div class="col-6">
                        <div class="text-success fw-bold fs-5">@dto.Procesados</div>
                        <div class="text-muted small">Procesados</div>
                    </div>
                    <div class="col-6">
                        <div class="fw-bold fs-5 @(dto.Rechazados > 0 ? "text-danger" : "")">@dto.Rechazados</div>
                        <div class="text-muted small">Rechazados</div>
                    </div>
                    <div class="col-6">
                        <div class="text-warning fw-bold fs-5">@dto.Contingencias</div>
                        <div class="text-muted small">Contingencias</div>
                    </div>
                    <div class="col-6">
                        <div class="fw-bold fs-5">@dto.Pendientes</div>
                        <div class="text-muted small">Pendientes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js"></script>
<script>
(function () {
    // ── Tendencia diaria ──────────────────────────────────────
    const tendencia = @Html.Raw(JsonSerializer.Serialize(
        dto.TendenciaDiaria.Select(x => new { fecha = x.Fecha.ToString("dd/MM"), cantidad = x.Cantidad }),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));

    new Chart(document.getElementById('chartTendencia'), {
        type: 'bar',
        data: {
            labels: tendencia.map(x => x.fecha),
            datasets: [{
                label: 'DTE emitidos',
                data: tendencia.map(x => x.cantidad),
                backgroundColor: 'rgba(107, 56, 212, 0.55)',
                borderColor: 'rgba(107, 56, 212, 0.95)',
                borderWidth: 1,
                borderRadius: 4,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 } },
                x: { ticks: { maxRotation: 45, font: { size: 10 } } }
            }
        }
    });

    // ── Distribución por estado ────────────────────────────────
    const estadosEl = document.getElementById('chartEstados');
    if (estadosEl) {
        const estados = @Html.Raw(JsonSerializer.Serialize(
            dto.PorEstado.Select(x => new { estado = x.Estado, cantidad = x.Cantidad }),
            new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));

        const colorMap = {
            'PROCESADO':   '#10B981',
            'RECHAZADO':   '#EF4444',
            'CONTINGENCIA':'#F59E0B',
            'FIRMADO':     '#8455ef',
            'ENVIADO':     '#6b38d4',
            'VALIDADO':    '#a78bfa',
            'GENERADO':    '#94a3b8',
            'BORRADOR':    '#cbd5e1',
            'INVALIDADO':  '#334155',
            'ERROR':       '#ba1a1a',
        };

        new Chart(estadosEl, {
            type: 'doughnut',
            data: {
                labels: estados.map(x => x.estado),
                datasets: [{
                    data: estados.map(x => x.cantidad),
                    backgroundColor: estados.map(x => colorMap[x.estado] ?? '#6c757d'),
                    borderWidth: 2,
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { size: 11 } } }
                }
            }
        });
    }
})();
</script>
}
