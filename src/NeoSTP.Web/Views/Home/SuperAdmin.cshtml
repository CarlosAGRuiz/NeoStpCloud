@model NeoSTP.Web.Models.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Panel SuperAdmin";
    var dto = Model.SuperAdminDashboard!;
    var mesNombre = DateTime.UtcNow.ToString("MMMM yyyy");
}

@* ── Encabezado ─────────────────────────────────────────────── *@
<div class="ns-page-head">
    <div>
        <p class="ns-breadcrumb mb-1">Métricas globales &mdash; <span class="text-uppercase" style="letter-spacing:.06em">@mesNombre</span></p>
        <h1 class="ns-page-title">Panel SuperAdmin</h1>
    </div>
    <div class="ns-page-actions">
        <a asp-controller="Empresas" asp-action="Index" class="btn btn-outline-secondary btn-sm">Empresas</a>
        <a asp-controller="Planes" asp-action="Index" class="btn btn-outline-secondary btn-sm">Planes</a>
    </div>
</div>

@* ── Fila 1: KPIs globales ───────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg">
        <div class="card h-100"><div class="card-body ns-kpi">
            <div class="ns-kpi-top"><span class="ns-kpi-chip ns-kpi-chip--processed"><span class="material-symbols-outlined">corporate_fare</span></span></div>
            <p class="ns-kpi-label">Empresas activas</p>
            <h2 class="ns-kpi-value" style="color:var(--ns-processed)">@dto.EmpresasActivas</h2>
            <small class="text-muted">de @dto.EmpresasTotal totales</small>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg">
        <div class="card h-100"><div class="card-body ns-kpi">
            <div class="ns-kpi-top"><span class="ns-kpi-chip"><span class="material-symbols-outlined">group</span></span></div>
            <p class="ns-kpi-label">Usuarios activos</p>
            <h2 class="ns-kpi-value">@dto.UsuariosActivos</h2>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg">
        <div class="card h-100"><div class="card-body ns-kpi">
            <div class="ns-kpi-top"><span class="ns-kpi-chip ns-kpi-chip--violet"><span class="material-symbols-outlined">description</span></span></div>
            <p class="ns-kpi-label">DTE emitidos (mes)</p>
            <h2 class="ns-kpi-value">@dto.DteTotalMes</h2>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg">
        <div class="card h-100"><div class="card-body ns-kpi">
            <div class="ns-kpi-top"><span class="ns-kpi-chip ns-kpi-chip--contingency"><span class="material-symbols-outlined">payments</span></span></div>
            <p class="ns-kpi-label">Facturado procesado (mes)</p>
            <h2 class="ns-kpi-value ns-mono" style="color:var(--ns-processed)">$@dto.FacturacionTotalMes.ToString("N2")</h2>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg">
        <div class="card h-100"><div class="card-body ns-kpi">
            <div class="ns-kpi-top"><span class="ns-kpi-chip @(dto.AlertasPlanProximoVencer.Any() ? "ns-kpi-chip--rejected" : "")"><span class="material-symbols-outlined">warning</span></span></div>
            <p class="ns-kpi-label">Alertas planes</p>
            <h2 class="ns-kpi-value" style="color:@(dto.AlertasPlanProximoVencer.Any() ? "var(--ns-rejected)" : "var(--ns-draft)")">@dto.AlertasPlanProximoVencer.Count</h2>
            <small class="text-muted">próximos a vencer</small>
        </div></div>
    </div>
</div>

@* ── Fila 2: Alertas + Resumen planes ───────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <strong class="d-flex align-items-center gap-1">
                    @if (dto.AlertasPlanProximoVencer.Any())
                    {
                        <span class="material-symbols-outlined text-danger" style="font-size:18px">warning</span>
                    }
                    Planes próximos a vencer (30 días)
                </strong>
            </div>
            @if (dto.AlertasPlanProximoVencer.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Empresa</th>
                                <th>Plan</th>
                                <th>Vence</th>
                                <th class="text-end">Días</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in dto.AlertasPlanProximoVencer)
                            {
                                <tr class="@(a.DiasRestantes <= 7 ? "table-danger" : a.DiasRestantes <= 15 ? "table-warning" : "")">
                                    <td>@a.RazonSocial</td>
                                    <td>@a.PlanNombre</td>
                                    <td>@a.FechaFin.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end fw-bold">@a.DiasRestantes</td>
                                    <td>
                                        <a asp-controller="Empresas" asp-action="Edit" asp-route-id="@a.EmpresaId"
                                           class="btn btn-xs btn-outline-secondary btn-sm py-0 px-1">Ver</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-muted">Sin planes próximos a vencer.</div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0">
                <strong>Distribución por plan</strong>
            </div>
            @if (dto.ResumenPorPlan.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Plan</th>
                                <th class="text-end">Empresas</th>
                                <th class="text-end">MRR ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in dto.ResumenPorPlan)
                            {
                                <tr>
                                    <td>@p.PlanNombre</td>
                                    <td class="text-end">@p.EmpresasCount</td>
                                    <td class="text-end text-success fw-semibold">@p.IngresosMensuales.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td>Total</td>
                                <td class="text-end">@dto.ResumenPorPlan.Sum(p => p.EmpresasCount)</td>
                                <td class="text-end text-success">@dto.ResumenPorPlan.Sum(p => p.IngresosMensuales).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-muted">Sin planes activos.</div>
            }
        </div>
    </div>
</div>

@* ── Fila 3: Top empresas ─────────────────────────────────── *@
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <strong>Top 10 empresas por DTE emitido (mes actual)</strong>
            </div>
            @if (dto.TopEmpresasDteMes.Any())
            {
                var maxDte = dto.TopEmpresasDteMes.Max(x => x.DteCount);
                <div class="card-body py-2">
                    @foreach (var e in dto.TopEmpresasDteMes)
                    {
                        var pct = maxDte > 0 ? (int)Math.Round(e.DteCount * 100.0 / maxDte) : 0;
                        <div class="mb-2">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="fw-semibold text-truncate" style="max-width:60%">@e.RazonSocial</small>
                                <small class="text-muted">@e.DteCount DTE · $@e.TotalPagar.ToString("N0")</small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-primary" style="width: @pct%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card-body text-muted">Sin actividad DTE este mes.</div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0">
                <strong>Accesos rápidos</strong>
            </div>
            <div class="card-body d-grid gap-2">
                <a asp-controller="Empresas" asp-action="Create" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2"><span class="material-symbols-outlined" style="font-size:18px">add_business</span> Nueva empresa</a>
                <a asp-controller="Planes" asp-action="Create" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2"><span class="material-symbols-outlined" style="font-size:18px">add</span> Nuevo plan</a>
                <a asp-controller="Soporte" asp-action="Index" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-2"><span class="material-symbols-outlined" style="font-size:18px">build</span> Modo soporte</a>
                <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2"><span class="material-symbols-outlined" style="font-size:18px">group</span> Usuarios</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js"></script>
<script>
(function () {
    // Bar chart: top empresas DTE
    const topData = @Html.Raw(JsonSerializer.Serialize(
        dto.TopEmpresasDteMes.Take(10).Select(x => new { nombre = x.RazonSocial.Length > 20 ? x.RazonSocial[..20] + "…" : x.RazonSocial, count = x.DteCount }),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
})();
</script>
}
