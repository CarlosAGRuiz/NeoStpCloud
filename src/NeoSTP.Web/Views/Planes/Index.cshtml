@model IReadOnlyList<NeoSTP.Application.Licenciamiento.Dtos.PlanDto>
@{ ViewData["Title"] = "Planes"; }

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb">Administración<span class="material-symbols-outlined">chevron_right</span><span>Planes</span></nav>
        <h1 class="ns-page-title">Planes y licencias</h1>
    </div>
</div>
<p class="text-muted small mb-3">Catálogo de planes comerciales y los módulos que incluye cada uno.</p>

<div class="row g-3">
    @foreach (var p in Model ?? Array.Empty<NeoSTP.Application.Licenciamiento.Dtos.PlanDto>())
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 class="h5 mb-0">@p.Nombre</h2>
                        <span class="ns-badge ns-badge--draft">@p.Codigo</span>
                    </div>
                    <p class="text-muted small mb-3">@p.Descripcion</p>
                    <div class="d-flex align-items-baseline gap-1 mb-3">
                        <span class="font-data-mono" style="font-size:11px;opacity:.7">@p.MonedaCodigo</span>
                        <span class="ns-kpi-value">@p.PrecioMensual.ToString("N2")</span>
                        <small class="text-muted">/mes</small>
                    </div>
                    <ul class="list-unstyled small mb-3">
                        <li class="d-flex align-items-center gap-2 mb-1"><span class="material-symbols-outlined" style="font-size:18px;color:var(--ns-secondary)">group</span> Usuarios: <strong>@(p.LimiteUsuarios?.ToString() ?? "ilimitado")</strong></li>
                        <li class="d-flex align-items-center gap-2 mb-1"><span class="material-symbols-outlined" style="font-size:18px;color:var(--ns-secondary)">store</span> Sucursales: <strong>@(p.LimiteSucursales?.ToString() ?? "ilimitado")</strong></li>
                        <li class="d-flex align-items-center gap-2 mb-1"><span class="material-symbols-outlined" style="font-size:18px;color:var(--ns-secondary)">point_of_sale</span> Puntos de venta: <strong>@(p.LimitePuntosVenta?.ToString() ?? "ilimitado")</strong></li>
                        <li class="d-flex align-items-center gap-2"><span class="material-symbols-outlined" style="font-size:18px;color:var(--ns-secondary)">receipt_long</span> DTE/mes: <strong>@(p.LimiteDteMensual?.ToString("N0") ?? "ilimitado")</strong></li>
                    </ul>
                    <div class="mt-3">
                        <strong class="small text-muted">Incluye módulos:</strong>
                        <div class="mt-1 d-flex flex-wrap gap-1">
                            @foreach (var m in p.Modulos.OrderBy(x => x.Orden))
                            {
                                <span class="badge bg-light text-dark border ns-mono">@m.Codigo</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
