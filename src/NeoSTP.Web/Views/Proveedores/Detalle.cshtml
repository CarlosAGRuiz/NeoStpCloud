@using NeoSTP.Application.Compras.Dtos
@model ProveedorDetalleDto
@{
    ViewData["Title"] = $"Proveedor · {Model.Nombre}";
    var puedeGestionar = ViewBag.PuedeGestionar is bool g && g;
    var puedeVerCompras = ViewBag.PuedeVerCompras is bool c && c;
    var activo = Model.EstadoCodigo == "ACTIVO";
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span>
            <a asp-action="Index">Proveedores</a><span class="material-symbols-outlined">chevron_right</span><span>@Model.Codigo</span>
        </nav>
        <h1 class="ns-page-title">@Model.Nombre <span class="ns-pill @(activo ? "ns-pill--on" : "ns-pill--off")">@Model.EstadoCodigo</span></h1>
    </div>
    <div class="d-flex gap-2">
        @if (puedeVerCompras)
        {
            <a asp-controller="Compras" asp-action="Index" asp-route-proveedorId="@Model.Id" class="btn btn-outline-secondary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">receipt_long</span> Sus facturas</a>
        }
        @if (puedeGestionar)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">edit</span> Editar</a>
            @if (activo)
            {
                <form asp-action="Inactivar" asp-route-id="@Model.Id" method="post" class="m-0" onsubmit="return confirm('¿Inactivar proveedor?');">@Html.AntiForgeryToken()<button class="btn btn-outline-danger btn-sm">Inactivar</button></form>
            }
            else
            {
                <form asp-action="Reactivar" asp-route-id="@Model.Id" method="post" class="m-0">@Html.AntiForgeryToken()<button class="btn btn-outline-success btn-sm">Reactivar</button></form>
            }
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
    </div>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header"><span class="material-symbols-outlined align-middle">local_shipping</span> Datos del proveedor</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small">Código</dt><dd class="col-sm-8 ns-mono">@Model.Codigo</dd>
                    <dt class="col-sm-4 text-muted small">NIT</dt><dd class="col-sm-8 ns-mono">@(Model.Nit ?? "—")</dd>
                    <dt class="col-sm-4 text-muted small">NRC</dt><dd class="col-sm-8 ns-mono">@(Model.Nrc ?? "—")</dd>
                    <dt class="col-sm-4 text-muted small">Contacto</dt><dd class="col-sm-8">@(Model.Contacto ?? "—")</dd>
                    <dt class="col-sm-4 text-muted small">Teléfono</dt><dd class="col-sm-8">@(Model.Telefono ?? "—")</dd>
                    <dt class="col-sm-4 text-muted small">Email</dt><dd class="col-sm-8">@(Model.Email ?? "—")</dd>
                    <dt class="col-sm-4 text-muted small">Dirección</dt><dd class="col-sm-8">@(Model.Direccion ?? "—")</dd>
                    <dt class="col-sm-4 text-muted small">Plazo crédito</dt><dd class="col-sm-8">@(Model.PlazoDiasDefault > 0 ? $"{Model.PlazoDiasDefault} días" : "contado")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><span class="material-symbols-outlined align-middle">request_quote</span> Cuentas por pagar</div>
            <div class="card-body">
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Saldo por pagar</span><span class="ns-mono fw-bold fs-4 text-danger">@Model.SaldoPorPagar.ToString("N2")</span></div>
                <div class="d-flex justify-content-between py-2"><span class="text-muted">Facturas pendientes</span><span class="ns-mono fw-bold fs-5">@Model.FacturasPendientes</span></div>
            </div>
        </div>
    </div>
</div>
