@model NeoSTP.Web.Controllers.AuditoriaIndexViewModel
@{
    ViewData["Title"] = "Auditoría";
    var f = Model.Filtro;
    string ResBadge(string r) => r switch
    {
        "OK" => "ns-badge--processed",
        "ERROR" => "ns-badge--rejected",
        "DENEGADO" => "ns-badge--contingency",
        _ => "ns-badge--draft",
    };
    // Conserva el filtro actual para el botón de export.
    var exportRoute = new Dictionary<string, string?>
    {
        ["Search"] = f.Search, ["Modulo"] = f.Modulo, ["Accion"] = f.Accion,
        ["Username"] = f.Username, ["Resultado"] = f.Resultado,
        ["Desde"] = f.Desde?.ToString("yyyy-MM-dd"), ["Hasta"] = f.Hasta?.ToString("yyyy-MM-dd"),
    };
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><span>Auditoría</span></nav>
        <h1 class="ns-page-title">Bitácora de auditoría</h1>
    </div>
    <div>
        <a asp-action="Export" asp-all-route-data="exportRoute" class="btn btn-outline-secondary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">download</span> Exportar CSV
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Buscar</label>
                <input name="Search" value="@f.Search" class="form-control form-control-sm" placeholder="Acción, módulo, entidad, detalle..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Módulo</label>
                <select name="Modulo" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var m in Model.Modulos)
                    {
                        <option value="@m" selected="@(f.Modulo == m)">@m</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Acción</label>
                <input name="Accion" value="@f.Accion" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Usuario</label>
                <input name="Username" value="@f.Username" class="form-control form-control-sm" />
            </div>
            <div class="col-md-1">
                <label class="form-label small">Resultado</label>
                <select name="Resultado" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var r in Model.Resultados)
                    {
                        <option value="@r" selected="@(f.Resultado == r)">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Desde</label>
                <input name="Desde" type="date" value="@(f.Desde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Hasta</label>
                <input name="Hasta" type="date" value="@(f.Hasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100"><span class="material-symbols-outlined align-middle" style="font-size:18px">filter_list</span> Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-sm m-0 align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    @if (Model.EsSuperAdmin) { <th>Empresa</th> }
                    <th>Usuario</th>
                    <th>Módulo</th>
                    <th>Acción</th>
                    <th>Entidad</th>
                    <th>Resultado</th>
                    <th>IP</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Registros.Items.Any())
                {
                    <tr><td colspan="9"><div class="ns-empty"><span class="material-symbols-outlined">history</span><p>Sin registros de auditoría para el filtro.</p></div></td></tr>
                }
                @foreach (var a in Model.Registros.Items)
                {
                    <tr>
                        <td class="ns-mono small text-nowrap">@a.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        @if (Model.EsSuperAdmin) { <td class="ns-mono small">@(a.EmpresaId?.ToString() ?? "—")</td> }
                        <td class="small">@(string.IsNullOrWhiteSpace(a.Username) ? "—" : a.Username)</td>
                        <td><code class="ns-mono small">@a.Modulo</code></td>
                        <td class="small">@a.Accion</td>
                        <td class="small">@(string.IsNullOrWhiteSpace(a.Entidad) ? "—" : $"{a.Entidad}{(string.IsNullOrWhiteSpace(a.EntidadId) ? "" : $" #{a.EntidadId}")}")</td>
                        <td><span class="ns-badge @ResBadge(a.Resultado)">@a.Resultado</span></td>
                        <td class="ns-mono small">@(string.IsNullOrWhiteSpace(a.IpAddress) ? "—" : a.IpAddress)</td>
                        <td class="small text-muted" style="max-width:320px">@a.Detalle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Registros.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @{
                var start = Math.Max(1, Model.Registros.Page - 4);
                var end = Math.Min(Model.Registros.TotalPages, start + 9);
            }
            @for (int i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.Registros.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index" asp-route-page="@i"
                       asp-route-Search="@f.Search" asp-route-Modulo="@f.Modulo" asp-route-Accion="@f.Accion"
                       asp-route-Username="@f.Username" asp-route-Resultado="@f.Resultado"
                       asp-route-Desde="@(f.Desde?.ToString("yyyy-MM-dd"))" asp-route-Hasta="@(f.Hasta?.ToString("yyyy-MM-dd"))">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<p class="text-muted small mt-2">Total: @Model.Registros.Total registros.</p>
