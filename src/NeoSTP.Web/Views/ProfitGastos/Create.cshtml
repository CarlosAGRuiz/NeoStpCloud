@model NeoSTP.Application.Profit.Dtos.CreateProfitGastoRequest
@{
    ViewData["Title"] = "Nuevo gasto";
    var categorias = (ViewBag.Categorias as string[]) ?? Array.Empty<string>();
}

<form asp-action="Create" method="post" style="max-width:820px;">
    <div class="ns-page-head">
        <div>
            <nav class="ns-breadcrumb"><a asp-action="Index">Gastos</a><span class="material-symbols-outlined">chevron_right</span><span>Nuevo</span></nav>
            <h1 class="ns-page-title">Nuevo gasto</h1>
        </div>
        <div class="ns-page-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Registrar</button>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">payments</span><h2>Datos del gasto</h2></div>
        <div class="ns-formsection-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Fecha" class="form-label">Fecha</label>
                    <input asp-for="Fecha" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Categoria" class="form-label">Categoría</label>
                    <select asp-for="Categoria" class="form-select">
                        @foreach (var c in categorias) { <option value="@c" selected="@(c == Model.Categoria)">@c</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Proveedor" class="form-label">Proveedor (opcional)</label>
                    <input asp-for="Proveedor" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" />
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Monto" class="form-label">Monto (sin IVA)</label>
                    <input asp-for="Monto" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="IvaMonto" class="form-label">IVA</label>
                    <input asp-for="IvaMonto" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-4">
                    <div class="form-check mt-4 pt-2">
                        <input asp-for="IvaDeducible" class="form-check-input" />
                        <label asp-for="IvaDeducible" class="form-check-label">IVA deducible (crédito fiscal)</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">public</span><h2>Proveedor extranjero (no domiciliado)</h2></div>
        <div class="ns-formsection-body">
            <div class="form-check form-switch mb-3">
                <input asp-for="ProveedorNoDomiciliado" class="form-check-input" id="noDomiciliadoSwitch" />
                <label asp-for="ProveedorNoDomiciliado" class="form-check-label">
                    El proveedor no está domiciliado en El Salvador (Facebook, Google, SaaS extranjero…)
                </label>
            </div>
            <div id="noDomiciliadoCampos" style="display:none">
                <div class="alert alert-info small">
                    Los pagos a no domiciliados llevan <strong>retención definitiva de ISR del 20%</strong> (art. 158 CT)
                    y el servicio es una <strong>importación gravada con IVA 13%</strong> que se autoliquida.
                    Los montos se sugieren automáticamente; confírmalos con tu contador.
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="RetencionRentaMonto" class="form-label">ISR retenido (20%)</label>
                        <input asp-for="RetencionRentaMonto" type="number" step="0.01" min="0" class="form-control" id="retencionInput" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="IvaImportacionMonto" class="form-label">IVA importación (13%)</label>
                        <input asp-for="IvaImportacionMonto" type="number" step="0.01" min="0" class="form-control" id="ivaImportInput" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            var sw = document.getElementById('noDomiciliadoSwitch');
            var campos = document.getElementById('noDomiciliadoCampos');
            var monto = document.getElementById('Monto');
            var ret = document.getElementById('retencionInput');
            var iva = document.getElementById('ivaImportInput');
            if (!sw || !campos) return;

            function sugerir() {
                var m = parseFloat(monto?.value) || 0;
                if (!sw.checked || m <= 0) return;
                if (!ret.value || parseFloat(ret.value) === 0) ret.value = (m * 0.20).toFixed(2);
                if (!iva.value || parseFloat(iva.value) === 0) iva.value = (m * 0.13).toFixed(2);
            }
            function refresh() {
                campos.style.display = sw.checked ? '' : 'none';
                if (!sw.checked) { ret.value = '0'; iva.value = '0'; } else { sugerir(); }
            }
            sw.addEventListener('change', refresh);
            monto?.addEventListener('change', sugerir);
            refresh();
        })();
    </script>
}
