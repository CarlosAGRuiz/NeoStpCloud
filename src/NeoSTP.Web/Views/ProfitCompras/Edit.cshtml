@model NeoSTP.Application.Profit.Dtos.ProfitCompraDto
@{ ViewData["Title"] = "Editar compra"; }

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" style="max-width:820px;">
    <input type="hidden" asp-for="Id" />
    <div class="ns-page-head">
        <div>
            <nav class="ns-breadcrumb"><a asp-action="Index">Compras</a><span class="material-symbols-outlined">chevron_right</span><span>Editar</span></nav>
            <h1 class="ns-page-title">Editar compra</h1>
        </div>
        <div class="ns-page-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">shopping_cart</span><h2>Datos de la compra</h2></div>
        <div class="ns-formsection-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Fecha" class="form-label">Fecha</label>
                    <input asp-for="Fecha" type="date" class="form-control" />
                </div>
                <div class="col-md-5">
                    <label asp-for="Proveedor" class="form-label">Proveedor</label>
                    <input asp-for="Proveedor" class="form-control" />
                    <span asp-validation-for="Proveedor" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="NumeroDocumento" class="form-label">N° documento</label>
                    <input asp-for="NumeroDocumento" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label asp-for="Descripcion" class="form-label">Descripción (opcional)</label>
                    <input asp-for="Descripcion" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Subtotal" class="form-label">Subtotal (sin IVA)</label>
                    <input asp-for="Subtotal" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="IvaMonto" class="form-label">IVA</label>
                    <input asp-for="IvaMonto" type="number" step="0.01" min="0" class="form-control" />
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
