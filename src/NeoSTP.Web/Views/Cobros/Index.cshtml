@model NeoSTP.Web.Controllers.CobrosIndexViewModel
@{
    ViewData["Title"] = "Cobros";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><span>Cobros</span></nav>
        <h1 class="ns-page-title">Cuentas por cobrar</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Cuentas" class="btn btn-outline-secondary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">account_balance</span> Cuentas de cobro</a>
    </div>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="row g-3 mb-4">
    <div class="col-md col-6">
        <div class="card h-100"><div class="card-body"><div class="ns-metric-label">Pendiente</div><div class="ns-mono fw-bold fs-4">@Model.Resumen.TotalPendiente.ToString("N2")</div></div></div>
    </div>
    <div class="col-md col-6">
        <div class="card h-100"><div class="card-body"><div class="ns-metric-label">Vencido</div><div class="ns-mono fw-bold fs-4 text-danger">@Model.Resumen.TotalVencido.ToString("N2")</div></div></div>
    </div>
    <div class="col-md col-6">
        <div class="card h-100"><div class="card-body"><div class="ns-metric-label">Facturas pendientes</div><div class="ns-mono fw-bold fs-4">@Model.Resumen.FacturasPendientes</div></div></div>
    </div>
    <div class="col-md col-6">
        <div class="card h-100"><div class="card-body"><div class="ns-metric-label">Facturas vencidas</div><div class="ns-mono fw-bold fs-4">@Model.Resumen.FacturasVencidas</div></div></div>
    </div>
    <div class="col-md col-12">
        <div class="card h-100"><div class="card-body"><div class="ns-metric-label">Clientes con deuda</div><div class="ns-mono fw-bold fs-4">@Model.Resumen.ClientesConDeuda</div></div></div>
    </div>
</div>

@if (Model.Qr is not null)
{
    <div class="card mb-4" style="border-left:4px solid var(--ns-secondary)">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <img src="data:image/png;base64,@Model.Qr.QrPngBase64" alt="QR de cobro" width="144" height="144" />
                </div>
                <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="material-symbols-outlined" style="color:var(--ns-secondary)">qr_code_2</span>
                        <strong>Cobro generado</strong>
                        <span class="ns-badge ns-badge--info">@Model.Qr.CuentaTipo</span>
                    </div>
                    <div class="small text-muted">Cuenta: <strong>@Model.Qr.CuentaNombre</strong></div>
                    <div class="small text-muted">Referencia: <code class="ns-mono">@Model.Qr.Referencia</code></div>
                    <div class="small text-muted">Monto: <span class="ns-mono">$ @Model.Qr.Monto.ToString("N2")</span></div>
                    @if (!Model.Qr.EsLink)
                    {
                        <div class="small text-muted">
                            Transferencia: @Model.Qr.Banco @Model.Qr.NumeroCuenta @(string.IsNullOrEmpty(Model.Qr.Titular) ? "" : $"({Model.Qr.Titular})")
                        </div>
                    }
                    <div class="mt-2"><code id="cobroPayload" class="ns-mono small">@Model.Qr.Payload</code></div>

                    @{
                        var mensajeCobro = Model.Qr.EsLink
                            ? $"Hola, puede pagar ${Model.Qr.Monto:N2} (ref. {Model.Qr.Referencia}) en este enlace: {Model.Qr.Payload}"
                            : $"Hola, le comparto los datos para el pago de ${Model.Qr.Monto:N2} (ref. {Model.Qr.Referencia}): {Model.Qr.Payload}";
                        var waUrl = $"https://wa.me/?text={Uri.EscapeDataString(mensajeCobro)}";
                        var mailUrl = $"mailto:?subject={Uri.EscapeDataString($"Solicitud de cobro {Model.Qr.Referencia}")}&body={Uri.EscapeDataString(mensajeCobro)}";
                    }
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @if (Model.Qr.EsLink)
                        {
                            <a href="@Model.Qr.Payload" target="_blank" rel="noopener" class="btn btn-sm btn-primary">
                                <span class="material-symbols-outlined align-middle" style="font-size:16px">credit_card</span> Abrir link de pago
                            </a>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                onclick="navigator.clipboard.writeText(document.getElementById('cobroPayload').innerText).then(() => this.innerText = 'Copiado ✓');">
                            <span class="material-symbols-outlined align-middle" style="font-size:16px">content_copy</span> Copiar
                        </button>
                        <a asp-action="CobrarPdf"
                           asp-route-dteDocumentoId="@Model.Qr.DteDocumentoId"
                           asp-route-cuentaCobroId="@Model.Qr.CuentaCobroId"
                           asp-route-monto="@(Model.Qr.DteDocumentoId is null ? Model.Qr.Monto : null)"
                           asp-route-referencia="@Model.Qr.Referencia"
                           class="btn btn-sm btn-outline-secondary" target="_blank">
                            <span class="material-symbols-outlined align-middle" style="font-size:16px">picture_as_pdf</span> Descargar PDF
                        </a>
                        <a href="@waUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-success">
                            <span class="material-symbols-outlined align-middle" style="font-size:16px">chat</span> WhatsApp
                        </a>
                        <a href="@mailUrl" class="btn btn-sm btn-outline-secondary">
                            <span class="material-symbols-outlined align-middle" style="font-size:16px">mail</span> Correo
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header"><span class="material-symbols-outlined align-middle">qr_code_2</span> Generar QR por monto</div>
    <div class="card-body">
        <form asp-action="GenerarQr" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="search" value="@Model.Search" />
            <input type="hidden" name="soloVencidas" value="@Model.SoloVencidas.ToString().ToLowerInvariant()" />
            <input type="hidden" name="page" value="@Model.Page" />
            <div class="col-md-3">
                <label class="form-label small">Cuenta</label>
                <select name="CuentaCobroId" class="form-select form-select-sm">
                    <option value="">Primera cuenta activa</option>
                    @foreach (var c in Model.CuentasCobro.Where(c => c.EstadoCodigo == "ACTIVO"))
                    {
                        <option value="@c.Id">@c.Nombre (@c.Tipo)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Monto</label>
                <input name="Monto" type="number" step="0.01" min="0.01" class="form-control form-control-sm ns-mono" required />
            </div>
            <div class="col-md-4">
                <label class="form-label small">Referencia</label>
                <input name="Referencia" class="form-control form-control-sm" placeholder="Cobro manual, anticipo, abono..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-sm w-100">Generar QR</button>
            </div>
        </form>
    </div>
</div>

<div class="ns-toolbar">
    <form method="get" class="ns-toolbar-search">
        <input name="search" value="@Model.Search" class="form-control form-control-sm" style="min-width:280px" placeholder="Buscar cliente o numero de control..." />
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="soloVencidas" value="true" id="soloVencidas" @(Model.SoloVencidas ? "checked" : "") />
            <label class="form-check-label small" for="soloVencidas">Solo vencidas</label>
        </div>
        <button type="submit" class="btn btn-outline-secondary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">search</span> Buscar</button>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead>
                <tr>
                    <th>Emision</th>
                    <th>Vencimiento</th>
                    <th>Cliente</th>
                    <th>Numero control</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Pagado</th>
                    <th class="text-end">Saldo</th>
                    <th>Estado</th>
                    <th class="text-end">Dias</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Pendientes.Items.Any())
                {
                    <tr><td colspan="10"><div class="ns-empty"><span class="material-symbols-outlined">paid</span><p>Sin facturas a crédito pendientes. Las facturas con condición a crédito aparecen aquí para darles seguimiento.</p><a asp-controller="DteDocumentos" asp-action="Create" class="btn btn-primary btn-sm">Emitir DTE</a></div></td></tr>
                }
                @foreach (var f in Model.Pendientes.Items)
                {
                    var badge = f.EstadoCobro == "VENCIDO" ? "ns-badge--rejected" : "ns-badge--contingency";
                    <tr>
                        <td class="ns-mono">@f.FechaEmision.ToString("dd/MM/yyyy")</td>
                        <td class="ns-mono">@f.Vencimiento.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (f.ClienteId is int clienteId)
                            {
                                <a asp-action="Cliente" asp-route-clienteId="@clienteId">@f.ClienteNombre</a>
                            }
                            else
                            {
                                <span>@f.ClienteNombre</span>
                            }
                        </td>
                        <td><a asp-controller="DteDocumentos" asp-action="Details" asp-route-id="@f.DteDocumentoId"><code class="ns-mono small">@f.NumeroControl</code></a></td>
                        <td class="text-end ns-mono">@f.Total.ToString("N2")</td>
                        <td class="text-end ns-mono">@f.Pagado.ToString("N2")</td>
                        <td class="text-end ns-mono fw-bold">@f.Saldo.ToString("N2")</td>
                        <td><span class="ns-badge @badge">@f.EstadoCobro</span></td>
                        <td class="text-end ns-mono">@f.DiasVencido</td>
                        <td class="text-end">
                            <div class="d-flex flex-column gap-2 align-items-end">
                                <form asp-action="GenerarQr" method="post" class="d-flex gap-1 justify-content-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="DteDocumentoId" value="@f.DteDocumentoId" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="soloVencidas" value="@Model.SoloVencidas.ToString().ToLowerInvariant()" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <select name="CuentaCobroId" class="form-select form-select-sm" style="width:170px">
                                        <option value="">Cuenta activa</option>
                                        @foreach (var c in Model.CuentasCobro.Where(c => c.EstadoCodigo == "ACTIVO"))
                                        {
                                            <option value="@c.Id">@c.Nombre</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">QR</button>
                                </form>
                                @if (Model.PuedeGestionar)
                                {
                                    <form asp-action="RegistrarPago" method="post" class="d-flex flex-wrap gap-1 justify-content-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <input type="hidden" name="dteDocumentoId" value="@f.DteDocumentoId" />
                                        <input name="Monto" type="number" step="0.01" min="0.01" max="@f.Saldo" class="form-control form-control-sm ns-mono" style="width:110px" placeholder="Monto" required />
                                        <select name="FormaPagoCodigo" class="form-select form-select-sm" style="width:145px">
                                            @foreach (var forma in Model.FormasPago)
                                            {
                                                <option value="@forma">@forma</option>
                                            }
                                        </select>
                                        <input name="Referencia" class="form-control form-control-sm" style="width:145px" placeholder="Referencia" />
                                        <button type="submit" class="btn btn-sm btn-primary">Registrar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Pendientes.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (int i = 1; i <= Model.Pendientes.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Pendientes.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-soloVencidas="@Model.SoloVencidas">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<p class="text-muted small mt-2">Total: @Model.Pendientes.Total facturas.</p>
