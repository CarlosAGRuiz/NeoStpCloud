@model NeoSTP.Web.Controllers.CobrosClienteViewModel
@{
    ViewData["Title"] = "Saldo de cliente";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-action="Index">Cobros</a><span class="material-symbols-outlined">chevron_right</span><span>Cliente</span></nav>
        <h1 class="ns-page-title">@Model.Saldo.ClienteNombre</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver a cobros</a>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body"><div class="ns-metric-label">Pendiente</div><div class="ns-mono fw-bold fs-4">@Model.Saldo.TotalPendiente.ToString("N2")</div></div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body"><div class="ns-metric-label">Vencido</div><div class="ns-mono fw-bold fs-4 text-danger">@Model.Saldo.TotalVencido.ToString("N2")</div></div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body"><div class="ns-metric-label">Facturas</div><div class="ns-mono fw-bold fs-4">@Model.Saldo.Facturas.Count</div></div></div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead>
                <tr>
                    <th>Emision</th>
                    <th>Vencimiento</th>
                    <th>Numero control</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Pagado</th>
                    <th class="text-end">Saldo</th>
                    <th>Estado</th>
                    <th>Pagos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Saldo.Facturas.Any())
                {
                    <tr><td colspan="9"><div class="ns-empty"><span class="material-symbols-outlined">person_check</span><p>Este cliente no tiene facturas pendientes.</p></div></td></tr>
                }
                @foreach (var f in Model.Saldo.Facturas)
                {
                    var badge = f.EstadoCobro == "VENCIDO" ? "ns-badge--rejected" : "ns-badge--contingency";
                    var pagos = Model.PagosPorDte.TryGetValue(f.DteDocumentoId, out var lista) ? lista : Array.Empty<NeoSTP.Application.Cobranza.Dtos.PagoClienteDto>();
                    <tr>
                        <td class="ns-mono">@f.FechaEmision.ToString("dd/MM/yyyy")</td>
                        <td class="ns-mono">@f.Vencimiento.ToString("dd/MM/yyyy")</td>
                        <td><a asp-controller="DteDocumentos" asp-action="Details" asp-route-id="@f.DteDocumentoId"><code class="ns-mono small">@f.NumeroControl</code></a></td>
                        <td class="text-end ns-mono">@f.Total.ToString("N2")</td>
                        <td class="text-end ns-mono">@f.Pagado.ToString("N2")</td>
                        <td class="text-end ns-mono fw-bold">@f.Saldo.ToString("N2")</td>
                        <td><span class="ns-badge @badge">@f.EstadoCobro</span></td>
                        <td>
                            @if (!pagos.Any())
                            {
                                <span class="text-muted small">Sin pagos</span>
                            }
                            @foreach (var p in pagos)
                            {
                                var pagoBadge = p.EstadoCodigo == "CONFIRMADO" ? "ns-pill ns-pill--on" : p.EstadoCodigo == "ANULADO" ? "ns-pill ns-pill--off" : "ns-badge ns-badge--contingency";
                                <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                    <span class="ns-mono small">@p.Fecha.ToString("dd/MM/yyyy")</span>
                                    <strong class="ns-mono small">@p.Monto.ToString("N2")</strong>
                                    <span class="@pagoBadge">@p.EstadoCodigo</span>
                                    @if (Model.PuedeGestionar && p.EstadoCodigo == "PENDIENTE_REVISION")
                                    {
                                        <form asp-action="ConfirmarPago" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <input type="hidden" name="pagoId" value="@p.Id" />
                                            <button class="btn btn-sm btn-outline-success" type="submit">Confirmar</button>
                                        </form>
                                    }
                                    @if (Model.PuedeGestionar && p.EstadoCodigo != "ANULADO")
                                    {
                                        <form asp-action="AnularPago" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <input type="hidden" name="pagoId" value="@p.Id" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Anular</button>
                                        </form>
                                    }
                                </div>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex flex-column gap-2 align-items-end">
                                <form asp-action="GenerarQr" method="post" class="d-flex gap-1 justify-content-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="DteDocumentoId" value="@f.DteDocumentoId" />
                                    <select name="CuentaCobroId" class="form-select form-select-sm" style="width:170px">
                                        <option value="">Cuenta activa</option>
                                        @foreach (var c in Model.CuentasCobro.Where(c => c.EstadoCodigo == "ACTIVO"))
                                        {
                                            <option value="@c.Id">@c.Nombre</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">QR</button>
                                </form>
                                @if (Model.PuedeGestionar)
                                {
                                    <form asp-action="RegistrarPago" method="post" class="d-flex flex-wrap gap-1 justify-content-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <input type="hidden" name="dteDocumentoId" value="@f.DteDocumentoId" />
                                        <input name="Monto" type="number" step="0.01" min="0.01" max="@f.Saldo" class="form-control form-control-sm ns-mono" style="width:110px" placeholder="Monto" required />
                                        <input name="Referencia" class="form-control form-control-sm" style="width:145px" placeholder="Referencia" />
                                        <button type="submit" class="btn btn-sm btn-primary">Registrar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
