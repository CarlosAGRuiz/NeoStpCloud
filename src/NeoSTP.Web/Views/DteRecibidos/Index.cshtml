@model NeoSTP.Web.Controllers.DteRecibidosIndexViewModel
@{
    ViewData["Title"] = "DTE recibidos";
    var totalMonto = Model.Recibidos.Items.Sum(r => r.Total);
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><span>DTE recibidos</span></nav>
        <h1 class="ns-page-title">DTE recibidos de proveedores</h1>
    </div>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="ns-toolbar">
    <form method="get" class="ns-toolbar-search">
        <input name="search" value="@Model.Search" class="form-control form-control-sm" style="min-width:240px" placeholder="Buscar emisor, NIT o Nº control..." />
        <input name="desde" type="date" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="width:160px" title="Desde" />
        <input name="hasta" type="date" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="width:160px" title="Hasta" />
        <button type="submit" class="btn btn-outline-secondary btn-sm"><span class="material-symbols-outlined align-middle" style="font-size:18px">search</span> Buscar</button>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Emisor</th>
                    <th>NIT</th>
                    <th>Tipo</th>
                    <th>Número control</th>
                    <th class="text-end">Subtotal</th>
                    <th class="text-end">IVA</th>
                    <th class="text-end">Total</th>
                    <th>Origen</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Recibidos.Items.Any())
                {
                    <tr><td colspan="10"><div class="ns-empty"><span class="material-symbols-outlined">inbox</span><p>Sin DTE recibidos registrados.</p></div></td></tr>
                }
                @foreach (var r in Model.Recibidos.Items)
                {
                    <tr>
                        <td class="ns-mono">@r.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@r.EmisorNombre</td>
                        <td class="ns-mono small">@(string.IsNullOrWhiteSpace(r.EmisorNit) ? "—" : r.EmisorNit)</td>
                        <td><code class="ns-mono small">@(string.IsNullOrWhiteSpace(r.TipoDteCodigo) ? "—" : r.TipoDteCodigo)</code></td>
                        <td><code class="ns-mono small">@(string.IsNullOrWhiteSpace(r.NumeroControl) ? "—" : r.NumeroControl)</code></td>
                        <td class="text-end ns-mono">@r.Subtotal.ToString("N2")</td>
                        <td class="text-end ns-mono">@r.Iva.ToString("N2")</td>
                        <td class="text-end ns-mono fw-bold">@r.Total.ToString("N2")</td>
                        <td>
                            @if (r.ScanDocumentoId is int sid)
                            {
                                <a asp-controller="Scan" asp-action="Detalle" asp-route-id="@sid" class="small"><span class="material-symbols-outlined align-middle" style="font-size:16px">document_scanner</span> Scan #@sid</a>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                <span class="material-symbols-outlined align-middle" style="font-size:18px">visibility</span> Ver
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Recibidos.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (int i = 1; i <= Model.Recibidos.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Recibidos.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))" asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<p class="text-muted small mt-2">Total: @Model.Recibidos.Total documentos · Suma en esta página: <span class="ns-mono">@totalMonto.ToString("N2")</span></p>
