@using NeoSTP.Application.Inventario.Dtos
@model NeoSTP.Application.Common.PagedResult<MovimientoInventarioDto>
@{
    var e = ViewBag.Existencia as ExistenciaDto;
    ViewData["Title"] = $"Kardex · {e?.Nombre}";
    var puedeGestionar = ViewBag.PuedeGestionar is bool g && g;
    string Badge(string t) => t switch { "ENTRADA" => "ns-badge--processed", "SALIDA" => "ns-badge--rejected", _ => "ns-badge--contingency" };
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><a asp-action="Index">Inventario</a><span class="material-symbols-outlined">chevron_right</span><span>@e?.Codigo</span></nav>
        <h1 class="ns-page-title">@e?.Nombre</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between py-1"><span class="text-muted">Existencia</span><span class="ns-mono fw-bold fs-4 @(e?.StockBajo == true ? "text-danger" : "")">@(e?.Cantidad.ToString("N2"))</span></div>
                <div class="d-flex justify-content-between py-1"><span class="text-muted">Costo promedio</span><span class="ns-mono">@(e?.CostoPromedio.ToString("N4"))</span></div>
                <div class="d-flex justify-content-between py-1 border-top"><span class="text-muted">Valor</span><span class="ns-mono fw-bold">@(e?.Valor.ToString("N2"))</span></div>
                <div class="d-flex justify-content-between py-1"><span class="text-muted">Stock mínimo</span><span class="ns-mono">@(e?.StockMinimo.ToString("N2"))</span></div>
            </div>
        </div>

        @if (puedeGestionar && e is not null)
        {
            <div class="card">
                <div class="card-header"><span class="material-symbols-outlined align-middle">tune</span> Movimientos</div>
                <div class="card-body">
                    <ul class="nav nav-tabs nav-fill mb-3" role="tablist">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tEntrada" type="button">Entrada</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tSalida" type="button">Salida</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tAjuste" type="button">Ajuste</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tTraslado" type="button">Traslado</button></li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="tEntrada">
                            <form asp-action="Entrada" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductoId" value="@e.ProductoId" />
                                <input type="hidden" name="Origen" value="COMPRA" />
                                <div class="mb-2"><label class="form-label small">Cantidad</label><input name="Cantidad" type="number" step="0.0001" min="0.0001" class="form-control form-control-sm ns-mono" required /></div>
                                <div class="mb-2"><label class="form-label small">Costo unitario</label><input name="CostoUnitario" type="number" step="0.0001" min="0" value="@e.CostoPromedio.ToString("0.00##")" class="form-control form-control-sm ns-mono" /></div>
                                @{
                                    var sucursalesForm = (ViewBag.Sucursales as IReadOnlyList<(int Id, string Nombre)>) ?? Array.Empty<(int, string)>();
                                    var sucKardex = ViewBag.SucursalId as int?;
                                }
                                @if (sucursalesForm.Count > 0)
                                {
                                    <div class="mb-2"><label class="form-label small">Sucursal</label>
                                        <select name="SucursalId" class="form-select form-select-sm">
                                            <option value="">Bodega central</option>
                                            @foreach (var s in sucursalesForm) { <option value="@s.Id" selected="@(sucKardex == s.Id)">@s.Nombre</option> }
                                        </select>
                                    </div>
                                }
                                <div class="mb-2"><label class="form-label small">Lote (si el producto controla lote)</label><input name="NumeroLote" maxlength="40" class="form-control form-control-sm text-uppercase" placeholder="L-2026-01" /></div>
                                <div class="mb-2"><label class="form-label small">Vencimiento del lote</label><input name="FechaVencimiento" type="date" class="form-control form-control-sm" /></div>
                                <div class="mb-2"><label class="form-label small">Referencia</label><input name="Referencia" class="form-control form-control-sm" /></div>
                                <button class="btn btn-success btn-sm w-100">Registrar entrada</button>
                            </form>
                        </div>
                        <div class="tab-pane fade" id="tSalida">
                            <form asp-action="Salida" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductoId" value="@e.ProductoId" />
                                <input type="hidden" name="Origen" value="AJUSTE" />
                                <div class="mb-2"><label class="form-label small">Cantidad</label><input name="Cantidad" type="number" step="0.0001" min="0.0001" max="@e.Cantidad" class="form-control form-control-sm ns-mono" required /></div>
                                @if (((ViewBag.Sucursales as IReadOnlyList<(int Id, string Nombre)>) ?? Array.Empty<(int, string)>()).Count > 0)
                                {
                                    <div class="mb-2"><label class="form-label small">Sucursal</label>
                                        <select name="SucursalId" class="form-select form-select-sm">
                                            <option value="">Bodega central</option>
                                            @foreach (var s in (IReadOnlyList<(int Id, string Nombre)>)ViewBag.Sucursales) { <option value="@s.Id">@s.Nombre</option> }
                                        </select>
                                    </div>
                                }
                                <div class="mb-2"><label class="form-label small">Lote (vacío = FEFO automático)</label><input name="NumeroLote" maxlength="40" class="form-control form-control-sm text-uppercase" /></div>
                                <div class="mb-2"><label class="form-label small">Referencia</label><input name="Referencia" class="form-control form-control-sm" /></div>
                                <button class="btn btn-outline-danger btn-sm w-100">Registrar salida</button>
                            </form>
                        </div>
                        <div class="tab-pane fade" id="tAjuste">
                            <form asp-action="Ajuste" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductoId" value="@e.ProductoId" />
                                <div class="mb-2"><label class="form-label small">Cantidad real (conteo)</label><input name="CantidadAbsoluta" type="number" step="0.0001" min="0" value="@e.Cantidad.ToString("0.00##")" class="form-control form-control-sm ns-mono" required /></div>
                                <div class="mb-2"><label class="form-label small">Costo (opcional)</label><input name="CostoUnitario" type="number" step="0.0001" min="0" class="form-control form-control-sm ns-mono" /></div>
                                <div class="mb-2"><label class="form-label small">Nota</label><input name="Nota" class="form-control form-control-sm" /></div>
                                <button class="btn btn-outline-primary btn-sm w-100">Ajustar a cantidad</button>
                            </form>
                            <hr />
                            <form asp-action="StockMinimo" method="post" class="d-flex gap-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductoId" value="@e.ProductoId" />
                                <div class="flex-grow-1"><label class="form-label small">Stock mínimo</label><input name="StockMinimo" type="number" step="0.01" min="0" value="@e.StockMinimo.ToString("0.##")" class="form-control form-control-sm ns-mono" /></div>
                                <button class="btn btn-outline-secondary btn-sm">Guardar</button>
                            </form>
                        </div>
                        <div class="tab-pane fade" id="tTraslado">
                            @{
                                var sucTraslado = (ViewBag.Sucursales as IReadOnlyList<(int Id, string Nombre)>) ?? Array.Empty<(int, string)>();
                            }
                            @if (sucTraslado.Count == 0)
                            {
                                <p class="text-muted small py-2">Crea sucursales en la configuración de la empresa para trasladar mercadería.</p>
                            }
                            else
                            {
                                <form asp-action="Traslado" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ProductoId" value="@e.ProductoId" />
                                    <div class="mb-2"><label class="form-label small">Cantidad</label><input name="Cantidad" type="number" step="0.0001" min="0.0001" class="form-control form-control-sm ns-mono" required /></div>
                                    <div class="mb-2"><label class="form-label small">De</label>
                                        <select name="SucursalOrigenId" class="form-select form-select-sm">
                                            <option value="">Bodega central</option>
                                            @foreach (var s in sucTraslado) { <option value="@s.Id">@s.Nombre</option> }
                                        </select>
                                    </div>
                                    <div class="mb-2"><label class="form-label small">Hacia</label>
                                        <select name="SucursalDestinoId" class="form-select form-select-sm">
                                            <option value="">Bodega central</option>
                                            @foreach (var s in sucTraslado) { <option value="@s.Id">@s.Nombre</option> }
                                        </select>
                                    </div>
                                    <div class="mb-2"><label class="form-label small">Lote (vacío = FEFO)</label><input name="NumeroLote" maxlength="40" class="form-control form-control-sm text-uppercase" /></div>
                                    <div class="mb-2"><label class="form-label small">Nota</label><input name="Nota" maxlength="250" class="form-control form-control-sm" /></div>
                                    <button class="btn btn-outline-primary btn-sm w-100">Trasladar</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><span class="material-symbols-outlined align-middle">history</span> Kardex</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover m-0 align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Origen</th>
                            <th class="text-end">Cant.</th>
                            <th class="text-end">Costo</th>
                            <th class="text-end">Saldo</th>
                            <th class="text-end">Costo prom.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model is null || !Model.Items.Any())
                        {
                            <tr><td colspan="7"><div class="ns-empty"><span class="material-symbols-outlined">history</span><p>Sin movimientos.</p></div></td></tr>
                        }
                        @foreach (var m in Model?.Items ?? Array.Empty<MovimientoInventarioDto>())
                        {
                            <tr>
                                <td class="ns-mono small">@m.Fecha.ToString("dd/MM/yy")</td>
                                <td><span class="ns-badge @Badge(m.Tipo)">@m.Tipo</span></td>
                                <td class="small">@m.Origen @if (!string.IsNullOrWhiteSpace(m.Referencia)) { <span class="text-muted ns-mono">· @m.Referencia</span> }</td>
                                <td class="text-end ns-mono">@m.Cantidad.ToString("N2")</td>
                                <td class="text-end ns-mono small">@m.CostoUnitario.ToString("N4")</td>
                                <td class="text-end ns-mono fw-bold">@m.SaldoCantidad.ToString("N2")</td>
                                <td class="text-end ns-mono small">@m.SaldoCostoPromedio.ToString("N4")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model is not null && Model.TotalPages > 1)
        {
            <nav class="mt-3"><ul class="pagination pagination-sm">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" asp-action="Kardex" asp-route-productoId="@(e?.ProductoId)" asp-route-page="@i">@i</a></li>
                }
            </ul></nav>
        }
    </div>
</div>
