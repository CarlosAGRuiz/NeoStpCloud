@model NeoSTP.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · NeoSTP Cloud</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Hanken+Grotesk:wght@600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,1,0&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/neostp.css" asp-append-version="true" />
</head>
<body class="ns-app">
    <div class="ns-auth">
        <div class="ns-auth-card">
            <div class="ns-auth-logo"><span class="material-symbols-outlined">cloud_done</span></div>
            <h1 class="h4 text-center mb-1" style="font-family:'Hanken Grotesk';font-weight:800;color:#131b2e;">NeoSTP Cloud</h1>
            <p class="text-muted text-center mb-4">Inicia sesión para continuar</p>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>
            @if (ViewBag.Error is string errorLogin)
            {
                <div class="alert alert-warning" role="alert">@errorLogin</div>
            }

            <form asp-action="Login" method="post" autocomplete="on">
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label fw-medium"></label>
                    <input asp-for="UsernameOrEmail" class="form-control form-control-lg" autofocus />
                    <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-medium"></label>
                    <input asp-for="Password" class="form-control form-control-lg" type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-lg w-100 text-white" style="background:#131b2e;">Entrar</button>
            </form>

            @{
                var ssoMicrosoft = ViewBag.SsoMicrosoft is bool m && m;
                var ssoGoogle = ViewBag.SsoGoogle is bool g && g;
            }
            @if (ssoMicrosoft || ssoGoogle)
            {
                <div class="d-flex align-items-center gap-2 my-3 text-muted small">
                    <hr class="flex-grow-1 m-0" /><span>o continúa con</span><hr class="flex-grow-1 m-0" />
                </div>
                @if (ssoMicrosoft)
                {
                    <a asp-action="ExternalLogin" asp-route-provider="Microsoft" asp-route-returnUrl="@Model.ReturnUrl"
                       class="btn btn-outline-secondary btn-lg w-100 mb-2 d-flex align-items-center justify-content-center gap-2">
                        <span class="material-symbols-outlined" style="font-size:20px">window</span> Microsoft Entra ID
                    </a>
                }
                @if (ssoGoogle)
                {
                    <a asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@Model.ReturnUrl"
                       class="btn btn-outline-secondary btn-lg w-100 mb-2 d-flex align-items-center justify-content-center gap-2">
                        <span class="material-symbols-outlined" style="font-size:20px">account_circle</span> Google Workspace
                    </a>
                }
            }

            @if (TempData["Error"] is string ssoError)
            {
                <div class="alert alert-warning mt-2" role="alert">@ssoError</div>
            }
            <p class="text-center text-muted small mt-4 mb-0">© @DateTime.Now.Year NeoSTP — Plataforma SaaS DTE</p>
        </div>
    </div>

    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
