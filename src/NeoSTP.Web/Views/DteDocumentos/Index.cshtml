@model NeoSTP.Application.Common.PagedResult<NeoSTP.Application.Dte.Dtos.DteDocumentoListItemDto>
@{
    ViewData["Title"] = "Documentos DTE";
    var q = ViewBag.Query as NeoSTP.Application.Dte.Dtos.DteListQuery
        ?? new NeoSTP.Application.Dte.Dtos.DteListQuery();
}

@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

@{
    string EstadoNsBadge(string e) => e switch
    {
        "PROCESADO" => "ns-badge ns-badge--processed",
        "RECHAZADO" or "ERROR" or "INVALIDADO" => "ns-badge ns-badge--rejected",
        "CONTINGENCIA" or "ENVIADO" or "FIRMADO" => "ns-badge ns-badge--contingency",
        _ => "ns-badge ns-badge--draft",
    };
}

<div class="ns-toolbar">
    <form method="get" class="ns-toolbar-search">
        <input name="Search" value="@q.Search" class="form-control form-control-sm" style="min-width:220px" placeholder="Nº control, código, receptor…" />
        <select name="TipoDteCodigo" class="form-select form-select-sm" style="width:auto">
            <option value="">Todos los tipos</option>
            <option value="01" selected="@(q.TipoDteCodigo == "01")">01 Factura</option>
            <option value="03" selected="@(q.TipoDteCodigo == "03")">03 CCF</option>
            <option value="04" selected="@(q.TipoDteCodigo == "04")">04 Nota Remisión</option>
            <option value="05" selected="@(q.TipoDteCodigo == "05")">05 Nota Crédito</option>
            <option value="06" selected="@(q.TipoDteCodigo == "06")">06 Nota Débito</option>
            <option value="11" selected="@(q.TipoDteCodigo == "11")">11 Exportación</option>
            <option value="14" selected="@(q.TipoDteCodigo == "14")">14 Sujeto Excluido</option>
            <option value="15" selected="@(q.TipoDteCodigo == "15")">15 Donación</option>
        </select>
        <select name="EstadoCodigo" class="form-select form-select-sm" style="width:auto">
            <option value="">Todos los estados</option>
            @foreach (var s in new[] { "BORRADOR", "GENERADO", "VALIDADO", "FIRMADO", "ENVIADO", "PROCESADO", "RECHAZADO", "CONTINGENCIA", "INVALIDADO", "ERROR" })
            {
                <option value="@s" selected="@(q.EstadoCodigo == s)">@s</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">filter_list</span> Filtrar
        </button>
        <a asp-action="Index" class="btn btn-link btn-sm">Limpiar</a>
    </form>
    <div class="dropdown">
        <button class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">add</span> Nuevo DTE
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" asp-action="Create" asp-route-tipo="01">Factura (01)</a></li>
            <li><a class="dropdown-item" asp-action="Create" asp-route-tipo="03">Comprobante Crédito Fiscal (03)</a></li>
            <li><a class="dropdown-item" asp-action="Create" asp-route-tipo="05">Nota de Crédito (05)</a></li>
            <li><a class="dropdown-item" asp-action="Create" asp-route-tipo="06">Nota de Débito (06)</a></li>
            <li><a class="dropdown-item" asp-action="Create" asp-route-tipo="14">Sujeto Excluido (14)</a></li>
        </ul>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Nº Control</th>
                    <th>Fecha</th>
                    <th>Receptor</th>
                    <th class="text-end">Total</th>
                    <th>Estado</th>
                    <th>Ambiente</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model is null || !Model.Items.Any())
                {
                    <tr><td colspan="8"><div class="ns-empty"><span class="material-symbols-outlined">receipt_long</span><p>Sin documentos electrónicos.</p></div></td></tr>
                }
                @foreach (var d in Model?.Items ?? Array.Empty<NeoSTP.Application.Dte.Dtos.DteDocumentoListItemDto>())
                {
                    <tr>
                        <td><span class="ns-badge ns-badge--draft">@d.TipoDteCodigo</span></td>
                        <td><small class="ns-mono fw-bold">@d.NumeroControl</small></td>
                        <td>@d.FechaEmision.ToString("yyyy-MM-dd")</td>
                        <td>@(d.ReceptorNombre ?? "—")<br /><small class="text-muted ns-mono">@d.ReceptorNumeroDocumento</small></td>
                        <td class="text-end"><strong class="ns-mono">$ @d.TotalPagar.ToString("N2")</strong></td>
                        <td><span class="@EstadoNsBadge(d.EstadoCodigo)">@d.EstadoCodigo</span></td>
                        <td><small>@d.AmbienteCodigo</small></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model is not null && Model.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-Page="@i" asp-route-Search="@q.Search" asp-route-TipoDteCodigo="@q.TipoDteCodigo" asp-route-EstadoCodigo="@q.EstadoCodigo">@i</a>
            </li>
        }
    </ul></nav>
}

<p class="text-muted small mt-2">Total: @(Model?.Total ?? 0) documentos.</p>
