@model NeoSTP.Application.Common.PagedResult<NeoSTP.Application.Usuarios.Dtos.UsuarioDto>
@{
    ViewData["Title"] = "Usuarios";
    var search = ViewBag.Search as string;
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><span>Usuarios</span></nav>
        <h1 class="ns-page-title">Usuarios</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <span class="material-symbols-outlined align-middle" style="font-size:18px">add</span> Nuevo usuario
    </a>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok <button class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err <button class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="ns-toolbar">
    <form method="get" class="ns-toolbar-search">
        <input name="search" value="@search" class="form-control form-control-sm" style="min-width:280px" placeholder="Buscar usuario, email o nombre…" />
        <button type="submit" class="btn btn-outline-secondary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">search</span> Buscar
        </button>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover m-0 align-middle">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Roles</th>
                    <th>Último login</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model is null || !Model.Items.Any())
                {
                    <tr><td colspan="8"><div class="ns-empty"><span class="material-symbols-outlined">group</span><p>Sin usuarios registrados.</p></div></td></tr>
                }
                @foreach (var u in Model?.Items ?? Array.Empty<NeoSTP.Application.Usuarios.Dtos.UsuarioDto>())
                {
                    var badgeClass = u.EstadoCodigo switch {
                        "ACTIVO" => "bg-success",
                        "BLOQUEADO" => "bg-danger",
                        "INACTIVO" => "bg-secondary",
                        _ => "bg-warning text-dark"
                    };
                    <tr>
                        <td><strong>@u.Username</strong></td>
                        <td>@u.NombreCompleto</td>
                        <td><span class="text-muted">@u.Email</span></td>
                        <td><span class="badge bg-info">@u.TipoUsuarioCodigo</span></td>
                        <td><span class="badge @badgeClass">@u.EstadoCodigo</span></td>
                        <td>
                            @foreach (var r in u.RoleCodigos) { <span class="badge bg-light text-dark border me-1">@r</span> }
                        </td>
                        <td class="small text-muted">@(u.UltimoLogin?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (u.EstadoCodigo == "BLOQUEADO")
                            {
                                <form asp-action="Desbloquear" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-success">Desbloquear</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Bloquear" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Bloquear este usuario?');">Bloquear</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model is not null && Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<p class="text-muted small mt-2">Total: @(Model?.Total ?? 0) usuarios.</p>

@* ── Miembros externos (membresías E1): contadores/asesores con su propio login ── *@
@{
    var miembros = (ViewBag.MiembrosExternos as IReadOnlyList<NeoSTP.Application.Usuarios.MiembroExternoDto>)
        ?? Array.Empty<NeoSTP.Application.Usuarios.MiembroExternoDto>();
    var rolesInvitar = (ViewBag.RolesInvitar as IReadOnlyList<NeoSTP.Application.Roles.Dtos.RolDto>)
        ?? Array.Empty<NeoSTP.Application.Roles.Dtos.RolDto>();
    var puedeGestionarMiembros = ViewBag.PuedeGestionarMiembros is bool pgm && pgm;
}
<div class="card ns-data-card mt-4">
    <div class="card-body">
        <h2 class="h6 mb-1"><span class="material-symbols-outlined align-middle" style="font-size:18px">supervisor_account</span> Miembros externos</h2>
        <p class="text-muted small mb-3">Usuarios de otra empresa (tu contador, un asesor) que acceden a esta con un rol acotado y su propio login. No consumen los usuarios de tu plan.</p>

        @if (puedeGestionarMiembros)
        {
            <form asp-action="AgregarMiembro" method="post" class="row g-2 align-items-end mb-3">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label small">Email o username del usuario</label>
                    <input name="EmailOUsername" class="form-control form-control-sm" required placeholder="contador@despacho.com" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Rol en esta empresa</label>
                    <select name="RolId" class="form-select form-select-sm" required>
                        @foreach (var r in rolesInvitar.Where(r => r.Activo))
                        {
                            <option value="@r.Id">@r.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Agregar miembro</button>
                </div>
            </form>
        }

        <div class="table-responsive">
            <table class="table table-sm table-hover m-0 align-middle">
                <thead><tr><th>Nombre</th><th>Usuario</th><th>Email</th><th>Rol</th>@if (puedeGestionarMiembros) { <th class="text-end"></th> }</tr></thead>
                <tbody>
                    @if (miembros.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted small text-center py-3">Sin miembros externos.</td></tr>
                    }
                    @foreach (var m in miembros)
                    {
                        <tr>
                            <td><strong>@m.NombreCompleto</strong></td>
                            <td class="ns-mono">@m.Username</td>
                            <td class="small">@m.Email</td>
                            <td><span class="ns-badge ns-badge--info">@m.RolNombre</span></td>
                            @if (puedeGestionarMiembros)
                            {
                                <td class="text-end">
                                    <form asp-action="QuitarMiembro" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Revocar el acceso de @m.NombreCompleto a esta empresa?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="usuarioId" value="@m.UsuarioId" />
                                        <button class="btn btn-sm btn-outline-danger">Revocar</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
