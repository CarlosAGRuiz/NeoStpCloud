@using NeoSTP.Application.Cobranza
@model CobroQrDto
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Pago";
    var token = ViewBag.Token as string;
}

<div class="card shadow-sm">
    <div class="card-body p-4 text-center">
        <h1 class="h5 mb-1">Pago</h1>
        <div class="text-muted small mb-3">@Model.CuentaNombre · Ref: <span class="mono">@Model.Referencia</span></div>
        <div class="h3 mono mb-3">$ @Model.Monto.ToString("N2")</div>
        @if (!string.IsNullOrEmpty(Model.QrPngBase64))
        {
            <img src="data:image/png;base64,@Model.QrPngBase64" alt="QR de pago" style="max-width:260px" class="border rounded p-2 bg-white" />
        }
        <div class="mt-3 text-muted small text-break">@Model.Payload</div>
        <div class="mt-3"><a href="/portal/@token" class="btn btn-outline-secondary btn-sm">Volver</a></div>
    </div>
</div>
