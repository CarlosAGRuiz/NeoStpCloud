<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · NeoSTP Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f4f6f9; font-family: 'Inter', system-ui, sans-serif; }
        .portal-shell { max-width: 760px; margin: 0 auto; padding: 24px 16px 48px; }
        .portal-brand { font-weight: 600; letter-spacing: .3px; color: #5b6573; font-size: .85rem; text-transform: uppercase; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .badge-estado { font-size: .72rem; letter-spacing: .4px; }
    </style>
</head>
<body>
    <div class="portal-shell">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="portal-brand">Portal del cliente</span>
            <span class="text-muted small">NeoSTP Cloud</span>
        </div>
        @if (TempData["PortalOk"] is string ok) { <div class="alert alert-success">@ok</div> }
        @if (TempData["PortalError"] is string err) { <div class="alert alert-danger">@err</div> }
        @RenderBody()
        <div class="text-center text-muted small mt-4">
            Documento tributario electrónico · El Salvador · Este enlace es personal: no lo compartas.
        </div>
    </div>
</body>
</html>
