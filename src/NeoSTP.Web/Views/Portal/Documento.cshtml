@using NeoSTP.Application.Portal
@model PortalDocumentoDto
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = Model.NumeroControl;
    var token = ViewBag.Token as string;
    var procesado = Model.EstadoCodigo == "PROCESADO";
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <div class="text-muted small">@Model.EmpresaNombre</div>
                <h1 class="h5 mb-1">Documento tributario electrónico</h1>
                <div class="mono small">@Model.NumeroControl</div>
            </div>
            <span class="badge badge-estado @(procesado ? "text-bg-success" : Model.EstadoCodigo == "RECHAZADO" ? "text-bg-danger" : "text-bg-secondary")">@Model.EstadoCodigo</span>
        </div>
        <hr />
        <div class="row g-3">
            <div class="col-6 col-md-4"><div class="text-muted small">Fecha de emisión</div><div>@Model.FechaEmision.ToString("dd/MM/yyyy")</div></div>
            <div class="col-6 col-md-4"><div class="text-muted small">Tipo</div><div>DTE-@Model.TipoDteCodigo</div></div>
            <div class="col-12 col-md-4"><div class="text-muted small">Total</div><div class="fw-bold">$ @Model.TotalPagar.ToString("N2")</div></div>
            <div class="col-12"><div class="text-muted small">Receptor</div><div>@(Model.ReceptorNombre ?? "Consumidor final")</div></div>
            <div class="col-12"><div class="text-muted small">Código de generación</div><div class="mono small">@Model.CodigoGeneracion</div></div>
            @if (!string.IsNullOrEmpty(Model.SelloRecibido))
            {
                <div class="col-12"><div class="text-muted small">Sello de recepción (Hacienda)</div><div class="mono small text-break">@Model.SelloRecibido</div></div>
            }
        </div>
        <hr />
        <div class="d-flex flex-wrap gap-2">
            <a href="/portal/@token/pdf" class="btn btn-primary btn-sm">Descargar PDF</a>
            <a href="/portal/@token/json" class="btn btn-outline-secondary btn-sm">Descargar JSON</a>
            @if (Model.PagoDisponible)
            {
                <a href="/portal/@token/qr" class="btn btn-outline-success btn-sm">Pagar / Ver QR</a>
            }
        </div>
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-body p-4">
        <h2 class="h6">Reenviar por correo</h2>
        <form method="post" action="/portal/@token/reenviar" class="d-flex gap-2 flex-wrap">
            @Html.AntiForgeryToken()
            <input type="email" name="destinatario" class="form-control form-control-sm" style="max-width:320px"
                   placeholder="@(Model.ReceptorCorreo ?? "correo@ejemplo.com")" />
            <button type="submit" class="btn btn-outline-primary btn-sm">Enviar</button>
        </form>
        <div class="form-text">Si lo dejas vacío se envía al correo registrado del receptor.</div>
    </div>
</div>
