@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Enlace no disponible";
    var mensaje = ViewBag.Mensaje as string ?? "Enlace inválido.";
}

<div class="card shadow-sm">
    <div class="card-body p-5 text-center">
        <div style="font-size:42px">🔒</div>
        <h1 class="h5 mt-2">Enlace no disponible</h1>
        <p class="text-muted mb-0">@mensaje</p>
    </div>
</div>
