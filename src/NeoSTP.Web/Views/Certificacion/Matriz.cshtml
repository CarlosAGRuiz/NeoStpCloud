@model IReadOnlyList<NeoSTP.Application.Dte.Certificacion.Dtos.CertificacionMatrizProgresoDto>
@{
    ViewData["Title"] = "Matriz de certificacion";
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><a asp-action="Index">Certificación</a><span class="material-symbols-outlined">chevron_right</span><span>Matriz</span></nav>
        <h1 class="ns-page-title">Matriz oficial Hacienda</h1>
        <p class="text-muted mb-0">Cantidad de escenarios requeridos por tipo DTE o evento para solicitar autorización.</p>
    </div>
    <a asp-action="Errores" class="btn btn-outline-danger btn-sm">
        <span class="material-symbols-outlined align-middle" style="font-size:18px">report</span> Ver errores
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover m-0 align-middle">
            <thead>
                <tr>
                    <th style="width:56px">#</th>
                    <th style="width:130px">Tipo</th>
                    <th>Nombre</th>
                    <th class="text-center">Req.</th>
                    <th class="text-center text-success">Ok</th>
                    <th class="text-center text-primary">Prog.</th>
                    <th class="text-center text-danger">Error</th>
                    <th class="text-center">Pend.</th>
                    <th style="width:260px">Progreso</th>
                    <th class="text-end">%</th>
                    <th style="width:120px"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in Model)
            {
                var pctOk = m.Requeridos == 0 ? 0 : m.Completados * 100 / m.Requeridos;
                var pctProg = m.Requeridos == 0 ? 0 : m.EnProgreso * 100 / m.Requeridos;
                var pctErr = m.Requeridos == 0 ? 0 : m.ConError * 100 / m.Requeridos;

                <tr class="@(m.Completo ? "table-success" : m.ConError > 0 ? "table-danger" : "")">
                    <td><small>@m.Orden</small></td>
                    <td><code>@m.TipoDteCodigo</code></td>
                    <td>
                        <div class="fw-semibold">@m.Nombre</div>
                        @if (!string.IsNullOrWhiteSpace(m.Descripcion))
                        {
                            <small class="text-muted">@m.Descripcion</small>
                        }
                    </td>
                    <td class="text-center ns-mono">@m.Requeridos</td>
                    <td class="text-center ns-mono text-success fw-semibold">@m.Completados</td>
                    <td class="text-center ns-mono text-primary">@m.EnProgreso</td>
                    <td class="text-center ns-mono text-danger">@m.ConError</td>
                    <td class="text-center ns-mono">@m.Pendientes</td>
                    <td>
                        <div class="progress" style="height:10px;">
                            <div class="progress-bar bg-success" style="width:@pctOk%"></div>
                            <div class="progress-bar bg-primary" style="width:@pctProg%"></div>
                            <div class="progress-bar bg-danger" style="width:@pctErr%"></div>
                        </div>
                    </td>
                    <td class="text-end"><strong class="ns-mono">@m.PorcentajeProgreso%</strong></td>
                    <td class="text-end">
                        <a asp-action="Tipo" asp-route-codigo="@m.TipoDteCodigo" class="btn btn-outline-primary btn-sm">Detalle</a>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3"><strong>Totales</strong></td>
                    <td class="text-center ns-mono"><strong>@Model.Sum(m => m.Requeridos)</strong></td>
                    <td class="text-center ns-mono text-success"><strong>@Model.Sum(m => m.Completados)</strong></td>
                    <td class="text-center ns-mono text-primary">@Model.Sum(m => m.EnProgreso)</td>
                    <td class="text-center ns-mono text-danger">@Model.Sum(m => m.ConError)</td>
                    <td class="text-center ns-mono">@Model.Sum(m => m.Pendientes)</td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
