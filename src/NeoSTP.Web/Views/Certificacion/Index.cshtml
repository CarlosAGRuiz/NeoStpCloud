@model IReadOnlyList<NeoSTP.Application.Dte.Certificacion.Dtos.CertificacionMatrizProgresoDto>
@{
    ViewData["Title"] = "Certificacion DTE";
    var resumen = ViewBag.Resumen as NeoSTP.Application.Dte.Certificacion.Dtos.CertificacionResumenDto;
    var puedeOperar = ViewBag.PuedeOperar is bool po && po;

    string EstadoCard(NeoSTP.Application.Dte.Certificacion.Dtos.CertificacionMatrizProgresoDto m)
        => m.Completo ? "Listo" : m.ConError > 0 ? "Revisar" : m.EnProgreso > 0 ? "En prueba" : "Pendiente";

    string EstadoBadge(NeoSTP.Application.Dte.Certificacion.Dtos.CertificacionMatrizProgresoDto m)
        => m.Completo ? "ns-badge ns-badge--processed" : m.ConError > 0 ? "ns-badge ns-badge--rejected" : "ns-badge ns-badge--draft";
}

<div class="ns-page-head">
    <div>
        <nav class="ns-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span class="material-symbols-outlined">chevron_right</span><span>Certificación</span></nav>
        <h1 class="ns-page-title">Certificación DTE</h1>
        <p class="text-muted mb-0">Controla la matriz exigida por Hacienda usando DTE y eventos reales emitidos en ambiente de pruebas.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Matriz" class="btn btn-outline-primary btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">view_list</span> Matriz completa
        </a>
        <a asp-action="Errores" class="btn btn-outline-danger btn-sm">
            <span class="material-symbols-outlined align-middle" style="font-size:18px">report</span> Errores
        </a>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">@ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">@err <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (resumen is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Requeridos</div>
                <div class="h2 m-0 ns-mono">@resumen.Requeridos</div>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Completados</div>
                <div class="h2 m-0 ns-mono text-success">@resumen.Completados</div>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">En progreso</div>
                <div class="h2 m-0 ns-mono text-primary">@resumen.EnProgreso</div>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Con error</div>
                <div class="h2 m-0 ns-mono text-danger">@resumen.ConError</div>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Pendientes</div>
                <div class="h2 m-0 ns-mono">@resumen.Pendientes</div>
            </div></div>
        </div>
        <div class="col-md-2">
            <div class="card h-100 @(resumen.ListaParaAutorizacion ? "border-success" : "")"><div class="card-body">
                <div class="text-muted small">Avance</div>
                <div class="h2 m-0 ns-mono">@resumen.PorcentajeProgreso%</div>
            </div></div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                <div>
                    <p class="ns-metric-label mb-1">Progreso global</p>
                    <div class="d-flex align-items-center gap-2">
                        <span class="ns-metric-value" style="color:var(--ns-secondary)">@resumen.PorcentajeProgreso%</span>
                        @if (resumen.ListaParaAutorizacion)
                        {
                            <span class="ns-badge ns-badge--processed">Listo para autorizacion</span>
                        }
                        else
                        {
                            <span class="ns-badge ns-badge--draft">En preparacion</span>
                        }
                    </div>
                </div>
                <div class="text-end small text-muted">
                    <div><span class="ns-mono fw-bold text-dark">@resumen.Completados / @resumen.Requeridos</span> escenarios completados</div>
                    <div>@resumen.TiposCompletados / @resumen.TotalTipos tipos al 100%</div>
                </div>
            </div>
            <div class="progress" style="height:14px; border-radius:9999px;">
                <div class="progress-bar" role="progressbar"
                     style="width:@(resumen.PorcentajeProgreso)%; background:var(--ns-secondary); border-radius:9999px;"></div>
            </div>
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="card h-100"><div class="card-body">
            <span class="material-symbols-outlined text-primary">assignment</span>
            <h2 class="h6 mt-2">1. Escenario</h2>
            <p class="text-muted small mb-0">Selecciona el tipo DTE o evento exigido por la matriz.</p>
        </div></div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card h-100"><div class="card-body">
            <span class="material-symbols-outlined text-primary">receipt_long</span>
            <h2 class="h6 mt-2">2. DTE o evento real</h2>
            <p class="text-muted small mb-0">Crea una prueba o asocia un documento ya enviado del mismo tipo.</p>
        </div></div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card h-100"><div class="card-body">
            <span class="material-symbols-outlined text-primary">cloud_upload</span>
            <h2 class="h6 mt-2">3. Hacienda</h2>
            <p class="text-muted small mb-0">El estado depende de la respuesta recibida: procesado, rechazado o error.</p>
        </div></div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card h-100"><div class="card-body">
            <span class="material-symbols-outlined text-primary">sync_alt</span>
            <h2 class="h6 mt-2">4. Matriz sincronizada</h2>
            <p class="text-muted small mb-0">Al asociar el DTE/evento, el escenario se actualiza segun su estado real.</p>
        </div></div>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h5 mb-0">Progreso por tipo</h2>
    @if (puedeOperar)
    {
        <span class="text-muted small">Permiso operativo activo</span>
    }
</div>

<div class="row g-3">
    @foreach (var m in Model)
    {
        var pctOk = m.Requeridos == 0 ? 0 : m.Completados * 100 / m.Requeridos;
        var pctProg = m.Requeridos == 0 ? 0 : m.EnProgreso * 100 / m.Requeridos;
        var pctErr = m.Requeridos == 0 ? 0 : m.ConError * 100 / m.Requeridos;

        <div class="col-md-6 col-xl-4">
            <article class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <div class="text-muted small ns-mono">@m.TipoDteCodigo</div>
                            <h3 class="h5 mb-1">@m.Nombre</h3>
                            @if (!string.IsNullOrWhiteSpace(m.Descripcion))
                            {
                                <p class="text-muted small mb-0">@m.Descripcion</p>
                            }
                        </div>
                        <span class="@EstadoBadge(m)">@EstadoCard(m)</span>
                    </div>
                    <div class="progress mb-2" style="height:10px;">
                        <div class="progress-bar bg-success" style="width:@pctOk%"></div>
                        <div class="progress-bar bg-primary" style="width:@pctProg%"></div>
                        <div class="progress-bar bg-danger" style="width:@pctErr%"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-3">
                        <span><strong class="text-success">@m.Completados</strong> ok</span>
                        <span><strong class="text-primary">@m.EnProgreso</strong> progreso</span>
                        <span><strong class="text-danger">@m.ConError</strong> error</span>
                        <span><strong>@m.Pendientes</strong> pend.</span>
                    </div>
                    <a asp-action="Tipo" asp-route-codigo="@m.TipoDteCodigo" class="btn btn-outline-primary btn-sm w-100">
                        Ver escenarios
                    </a>
                </div>
            </article>
        </div>
    }
</div>
