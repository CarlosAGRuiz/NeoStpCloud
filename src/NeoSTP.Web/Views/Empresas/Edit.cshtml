@model NeoSTP.Web.Models.EditEmpresaViewModel
@{
    ViewData["Title"] = $"Editar {Model.RazonSocial}";
    var estados = new[] { "ACTIVA", "INACTIVA", "SUSPENDIDA", "VENCIDA" };
}

<form asp-action="Edit" method="post" style="max-width: 880px;">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Nit" />
    <div class="ns-page-head">
        <div>
            <nav class="ns-breadcrumb"><a asp-action="Index">Empresas</a><span class="material-symbols-outlined">chevron_right</span><span>Editar</span></nav>
            <h1 class="ns-page-title">Editar empresa</h1>
        </div>
        <div class="ns-page-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="ns-formsection">
        <div class="ns-formsection-head"><span class="material-symbols-outlined">domain</span><h2>Datos de la empresa · <span class="text-muted ns-mono">@Model.Nit</span></h2></div>
        <div class="ns-formsection-body row g-3">
        <div class="col-md-4">
            <label class="form-label">NIT</label>
            <input value="@Model.Nit" class="form-control" disabled />
        </div>
        <div class="col-md-4">
            <label asp-for="Nrc" class="form-label"></label>
            <input asp-for="Nrc" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="EstadoCodigo" class="form-label"></label>
            <select asp-for="EstadoCodigo" class="form-select">
                @foreach (var s in estados) { <option value="@s" selected="@(s == Model.EstadoCodigo)">@s</option> }
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="RazonSocial" class="form-label"></label>
            <input asp-for="RazonSocial" class="form-control" />
            <span asp-validation-for="RazonSocial" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="NombreComercial" class="form-label"></label>
            <input asp-for="NombreComercial" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="CodigoActividad" class="form-label"></label>
            <input asp-for="CodigoActividad" class="form-control" />
        </div>
        <div class="col-md-8">
            <label asp-for="ActividadEconomica" class="form-label"></label>
            <input asp-for="ActividadEconomica" class="form-control" />
        </div>
        <partial name="_SelectorTerritorial" model="new NeoSTP.Web.Models.TerritorialSelectorViewModel
        {
            ValorDepartamento = Model.Departamento,
            ValorMunicipio = Model.Municipio,
            Departamentos = ViewBag.Departamentos as IReadOnlyList<NeoSTP.Application.Lookups.LookupItem> ?? [],
            Municipios = ViewBag.Municipios as IReadOnlyList<NeoSTP.Application.Lookups.LookupItem> ?? [],
        }" />
        <div class="col-md-4">
            <label asp-for="Telefono" class="form-label"></label>
            <input asp-for="Telefono" class="form-control" />
        </div>
        <div class="col-md-12">
            <label asp-for="Direccion" class="form-label"></label>
            <input asp-for="Direccion" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Correo" class="form-label"></label>
            <input asp-for="Correo" type="email" class="form-control" />
        </div>
        </div>
    </div>
</form>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
