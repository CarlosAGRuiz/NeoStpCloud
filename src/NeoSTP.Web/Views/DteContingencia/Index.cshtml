@using NeoSTP.Application.Dte.Contingencia.Dtos
@model IReadOnlyList<ContingenciaDocumentoDto>
@{
    ViewData["Title"] = "Cola de Contingencia";
    var resumen = ViewBag.Resumen as ContingenciaResumenDto;
}

<div class="ns-toolbar">
    <p class="text-muted small m-0">Documentos en contingencia y su reenvío por lotes (MOMENTO 3).</p>
    <a asp-action="Lotes" class="btn btn-outline-primary btn-sm">
        <span class="material-symbols-outlined align-middle" style="font-size:18px">inventory_2</span> Ver Lotes
    </a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">@ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">@err <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (resumen is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="card h-100"><div class="card-body ns-kpi">
                <div class="ns-kpi-top"><span class="ns-kpi-chip ns-kpi-chip--contingency"><span class="material-symbols-outlined">bolt</span></span></div>
                <p class="ns-kpi-label">DTE en contingencia</p>
                <h2 class="ns-kpi-value" style="color:var(--ns-contingency)">@resumen.DocumentosPendientes</h2>
            </div></div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card h-100"><div class="card-body ns-kpi">
                <div class="ns-kpi-top"><span class="ns-kpi-chip ns-kpi-chip--violet"><span class="material-symbols-outlined">inventory_2</span></span></div>
                <p class="ns-kpi-label">Lotes pendientes</p>
                <h2 class="ns-kpi-value" style="color:var(--ns-secondary)">@resumen.LotesPendientes</h2>
            </div></div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card h-100"><div class="card-body ns-kpi">
                <div class="ns-kpi-top"><span class="ns-kpi-chip ns-kpi-chip--processed"><span class="material-symbols-outlined">check_circle</span></span></div>
                <p class="ns-kpi-label">DTE procesados</p>
                <h2 class="ns-kpi-value" style="color:var(--ns-processed)">@resumen.DocumentosProcesados</h2>
            </div></div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card h-100"><div class="card-body ns-kpi">
                <div class="ns-kpi-top"><span class="ns-kpi-chip ns-kpi-chip--rejected"><span class="material-symbols-outlined">error</span></span></div>
                <p class="ns-kpi-label">DTE con error</p>
                <h2 class="ns-kpi-value" style="color:var(--ns-rejected)">@resumen.DocumentosConError</h2>
            </div></div>
        </div>
    </div>

    @if (resumen.VencimientoLoteMasAntiguo.HasValue)
    {
        var diff = resumen.VencimientoLoteMasAntiguo.Value - DateTime.UtcNow;
        var alertClass = diff.TotalHours < 12 ? "alert-danger" : diff.TotalHours < 24 ? "alert-warning" : "alert-info";
        <div class="alert @alertClass d-flex align-items-center gap-2">
            <span class="material-symbols-outlined" style="font-size:20px">schedule</span>
            <span>Vencimiento del lote más antiguo: <strong>@resumen.VencimientoLoteMasAntiguo.Value.ToString("dd/MM/yyyy HH:mm")</strong> (@((int)diff.TotalHours)h restantes)</span>
        </div>
    }

    @if (resumen.EventoSinLoteId.HasValue)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between gap-2">
            <span class="d-flex align-items-center gap-2"><span class="material-symbols-outlined" style="font-size:20px">warning</span> Hay un evento de contingencia PROCESADO sin lote creado (Evento #@resumen.EventoSinLoteId).</span>
            <form asp-action="CrearLote" method="post" class="ms-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventoContingenciaId" value="@resumen.EventoSinLoteId" />
                <button type="submit" class="btn btn-warning btn-sm d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:18px">outbox</span> Crear y enviar lote</button>
            </form>
        </div>
    }
}

@if (!Model.Any())
{
    <div class="card"><div class="ns-empty"><span class="material-symbols-outlined">check_circle</span><p>No hay documentos en contingencia.</p></div></div>
}
else
{
    <div class="card table-responsive">
        <table class="table table-sm table-hover align-middle m-0">
            <thead>
                <tr>
                    <th>Fecha emisión</th>
                    <th>Número control</th>
                    <th>Tipo</th>
                    <th>Receptor</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Intentos</th>
                    <th class="text-center">Horas</th>
                    <th>Último intento</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var d in Model)
            {
                var horasClass = d.HorasDesdeEmision > 48 ? "text-danger fw-bold" : d.HorasDesdeEmision > 24 ? "text-warning" : "";
                <tr>
                    <td>@d.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><code class="small ns-mono">@d.NumeroControl</code></td>
                    <td><span class="ns-badge ns-badge--draft">@d.TipoDteCodigo</span></td>
                    <td>@d.ReceptorNombre</td>
                    <td class="text-end ns-mono">$@d.TotalPagar.ToString("N2")</td>
                    <td class="text-center ns-mono">@d.IntentoRetransmision</td>
                    <td class="text-center @horasClass ns-mono">@d.HorasDesdeEmision h</td>
                    <td>@(d.UltimoIntentoAt.HasValue ? d.UltimoIntentoAt.Value.ToString("dd/MM HH:mm") : "—")</td>
                    <td>
                        <form asp-action="ReintentarDocumento" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="dteId" value="@d.Id" />
                            <button type="submit" class="ns-action-btn" title="Reintentar"><span class="material-symbols-outlined">replay</span></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
