@model IReadOnlyList<NeoSTP.Application.Licenciamiento.Dtos.PlanDto>
@{
    ViewData["Title"] = "Elegir Plan";
    var metodos = ViewBag.Metodos as IReadOnlyList<string> ?? new List<string>();
    var planes = Model ?? Array.Empty<NeoSTP.Application.Licenciamiento.Dtos.PlanDto>();

    string MetodoLabel(string m) => m switch
    {
        "Transferencia" => "Transferencia bancaria",
        "Wompi" => "Tarjeta (Wompi)",
        "PayPal" => "PayPal",
        "Stripe" => "Tarjeta (Stripe)",
        "MercadoPago" => "MercadoPago",
        _ => m,
    };

    string Limite(int? value) => value.HasValue ? value.Value.ToString("N0") : "Ilimitado";
    string Precio(NeoSTP.Application.Licenciamiento.Dtos.PlanDto p)
        => p.PrecioMensual > 0 ? $"{p.MonedaCodigo} {p.PrecioMensual:N2}" : "A convenir";
}

<section class="mb-4">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3">
        <div>
            <nav class="d-flex align-items-center gap-2 text-muted small mb-2">
                <span>Billing</span>
                <span class="material-symbols-outlined" style="font-size:16px">chevron_right</span>
                <span class="text-dark fw-semibold">Planes</span>
            </nav>
            <h1 class="mb-1">Elige tu plan</h1>
            <p class="text-muted mb-0">Comienza con 14 dias gratis. Los planes y limites se cargan desde el catalogo comercial activo.</p>
        </div>
        <span class="ns-chip">
            <span class="material-symbols-outlined" style="font-size:18px">verified_user</span>
            Billing SaaS
        </span>
    </div>
</section>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <span class="material-symbols-outlined align-middle me-1" style="font-size:18px">warning</span>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!planes.Any())
{
    <div class="card">
        <div class="ns-empty">
            <span class="material-symbols-outlined">workspace_premium</span>
            <p>No hay planes activos configurados.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in planes)
        {
            var destacado = p.Modulos.Any(m => string.Equals(m.Codigo, "NEOCONNECT", StringComparison.OrdinalIgnoreCase))
                || string.Equals(p.Codigo, "PRO", StringComparison.OrdinalIgnoreCase)
                || p.Nombre.Contains("pro", StringComparison.OrdinalIgnoreCase);

            <div class="col-lg-4 col-md-6">
                <article class="card h-100 @(destacado ? "border-primary border-2" : "")">
                    <div class="card-header @(destacado ? "bg-primary text-white" : "bg-white") py-4">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div>
                                @if (destacado)
                                {
                                    <span class="badge bg-warning text-dark mb-2">Mas popular</span>
                                }
                                <h2 class="h4 mb-1 @(destacado ? "text-white" : "")">@p.Nombre</h2>
                                <span class="small @(destacado ? "text-white-50" : "text-muted") ns-mono">@p.Codigo</span>
                            </div>
                            <span class="material-symbols-outlined @(destacado ? "text-white" : "text-primary")">workspace_premium</span>
                        </div>
                        <div class="mt-3">
                            <span class="display-6 fw-bold">@Precio(p)</span>
                            @if (p.PrecioMensual > 0)
                            {
                                <span class="@(destacado ? "text-white-50" : "text-muted")">/mes</span>
                            }
                        </div>
                    </div>
                    <div class="card-body d-flex flex-column">
                        @if (!string.IsNullOrWhiteSpace(p.Descripcion))
                        {
                            <p class="text-muted">@p.Descripcion</p>
                        }

                        <div class="row g-2 small mb-3">
                            <div class="col-6">
                                <div class="p-2 rounded border bg-light">
                                    <div class="text-muted">Usuarios</div>
                                    <strong>@Limite(p.LimiteUsuarios)</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded border bg-light">
                                    <div class="text-muted">Sucursales</div>
                                    <strong>@Limite(p.LimiteSucursales)</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded border bg-light">
                                    <div class="text-muted">Puntos venta</div>
                                    <strong>@Limite(p.LimitePuntosVenta)</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded border bg-light">
                                    <div class="text-muted">DTE/mes</div>
                                    <strong>@Limite(p.LimiteDteMensual)</strong>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="small text-muted fw-semibold mb-2">Modulos incluidos</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var m in p.Modulos.OrderBy(x => x.Orden))
                                {
                                    <span class="badge bg-light text-dark border">@m.Codigo</span>
                                }
                            </div>
                        </div>

                        <div class="mt-auto d-grid gap-2">
                            <form asp-action="StartTrial" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="planId" value="@p.Id" />
                                <button type="submit" class="btn btn-outline-primary w-100">
                                    <span class="material-symbols-outlined align-middle" style="font-size:18px">play_circle</span>
                                    Iniciar trial gratis
                                </button>
                            </form>

                            <form asp-action="CreateCheckout" method="post" class="d-grid gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="planId" value="@p.Id" />
                                <select name="metodo" class="form-select form-select-sm">
                                    @foreach (var m in metodos)
                                    {
                                        <option value="@m">@MetodoLabel(m)</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary w-100">
                                    <span class="material-symbols-outlined align-middle" style="font-size:18px">credit_card</span>
                                    Contratar ahora
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

<div class="text-center text-muted small mt-4">
    <span class="material-symbols-outlined align-middle" style="font-size:16px">shield</span>
    Pagos seguros por pasarela u offline. Al contratar aceptas nuestros
    <a asp-controller="Legal" asp-action="Index" asp-route-slug="terms">Terminos de Servicio</a>.
</div>
