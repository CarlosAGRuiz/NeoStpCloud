<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\NeoSTP.Application\NeoSTP.Application.csproj" />
    <ProjectReference Include="..\NeoSTP.Shared\NeoSTP.Shared.csproj" />
    <ProjectReference Include="..\NeoSTP.Infrastructure\NeoSTP.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <!-- E3: SSO OIDC (Entra/Google) — esquemas OpenID Connect adicionales al cookie. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- M6.1: secretos de desarrollo via `dotnet user-secrets` (fuera del repo). -->
    <UserSecretsId>neostp-web</UserSecretsId>
  </PropertyGroup>

</Project>
